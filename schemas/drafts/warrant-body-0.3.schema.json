{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/s0fractal/warrant/schemas/drafts/warrant-body-0.3.schema.json",
  "title": "Warrant body, body version 0.3 (DRAFT — NOT IN FORCE)",
  "description": "DRAFT. NOT IN FORCE, and not referenced by any verifier, tool or gate in this repository. Body version 0.3 does not exist yet: SPEC §13.2 reserves it and every conforming verifier MUST reject a body declaring it (SPEC §3.2's status block). This file is the shape the admission change will register, published early so an implementer can build against it — exactly as DERIVATIVE AND SECONDARY to SPEC.md as the in-force schema is, and with the same caveat: passing it is necessary and not sufficient. Validating a record against this file establishes nothing about that record's validity today.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "warrant",
    "decision",
    "subject",
    "under",
    "because",
    "evidence",
    "actor",
    "prior",
    "ts"
  ],
  "properties": {
    "warrant": {
      "enum": [
        "0.3"
      ]
    },
    "decision": {
      "enum": [
        "propose",
        "accept",
        "reject",
        "supersede"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hash"
      ],
      "properties": {
        "hash": {
          "$ref": "#/$defs/hex64"
        },
        "note": {
          "type": "string",
          "maxLength": 200,
          "description": "§2: length is measured in Unicode CODE POINTS, never bytes or UTF-16 units. JSON Schema maxLength is defined on code points, which is the intended reading here; a validator measuring UTF-16 units would be wrong for astral-plane notes."
        }
      }
    },
    "under": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/hex64"
      }
    },
    "because": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reason"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hex64"
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "prior": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hex64"
      }
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "allOf": [
    {
      "description": "§2: reject and supersede MUST carry >=1 reason. (accept SHOULD — a SHOULD is not expressible here and is deliberately not encoded.)",
      "if": {
        "properties": {
          "decision": {
            "enum": [
              "reject",
              "supersede"
            ]
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "because": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "hex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reason": {
      "type": "object",
      "oneOf": [
        {
          "$ref": "#/$defs/prose"
        },
        {
          "$ref": "#/$defs/check"
        }
      ]
    },
    "prose": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "text"
      ],
      "properties": {
        "kind": {
          "const": "prose"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "check",
        "runtime",
        "verdict"
      ],
      "properties": {
        "kind": {
          "const": "check"
        },
        "check": {
          "$ref": "#/$defs/hex64"
        },
        "runtime": {
          "enum": [
            "cmd@v1",
            "ski@v1",
            "ski@v2"
          ],
          "description": "DRAFT §13.1 registry as the admission change would leave it. ski@v2 is admitted in 0.3 only; it remains reserved-and-rejected in 0.1 and 0.2, which the in-force schema states by omitting it."
        },
        "verdict": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "transcript": {
          "$ref": "#/$defs/hex64"
        }
      }
    }
  }
}

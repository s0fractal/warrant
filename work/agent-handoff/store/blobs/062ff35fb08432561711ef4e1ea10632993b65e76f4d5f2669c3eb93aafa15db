"""Fresh adversarial probes against the installed exact bbcc57e package."""
import os
import sys
import json
import base64
from pathlib import Path
import warrant
os.environ['WARRANT_IMPL'] = str(Path(warrant.__file__).resolve().parent.parent)
sys.path.insert(0, '/private/tmp/warrant-g1-bbcc57e/tests')
from agent_world import world, reviewed_work, C, R, Trust, handoff, views
from agent_handoff_test import ok, inspect, pkg_and_digest

results = {}
def check(name, condition):
    results[name] = bool(condition)
    assert condition, name

def staged():
    s, r = world()
    ids = reviewed_work(s, challenge=False)
    p, h = pkg_and_digest(s, ids)
    r.expect('cut', h, source='src', exporter='producer')
    v = ok(inspect(r, p, ids, 'cut'))
    return s, r, ids, p, v

def promote(r, v):
    return r.call('handoff', dict(workspace='rcv', op='import', staged_id=v['data']['staged_id'], request_id='probe'))

# Removing a binding also blocks import; fresh=False does not bypass definition changes.
s, r, ids, p, v = staged()
u = r.doc['workspaces']['rcv']['uses']
r.doc['workspaces']['rcv']['uses'] = dict(u, **{'continue': dict(u['continue'], fresh=False)})
r.expect('cut', v['delivery']['manifest'], source='other', exporter='producer')
changed = ok(r.call('read', dict(workspace='rcv', kind='context', view_token=v['view_token'])))
check('changed_definition_fresh_false', changed['use']['state'] == 'HOLD' and promote(r,v)['error'] == 'IMPORT_BLOCKED')
del r.doc['workspaces']['rcv']['expectations']['cut']
r.reload()
check('removed_definition_import', promote(r,v)['error'] == 'IMPORT_BLOCKED')

# Rebind only the exporter (auditor), leaving every payload signer authenticated.
s, r, ids, p, v = staged()
(s.base/'auditor.key').write_text(s.keys['auditor'].seed_hex())
s.doc['workspaces']['src']['signer'] = dict(actor='auditor', key=str(s.base/'auditor.key'))
s.reload()
p, h = pkg_and_digest(s, ids, 'auditor-export')
r.expect('cut', h, source='src', exporter='auditor')
v = ok(inspect(r,p,ids,'cut'))
new = type(s.keys['auditor']).generate()
(r.base/'trust.json').write_bytes(C.canon(Trust.document([(a, new.public if a=='auditor' else k.public) for a,k in r.keys.items()])))
r.reload()
check('exporter_key_rebinding', promote(r,v)['error'] == 'IMPORT_BLOCKED')

# Staging changes after inspection: envelope, missing record/blob, extra record/blob.
for mutation in ('envelope','missing_record','missing_blob','extra_record','extra_blob'):
    s,r,ids,p,v = staged()
    d = r.ws.state/'staging'/v['data']['staged_id']
    if mutation == 'envelope':
        path = d/'records'/f"{ids['transition']}.json"
        env = C.loads(path.read_bytes())
        env['sig']['ed25519'] = '00'*64
        path.write_bytes(C.canon(env))
    elif mutation == 'missing_record':
        (d/'records'/f"{ids['transition']}.json").unlink()
    elif mutation == 'missing_blob':
        (d/'blobs'/ids['evidence']).unlink()
    elif mutation == 'extra_record':
        rec = R.record('transition','producer',190,R.transition('ATTESTED', established=['extra']))
        rid, raw = R.sign(rec,s.keys['producer'])
        (d/'records'/f'{rid}.json').write_bytes(raw)
    else:
        raw = b'extra'
        (d/'blobs'/C.digest(raw)).write_bytes(raw)
    check('staged_'+mutation, promote(r,v).get('error') == 'CONFLICT')

# A STARTED import is released only after ALL declared exact bytes land.
s,r,ids,p,v = staged()
handoff._FAULT_AFTER = 1
try:
    promote(r,v)
except RuntimeError:
    pass
finally:
    handoff._FAULT_AFTER = None
j = next((r.ws.state/'imports').glob('*.json'))
journal = views.read_json(j)
check('landed_partial', not views._landed(r.ws,journal))
for kind in ('records','blobs'):
    for it in p['payload'][kind]:
        name = it['id'] + ('.json' if kind=='records' else '')
        views._write(r.ws.store/kind/name,base64.b64decode(it['bytes_base64']))
check('landed_complete', views._landed(r.ws,journal))
path = r.ws.store/'blobs'/ids['evidence']
path.write_bytes(b'other')
check('landed_wrong_blob', not views._landed(r.ws,journal))
path.write_bytes(base64.b64decode(p['payload']['blobs'][0]['bytes_base64']))
path = r.ws.store/'records'/f"{ids['transition']}.json"
path.write_bytes(path.read_bytes()+b' ')
check('landed_wrong_envelope', not views._landed(r.ws,journal))

# Closed context request and full-string draft addresses, including trailing newline.
for address in ('a'*64+'\n','../'+'a'*61,'A'*64, 'a'*63, '/tmp/'+'a'*64):
    check('draft_address_'+repr(address), r.call('read',dict(workspace='rcv',kind='draft',target=address)).get('error')=='BAD_REQUEST')
check('context_expectation', r.call('context',dict(workspace='rcv',actor='receiver',targets=[],use='continue',expectation='cut')).get('error')=='BAD_REQUEST')
Path(__file__).with_name('probes.json').write_text(json.dumps(results,indent=2)+'\n')
print(json.dumps(results,indent=2))

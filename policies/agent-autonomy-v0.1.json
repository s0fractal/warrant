{
  "agent_autonomy_policy": "0.1",
  "status": "draft",
  "repository": "s0fractal/warrant",
  "base_branch": "master",
  "purpose": "Bound reversible agent work now; permit unattended merges only after a separately signed, hash-bound standing authorization exists.",
  "actions": {
    "branch_push": true,
    "draft_pull_request": true,
    "pull_request_update": true,
    "ready_for_review": true,
    "merge": false,
    "release": false,
    "governance_adoption": false,
    "branch_protection_admin": false,
    "history_rewrite": false
  },
  "bounds": {
    "max_commits": 8,
    "max_files_changed": 12,
    "max_lines_added": 800,
    "max_lines_removed": 400,
    "allow_deletions": false,
    "allow_binary": false,
    "allow_symlinks": false,
    "allow_submodules": false,
    "allow_merge_commits": false
  },
  "autonomous_path_prefixes": [
    "briefs/",
    "demos/",
    "docs/",
    "examples/",
    "prior-art/"
  ],
  "protected_paths": [
    ".github/",
    ".warrant/",
    ".warrants/",
    "AGENTS.md",
    "SECURITY.md",
    "SPEC.md",
    "pyproject.toml",
    "Cargo.lock",
    "Cargo.toml",
    "go.mod",
    "go.sum",
    "package-lock.json",
    "package.json",
    "policies/",
    "schemas/",
    "trust/",
    "tools/autonomy_gate.py",
    "tests/autonomy_gate.py",
    "impl/",
    "impl-go/",
    "impl-rs/",
    "integrations/",
    "proofs/",
    "conformance/",
    "conformance-skeletons/",
    "tests/",
    "tools/"
  ],
  "required_checks": [
    "test",
    "cross-repo"
  ],
  "checks_required_for": [
    "ready_for_review",
    "merge"
  ],
  "provenance": {
    "require_agent_trailer": true,
    "agent_markers": [
      "Co-Authored-By: Claude",
      "Co-Authored-By: Codex",
      "Co-Authored-By: GPT",
      "Co-Authored-By: Gemini",
      "Generated with",
      "Claude-Session:"
    ],
    "forbidden_authority_markers": [
      "Reviewed-by:",
      "Approved-by:",
      "Adopted-by:",
      "2-of-3 roster",
      "independent gate passed"
    ]
  },
  "authorization": {
    "required_for_all_actions": true,
    "format": "agent-autonomy-authorization@v0.1",
    "policy_sha256_required": true,
    "detached_signature_required": true,
    "authorization_path": "trust/agent-autonomy-authorization.json",
    "trusted_key_path": "trust/maintainer-autonomy-ed25519.pub"
  },
  "notes": {
    "bootstrap": "This policy is intentionally draft and merge=false. Merging its implementation does not activate standing authority.",
    "base_only": "A candidate is evaluated by the evaluator and policy from the pull request base SHA; candidate bytes are data and never execute.",
    "self_change": "Any change to the evaluator, policy, workflow, tests, trust roots, governance, protocol, release, dependency, proof, or conformance surface is outside autonomous merge authority.",
    "not_adoption": "Merge eligibility is not Warrant governance adoption, independent custody, scientific validity, or normative authority.",
    "silence": "Missing policy fields, checks, authorization, signature support, paths, or evidence deny or hold; absence is never success."
  }
}

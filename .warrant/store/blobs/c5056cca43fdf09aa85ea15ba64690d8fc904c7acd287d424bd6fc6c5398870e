{"commit":"24d5d32359f5b460fd27d50ac39dfb994df5eb48","duty":"1bd8f8fbed7046d2acb6fcdf87aeb279b5e4cb23f2a2afc97030a7f3c123db1d","head":"f5966eced0cfcba1bec2c76d4c91a88ba7cf913297e389dd5a693b1d6de53832","pr":209,"schema":"warrant-review/finding@1","severity":"P2","test":{"case":"F4","file":"graph_identity_review_test","patch":"diff --git a/tests/graph_identity_review_test.py b/tests/graph_identity_review_test.py\nnew file mode 100644\n--- /dev/null\n+++ b/tests/graph_identity_review_test.py\n@@ -0,0 +1,78 @@\n+\"\"\"Counterexamples to #209's root/lens identity, observed at 24d5d32359f5.\"\"\"\n+import json\n+import shutil\n+\n+from agent_world import C, Key, check, finish, views\n+from graph_test import goal_world, op, tool\n+from warrant.store import Trust\n+\n+\n+def default_actor_case(w):\n+    src = w[\"src\"]\n+    request = {\"op\": \"frontier\", \"view_token\": w[\"tok1\"]}\n+    first = op(src, request)[\"ok\"][\"data\"]\n+    explicit = op(src, dict(request, actor=\"producer\"))[\"ok\"][\"data\"]\n+    key = src.base / \"reviewer.key\"\n+    key.write_text(src.keys[\"reviewer\"].seed_hex())\n+    original = src.doc[\"workspaces\"][src.name][\"signer\"]\n+    try:\n+        src.doc[\"workspaces\"][src.name][\"signer\"] = {\"actor\": \"reviewer\", \"key\": str(key)}\n+        src.reload()\n+        second = op(src, request)[\"ok\"][\"data\"]\n+        explicit_again = op(src, dict(request, actor=\"producer\"))[\"ok\"][\"data\"]\n+    finally:\n+        src.doc[\"workspaces\"][src.name][\"signer\"] = original\n+        src.reload()\n+    check(\"C4\", first[\"summary\"][\"actor\"] == \"producer\" and second[\"summary\"][\"actor\"] == \"reviewer\"\n+          and first[\"items\"] != second[\"items\"] and explicit == explicit_again,\n+          \"control: only the default actor changed; an explicit actor stays stable\")\n+    check(\"F4\", (first[\"root\"], first[\"lens\"]) != (second[\"root\"], second[\"lens\"]),\n+          \"different default-actor frontiers must not share the same root and lens\",\n+          {\"same_root\": first[\"root\"] == second[\"root\"], \"same_lens\": first[\"lens\"] == second[\"lens\"]})\n+\n+\n+def base_trust_case(w):\n+    src = w[\"src\"]\n+    path = src.base / \"trust.json\"\n+    original = path.read_bytes()\n+    try:\n+        other = Key.generate()\n+        path.write_bytes(C.canon(Trust.document([(a, other.public if a == \"reviewer\" else k.public)\n+                                                for a, k in src.keys.items()])))\n+        base = views.capture(src.ws, as_of=w[\"rep1\"][\"view\"][\"as_of\"])[\"token\"]\n+    finally:\n+        path.write_bytes(original)\n+    request = {\"op\": \"delta\", \"view_token\": w[\"tok1\"], \"base_view_token\": w[\"tok1\"]}\n+    first = op(src, request)[\"ok\"][\"data\"]\n+    second = op(src, dict(request, base_view_token=base))[\"ok\"][\"data\"]\n+    check(\"C5\", first[\"items\"] == [] and second[\"items\"] != []\n+          and first[\"summary\"][\"from\"][\"assessment_id\"] != second[\"summary\"][\"from\"][\"assessment_id\"],\n+          \"control: identical snapshot/time, distinct base trust and assessed graph\")\n+    check(\"F5\", (first[\"root\"], first[\"lens\"]) != (second[\"root\"], second[\"lens\"]),\n+          \"different base-view assessments must not share the same delta identity\",\n+          {\"same_root\": first[\"root\"] == second[\"root\"], \"same_lens\": first[\"lens\"] == second[\"lens\"]})\n+\n+\n+def why_case():\n+    rc, out, err = tool(\"why\", \"warrant/engine.py:729\", \"--json\")\n+    doc = json.loads(out) if rc == 0 else {}\n+    check(\"C6\", rc == 0 and doc.get(\"file\") == \"warrant/engine.py\" and doc.get(\"statements\"),\n+          \"control: why returned its normal source-statement result\", (rc, err))\n+    check(\"F6\", bool(doc.get(\"root\")) and isinstance(doc.get(\"lens\"), str),\n+          \"why must carry root and lens like every query promised by duty 77bbcece786e\",\n+          sorted(doc))\n+\n+\n+def main():\n+    w = goal_world()\n+    try:\n+        default_actor_case(w)\n+        base_trust_case(w)\n+        why_case()\n+    finally:\n+        shutil.rmtree(w[\"src\"].base.parent, ignore_errors=True)\n+    return finish(\"GRAPH_IDENTITY_REVIEW\")\n+\n+\n+if __name__ == \"__main__\":\n+    raise SystemExit(main())\n"},"tree":"e29ac2e4e56bbce25fc7e43a94dc9e032913c2b2","what":"Default-actor frontier results collide: changing the configured signer from producer to reviewer on one frozen view changes actor and items but leaves root/lens identical. query hashes the literal request, omitting the resolved default actor. This lets a (root,lens) cache return another actor's work. Hash the effective actor; F4 fails while its explicit-actor control passes.","where":["warrant_agent/api.py:527-530"]}
s must not share root and lens\", {\"same_root\": first.get(\"root\") == second.get(\"root\"),\n+              \"same_lens\": first.get(\"lens\") == second.get(\"lens\")})\n+    finally:\n+        outside.unlink(missing_ok=True)\n+        shutil.rmtree(root, ignore_errors=True)\n+    return finish(\"GRAPH_SYMLINK_REVIEW\")\n+\n+\n+if __name__ == \"__main__\":\n+    raise SystemExit(main())\n"},"tree":"dde562d393ccbf5721e3a116ddb865ab0a460d55","what":"why follows a source symlink but tree_digest hashes only its link text. Changing an external referent from answer = 1 to answer = 2 changes the returned source with identical root and lens (F8). Bind every source byte read, or refuse symlinks, so cached why results cannot alias.","where":["tools/graph.py:135-139","tools/graph.py:455-457"]}
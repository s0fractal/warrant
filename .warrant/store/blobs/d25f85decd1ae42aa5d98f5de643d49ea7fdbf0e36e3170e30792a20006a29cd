{"commit":"872d780ce4fc636fa6bf7220437a0f8d66f502a2","duty":"1bd8f8fbed7046d2acb6fcdf87aeb279b5e4cb23f2a2afc97030a7f3c123db1d","head":"fbf368dacfcb956a57c91cfc9793cf5d9bbdd9cc17bd52b9034c78c058a55b19","pr":209,"schema":"warrant-review/finding@1","severity":"P2","test":{"case":"F7","file":"graph_cache_review_test","patch":"diff --git a/tests/graph_cache_review_test.py b/tests/graph_cache_review_test.py\nnew file mode 100644\n--- /dev/null\n+++ b/tests/graph_cache_review_test.py\n@@ -0,0 +1,39 @@\n+\"\"\"Counterexample to #209 head 6's commit-based impact provenance.\"\"\"\n+import json\n+import shutil\n+\n+from agent_world import check, finish\n+from graph_test import GT, fixture_repo, tool\n+\n+\n+def main():\n+    root, base, head, _ = fixture_repo()\n+    try:\n+        rc, out, err = tool(\"impact\", f\"{base}..{head}\", \"--json\", root=root)\n+        first = json.loads(out) if rc == 0 else {}\n+        check(\"C7\", rc == 0 and any(\"M05\" in s[\"mutants\"] for s in first.get(\"statements\", []))\n+              and first.get(\"claims\"), \"control: the committed M05 statement has backed claims\", (rc, err))\n+        cache = GT.head_tree(root, head)\n+        engine = cache / \"warrant\" / \"engine.py\"\n+        original = engine.read_text()\n+        old = 'b[\"item\"] == index and sorted(b[\"evidence\"]) == want:'\n+        assert original.count(old) == 1\n+        engine.write_text(original.replace(old, 'b[\"item\"] == index and sorted(list(b[\"evidence\"])) == want:'))\n+        rc2, out2, err2 = tool(\"impact\", f\"{base}..{head}\", \"--json\", root=root)\n+        second = json.loads(out2) if rc2 == 0 else {}\n+        same = (first.get(\"root\"), first.get(\"lens\")) == (second.get(\"root\"), second.get(\"lens\"))\n+        detail = {\"same_identity\": same, \"before_claims\": [c[\"name\"] for c in first.get(\"claims\", [])],\n+                  \"after_claims\": [c[\"name\"] for c in second.get(\"claims\", [])], \"rc\": rc2, \"stderr\": err2}\n+        shutil.rmtree(cache)\n+        rc3, out3, err3 = tool(\"impact\", f\"{base}..{head}\", \"--json\", root=root)\n+        check(\"C8\", rc3 == 0 and json.loads(out3) == first,\n+              \"control: rebuilding the ignored cache restores the original answer\", (rc3, err3))\n+        check(\"F7\", (rc2 != 0 and \"REFUSED\" in err2) or (rc2 == 0 and first.get(\"statements\") == second.get(\"statements\")),\n+              \"impact must read the named commit's statements or refuse a modified cache\", detail)\n+    finally:\n+        shutil.rmtree(root, ignore_errors=True)\n+    return finish(\"GRAPH_CACHE_REVIEW\")\n+\n+\n+if __name__ == \"__main__\":\n+    raise SystemExit(main())\n"},"tree":"dde562d393ccbf5721e3a116ddb865ab0a460d55","what":"impact trusts build/graph/trees/<tree> whenever .complete exists. Editing only cached warrant/engine.py drops SPEC-3.3-4 from a fixed commit range while root and lens stay identical; clearing the cache restores it (F7). Read or verify the named Git tree instead of treating a mutable ignored directory as that commit.","where":["tools/graph.py:209-217"]}
{"commit":"3789dbb93489315e3846c8d9e8a0878fc8c62f9c","duty":"f9c14b2b0298f150549aa20c45425996474a911d018b19e802e281f1c15fd315","head":"94d78fa29e6878f3a923b7a40f48a49c35a7e9befe7475758f2a57b93c0e3a26","pr":197,"schema":"warrant-review/finding@1","severity":"P2","test":{"case":"C197A","file":"merge_ambiguity_membership_test","patch":"diff --git a/tests/merge_ambiguity_membership_test.py b/tests/merge_ambiguity_membership_test.py\nnew file mode 100644\n--- /dev/null\n+++ b/tests/merge_ambiguity_membership_test.py\n@@ -0,0 +1,57 @@\n+\"\"\"An ambiguous merge is chosen from its candidates, not any merge carrying the head.\n+\n+Observed at #197 head 3, 3789dbb: after two #1 merge subjects made discovery\n+ambiguous, an explicit observation of a third, differently named merge was\n+accepted as REVIEWED; check --base was clean and the next head was admitted.\n+\"\"\"\n+from review_world import FIXED, Fixture, RV, branch, merge\n+from world import check, finish\n+\n+\n+def main():\n+    f = Fixture()\n+    try:\n+        branch(f, \"pr1\")\n+        head = f.commit(\"change 1\", {\"calc.py\": FIXED})\n+        f.ok(\"open\", \"--pr\", \"1\", \"--title\", \"One\")\n+        f.ok(\"head\", \"--pr\", \"1\", \"--commit\", head)\n+        f.save()\n+        f.ok(\"accept\", \"--pr\", \"1\", \"--commit\", head, actor=\"codex\")\n+        tip = f.save()\n+        f.git(\"checkout\", \"-q\", \"-b\", \"copy\", \"master\")\n+        f.git(\"merge\", \"-q\", \"--no-ff\", \"-m\", \"Merge pull request #1 from fixture/copy\", tip)\n+        copy = f.git(\"rev-parse\", \"HEAD\")\n+        actual = merge(f, tip, \"Merge pull request #1 from fixture/pr1\")\n+        f.git(\"merge\", \"-q\", \"--no-ff\", \"-m\", \"Merge branch 'copy'\", copy)\n+        wrong = f.git(\"rev-parse\", \"HEAD\")\n+        automatic = f.code(\"merged\", \"--due\")\n+        before = f.save()\n+        model = f.model()\n+        review = model.reviews[1]\n+        # Positive controls: either named candidate remains a valid explicit choice.\n+        candidates = [RV.merge_report(f.dir, f.rv().repo.trust(), model.cfg, review, c)[\"merge\"]\n+                      for c in (copy, actual)]\n+        rejected = f.code(\"merged\", \"--pr\", \"1\", \"--merge\", wrong)\n+        f.ok(\"project\")\n+        problems = f.problems(before)\n+        model = f.model()\n+        recorded = [(rep[\"merge\"], RV.merge_state(rep)) for _, _, rep in model.reviews[1].merges]\n+        next_head = None\n+        if recorded:\n+            branch(f, \"pr2\")\n+            head2 = f.commit(\"next head\", {\"next.txt\": \"next\\n\"})\n+            f.ok(\"open\", \"--pr\", \"2\", \"--title\", \"Two\")\n+            next_head = f.run(\"head\", \"--pr\", \"2\", \"--commit\", head2)[0]\n+        check(\"C197A\", automatic == (\"REVIEW_MERGE_AMBIGUOUS\", True)\n+              and candidates == [copy, actual]\n+              and rejected == (\"REVIEW_MERGE_NOT_THE_PR\", True) and recorded == [],\n+              \"an explicit choice after ambiguity must be one of the merges that name the PR\",\n+              {\"automatic\": automatic, \"explicit_wrong\": rejected, \"recorded\": recorded,\n+               \"check_base\": problems, \"next_head_rc\": next_head})\n+    finally:\n+        f.close()\n+    return finish(\"MERGE_AMBIGUITY_MEMBERSHIP_TEST\")\n+\n+\n+if __name__ == \"__main__\":\n+    raise SystemExit(main())\n"},"tree":"fe0dc7ac700ffefb99a53c4913ef7b410a610091","what":"After ambiguous merge discovery, an explicit merge outside the candidate set is accepted as REVIEWED; check --base accepts it and the next head skips the actual PR merges. Restrict the explicit fallback to the discovered candidates.","where":["tools/claimslib/reviews.py:821"]}
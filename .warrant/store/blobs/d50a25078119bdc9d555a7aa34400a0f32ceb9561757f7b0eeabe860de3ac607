{"commit":"228ed326c0f8befbc8529114e27f627d992f9c66","duty":"431ae379e6ae9e4858e8ac82648d3597cb60c75d15a65101d9ef260e9788e718","head":"9d63a3888d0322b1c1cc4eb3478bdee8ba81d946a46f04115a993a33b4174e47","pr":193,"schema":"warrant-review/finding@1","severity":"P2","test":{"case":"R1","file":"pilot_review_store_test","patch":"diff --git a/tests/pilot_review_store_test.py b/tests/pilot_review_store_test.py\nnew file mode 100644\n--- /dev/null\n+++ b/tests/pilot_review_store_test.py\n@@ -0,0 +1,130 @@\n+\"\"\"Countervectors for PR #193's local-store confinement and admission bounds.\"\"\"\n+import multiprocessing\n+import os\n+import tempfile\n+from pathlib import Path\n+from unittest.mock import patch\n+\n+from world import check, finish\n+from warrant import jcs as C\n+from warrant import pilot as P\n+\n+\n+def fifo_worker(root, layout, name, conn):\n+    real_open = os.open\n+\n+    def announce(path, *args, **kwargs):\n+        if Path(path).name in (name, name[2:]):\n+            conn.send((\"opening\", None))\n+        return real_open(path, *args, **kwargs)\n+\n+    with patch.object(P.os, \"open\", side_effect=announce):\n+        result = P.Receiver([P.LAYOUTS[layout](root)]).resolve(\"sigma-state:\" + name)\n+    conn.send((\"result\", result))\n+    conn.close()\n+\n+\n+def fifo_case():\n+    outcomes = []\n+    ctx = multiprocessing.get_context(\"fork\")\n+    for layout in (\"blobs\", \"fanout\"):\n+        with tempfile.TemporaryDirectory(prefix=\"pilot-fifo-\") as tmp:\n+            root = Path(tmp)\n+            name = \"a\" * 64\n+            target = root / name if layout == \"blobs\" else root / name[:2] / name[2:]\n+            target.parent.mkdir(parents=True, exist_ok=True)\n+            os.mkfifo(target)\n+            parent, child = ctx.Pipe(duplex=False)\n+            proc = ctx.Process(target=fifo_worker, args=(root, layout, name, child))\n+            proc.start()\n+            child.close()\n+            try:\n+                if not parent.poll(15) or parent.recv()[0] != \"opening\":\n+                    raise RuntimeError(\"worker did not reach the object open\")\n+                if parent.poll(1):\n+                    label, result = parent.recv()\n+                    outcomes.append(label == \"result\" and result.get(\"code\") == \"MISSING\"\n+                                    and result.get(\"result\") == \"INCONCLUSIVE\" and \"objects\" not in result)\n+                else:\n+                    outcomes.append(False)\n+            finally:\n+                if proc.is_alive():\n+                    proc.terminate()\n+                proc.join(5)\n+                parent.close()\n+    check(\"R1\", outcomes == [True, True],\n+          \"a FIFO with no writer is a missing non-regular object, without blocking\", outcomes)\n+\n+\n+def symlink_swap_case():\n+    with tempfile.TemporaryDirectory(prefix=\"pilot-swap-\") as tmp:\n+        root = Path(tmp)\n+        store, outside = root / \"store\", root / \"outside\"\n+        store.mkdir()\n+        outside.mkdir()\n+        data = b\"SGS1bytes present only outside the configured store\"\n+        name = C.digest(data)\n+        (outside / name[2:]).write_bytes(data)\n+        fan = store / name[:2]\n+        fan.mkdir()\n+        moved = store / \"original-directory\"\n+        real_open = os.open\n+        swapped = []\n+\n+        def swap(path, *args, **kwargs):\n+            # Schedule a real directory replacement at the next open in the store.\n+            # Only the interleaving is controlled; the open and filesystem are real.\n+            if not swapped:\n+                fan.rename(moved)\n+                fan.symlink_to(outside, target_is_directory=True)\n+                swapped.append(True)\n+            return real_open(path, *args, **kwargs)\n+\n+        calls = []\n+        def verify(res):\n+            calls.append(res)\n+            return res\n+        with patch.object(P.os, \"open\", side_effect=swap):\n+            result = P.Receiver([P.FanoutDir(store)]).check(\"sigma-state:\" + name, verify)\n+        check(\"R2\", bool(swapped) and result.get(\"code\") == \"MISSING\"\n+              and \"objects\" not in result and not calls,\n+              \"a fanout directory swapped for a symlink never exposes outside bytes to the verifier\",\n+              {\"result\": result.get(\"result\"), \"code\": result.get(\"code\"), \"verifier_calls\": len(calls)})\n+\n+\n+def growth_case():\n+    with tempfile.TemporaryDirectory(prefix=\"pilot-growth-\") as tmp:\n+        root = Path(tmp)\n+        before, after = b\"SGS1\", b\"SGS1x\"\n+        name = C.digest(after)\n+        target = root / name\n+        target.write_bytes(before)\n+        real_fstat = os.fstat\n+        grown = []\n+\n+        def grow(fd):\n+            info = real_fstat(fd)\n+            if not grown:\n+                with target.open(\"ab\") as stream:\n+                    stream.write(b\"x\")\n+                grown.append(True)\n+            return info\n+\n+        calls = []\n+        def verify(res):\n+            calls.append(res)\n+            return res\n+        with patch.object(P.os, \"fstat\", side_effect=grow):\n+            result = P.Receiver([P.BlobDir(root)], limits={\"pilot_bytes\": 4}).check(\"sigma-state:\" + name, verify)\n+        check(\"R3\", bool(grown) and result.get(\"result\") == \"INCONCLUSIVE\" and result.get(\"code\") == \"LIMIT\"\n+              and result.get(\"limit\") == \"pilot_bytes\" and \"objects\" not in result and not calls,\n+              \"a file grown after fstat cannot return five admitted bytes under a four-byte limit\",\n+              {\"result\": result.get(\"result\"), \"code\": result.get(\"code\"), \"verifier_calls\": len(calls),\n+               \"returned_bytes\": sum(map(len, result.get(\"objects\", {}).values()))})\n+\n+\n+if __name__ == \"__main__\":\n+    fifo_case()\n+    symlink_swap_case()\n+    growth_case()\n+    raise SystemExit(finish(\"PILOT-REVIEW-STORE\"))\n"},"tree":"cb156532114e6947c287f884d7eeaa32b0a7a64e","what":"A FIFO under an object name blocks os.open before fstat; reject non-regular files without waiting for a writer (PC-07).","where":["warrant/pilot.py:188"]}
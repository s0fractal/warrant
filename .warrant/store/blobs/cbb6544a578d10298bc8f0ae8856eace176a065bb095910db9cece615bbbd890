{"commit":"9e58df1fc2760ce04272808a4b2d8495efe9c499","duty":"8057c2a37f1cb29f08fded8f8684bebf4ac62c3c8791597a704653259e5281a5","head":"7a2f5af4c5af30f00300f3f8ebbd574a1868e7193b176a11197cf0c890741709","pr":204,"schema":"warrant-review/finding@1","severity":"P2","test":{"case":"SKIP1","file":"replay_retry_skip_test","patch":"diff --git a/tests/replay_retry_skip_test.py b/tests/replay_retry_skip_test.py\nnew file mode 100644\n--- /dev/null\n+++ b/tests/replay_retry_skip_test.py\n@@ -0,0 +1,38 @@\n+\"\"\"Skipping a different checker does not discharge an earlier failed replay.\"\"\"\n+import json\n+from review_replay_test import WAKER, at_commit, due, flaky, git, pr_world, tip\n+from world import check, finish\n+\n+\n+def main():\n+    f = pr_world()\n+    try:\n+        flaky(f, 1)\n+        f.w.due = lambda base: {\"due\": [due(f, tip(f))], \"not_due\": []}\n+        WAKER.tick(f.w, False)  # One transient checker failure.\n+        f.ok(\"accept\", \"--pr\", \"1\", \"--commit\", f.h2, actor=\"codex\")\n+        f.save()\n+        changed = f.commit(\"checker bytes awaiting adoption\", {\n+            WAKER.CHECKER_FILE: \"# checker bytes different from the base\\n\"})\n+        git(\"-C\", str(f.dir), \"push\", \"-q\", str(f.origin), f\"{changed}:refs/heads/pr1\")\n+        git(\"-C\", str(f.w.mirror), \"fetch\", \"-q\", str(f.origin), \"+refs/heads/pr1:refs/heads/pr1\")\n+        f.w.due = lambda base: {\"due\": [], \"not_due\": [dict(\n+            due(f, tip(f)), head_repo=WAKER.REPO,\n+            not_due=[[\"TIP_CHANGED_AFTER_ACCEPTANCE\", \"checker changed\"]])]}\n+        f.now[0] += WAKER.BACKOFF + 1\n+        lines = WAKER.tick(f.w, False)\n+        memo = f.w.home / \"replays\" / f\"{f.w.key(due(f, f.head))}.json\"\n+        earlier = json.loads(memo.read_text())\n+        observed = at_commit(f, tip(f)).findings[f.cid].observed\n+        check(\"SKIP1\", len(f.runs) == 1 and not observed\n+              and f.w.pending(1) and not earlier.get(\"covered_by\"),\n+              \"a checker skipped for unadopted bytes leaves the failed replay pending and uncovered\",\n+              {\"pending\": f.w.pending(1), \"checker_runs\": len(f.runs),\n+               \"covered_by\": earlier.get(\"covered_by\"), \"observed\": sorted(observed), \"tick\": lines})\n+    finally:\n+        f.close()\n+    return finish(\"REPLAY_RETRY_SKIP_TEST\")\n+\n+\n+if __name__ == \"__main__\":\n+    raise SystemExit(main())\n"},"tree":"d1e6a3c207b354adb1f9df3cef5ce89e25f6e323","what":"A retry at a head that changes review_replay.py is skipped, but replay() still sets ok=True and cover() clears the earlier failed memo. pending() becomes false despite zero observations, so a PR no longer due loses its retry. A skipped run must not count as a completed replay or cover earlier failures.","where":["integrations/codex-plugin/waker/waker.py:317","integrations/codex-plugin/waker/waker.py:327-328","integrations/codex-plugin/waker/waker.py:381-382"]}
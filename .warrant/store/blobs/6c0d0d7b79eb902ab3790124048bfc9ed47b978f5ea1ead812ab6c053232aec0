{"commit":"41a10739b0fe75b8618aa60344023547e35fd8c7","duty":"20fa1f8ba139365cfcce657493e69b2070ec04e97fc59b60740c7e95fd27e84e","head":"246adae2a062f7530dcf5b153e8a638cac72012b49a6a136e91c1f2f9021d008","pr":194,"schema":"warrant-review/finding@1","severity":"P2","test":{"case":"A194R2","file":"review194_items_test","patch":"diff --git a/tests/review194_items_test.py b/tests/review194_items_test.py\nnew file mode 100644\n--- /dev/null\n+++ b/tests/review194_items_test.py\n@@ -0,0 +1,45 @@\n+#!/usr/bin/env python3\n+\"\"\"PR 194: two closure items in one transition require two independent wakes.\"\"\"\n+from review_replay_test import C, R, WAKER, obligation, pr_world, roadmap_base\n+from world import check, finish\n+\n+\n+def main():\n+    f = pr_world()\n+    try:\n+        goal = f.put(\"claude\", \"transition\", R.transition(\"ATTESTED\", [], opened=[\n+            {\"text\": \"The ledger exists.\", \"scope\": \"roadmap:G1\"}]))\n+        a = obligation(f, goal, \"Obligation A.\")\n+        b = obligation(f, goal, \"Obligation B.\")\n+        doc = {\"evidence\": \"one transition, two obligation items\"}\n+        h = C.digest(C.canon(doc))\n+        transition = f.put(\"claude\", \"transition\", R.transition(\"ATTESTED\", [h], closes=[\n+            R.item(a, \"discharge\", [h]), R.item(b, \"discharge\", [h])],\n+            established=[\"both obligations complete\"]), [doc])\n+        code = roadmap_base(f)\n+        f.w.tree = lambda base: code\n+        f.w.due = lambda base: {\"due\": [], \"not_due\": []}\n+        f.w.fetch = lambda: f.start\n+        initially = f.w.acceptances(f.start)[\"due\"]\n+        first = WAKER.tick(f.w, False)\n+        calls_after_first = len(f.codex.calls)\n+        # The first wake's verdict reaches master before the next tick. Only its\n+        # named item is accepted, exactly as the acceptance prompt instructs.\n+        first_item = initially[0][\"item\"]\n+        f.put(\"codex\", \"accept\", R.accept(transition, first_item, [h]))\n+        remaining = f.w.acceptances(f.start)[\"due\"]\n+        second = WAKER.tick(f.w, False)\n+        check(\"A194R2\", len(initially) == 2 and calls_after_first == 1\n+              and len(remaining) == 1 and remaining[0][\"item\"] != first_item\n+              and len(f.codex.calls) == 2,\n+              \"accepting one item must leave the other item independently wakeable next run\",\n+              {\"items\": [c[\"item\"] for c in initially],\n+               \"remaining\": [c[\"item\"] for c in remaining],\n+               \"wakes\": len(f.codex.calls), \"first\": first, \"second\": second})\n+    finally:\n+        f.close()\n+    return finish(\"PR194_ITEMS\")\n+\n+\n+if __name__ == \"__main__\":\n+    raise SystemExit(main())\n"},"tree":"7d56c0da52e8fa00fec348d20402357c48bdfa4f","what":"Key acceptance wakes by transition and item: a transition may close two roadmap duties; after its first item is accepted the other is still PENDING, but their shared accepts/<T>.json memo says done, so the second item is never woken. The prompt asks for only one item.","where":["integrations/codex-plugin/waker/waker.py:442-444"]}
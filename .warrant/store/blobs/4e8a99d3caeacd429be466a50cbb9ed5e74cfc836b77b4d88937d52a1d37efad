e used.\"\"\"\nimport json\nimport os\nfrom pathlib import Path\nimport sys\n\nrepo = Path(sys.argv[1]).resolve()\nsys.path.insert(0, str(repo / \"tests\"))\nfrom review_gate_test import C, EL, MERGE, R, Fixture, at, codes, world\n\nresults = []\n\n\ndef record(name, assessment, required, extra):\n    actual = assessment.codes()\n    results.append({\"case\": name, \"expected_codes\": required, \"actual_codes\": actual,\n                    \"eligible\": assessment.eligible, \"tail_paths\": [p for p, _ in extra],\n                    \"matches_obligation\": actual == required})\n\n\nf = Fixture()\ntry:\n    (f.dir / \".warrant\" / \"merge.json\").write_text(json.dumps(MERGE) + \"\\n\")\n    goal = f.put(\"claude\", \"transition\", R.transition(\"ATTESTED\", [], opened=[\n        {\"text\": \"The graph supplies an auditable merge tail.\", \"scope\": \"roadmap:G1\"}]))\n    duty = f.put(\"claude\", \"duty\", R.duty(\"claude\", \"Only added records and blobs follow review.\",\n        [\"s0fractal\"], {\"attest\": {}}, accept_by=[\"codex\"], answers=goal + \":0\"))\n    ev = {\"schema\": \"warrant-roadmap/evidence@1\", \"duty\": duty, \"refs\": [\"s0fractal/warrant#1\"]}\n    evidence = C.digest(C.canon(ev))\n    transition = f.put(\"claude\", \"transition\", R.transition(\"ATTESTED\", [evidence],\n        closes=[R.item(duty, \"discharge\", [evidence])], established=[\"done\"]), [ev])\n    f.base_commit = f.save()\n    f.put(\"codex\", \"accept\", R.accept(transition, 0, [evidence]))\n    tip = f.save()\n    facts = {\"branch\": \"codex/verdicts/\" + transition[:12] + \"-0\", \"head_repo\": \"s0fractal/warrant\"}\n    a, _ = codes(f, tip, **facts)\n    assert a.eligible and not a.due and a.codes() == []\n    record(\"verdict_only_control\", a, [], EL.tail(f.dir, f.base_commit, tip))\n    for i, path in enumerate([\"REVIEWS.md\", \"ROADMAP.md\", \"SPEC-CLAIMS.md\", \"WITNESSES.md\",\n                             \"build/views/REVIEWS.md\", \"build/views/ROADMAP.md\",\n                             \"build/views/SPEC-CLAIMS.md\", \"build/views/WITNESSES.md\"]):\n        at(f, tip, \"view-\" + str(i))\n        target = f.dir / path\n        target.parent.mkdir(parents=True, exist_ok=True)\n        target.write_text(f.view())\n        f.git(\"add\", \"-f\", \"--\", path)\n        head = f.commit(\"a committed generated view beside a valid verdict\")\n        a, _ = codes(f, head, **facts)\n        extra = EL.tail(f.dir, f.base_commit, head)\n        assert [p for p, _ in extra] == [path] and not a.eligible\n        record(\"verdict_only:\" + path, a, [\"TAIL_CHANGES\"], extra)\nfinally:\n    f.close()\n\nf = world()\ntry:\n    f.ok(\"accept\", \"--pr\", \"1\", \"--commit\", f.x, actor=\"codex\")\n    f.tip = f.save()\n    a, _ = codes(f, f.tip)\n    assert a.eligible and a.codes() == []\n    record(\"reviewed_control\", a, [], EL.tail(f.dir, f.x, f.tip))\n    for i, path in enumerate([\"REVIEWS.md\", \"build/views/REVIEWS.md\", \"a\\tview\\n.md\"]):\n        at(f, f.tip, \"reviewed-view-\" + str(i))\n        target = f.dir / path\n        target.parent.mkdir(parents=True, exist_ok=True)\n        target.write_text(f.view())\n        f.git(\"add\", \"-f\", \"--\", path)\n        head = f.commit(\"a generated view after the accepted head\")\n        a, _ = codes(f, head)\n        extra = EL.tail(f.dir, f.x, head)\n        assert a.codes() == [\"TAIL_CHANGES\"]\n        record(\"reviewed:\" + path, a, [\"TAIL_CHANGES\"], extra)\n\n    # Direct tail boundary probes: new regular store entries are admitted;\n    # executable files, symlinks, renames and changes to existing entries are refused.\n    blob = \".warrant/store/blobs/\" + C.digest(b\"probe\")\n    at(f, f.tip, \"new-blob\")\n    (f.dir / blob).write_bytes(b\"probe\")\n    new = f.commit(\"new regular blob\")\n    assert EL.tail(f.dir, f.tip, new) == []\n    for mode in (0o755,):\n        at(f, f.tip, \"executable\")\n        (f.dir / blob).write_bytes(b\"probe\")\n        os.chmod(f.dir / blob, mode)\n        head = f.commit(\"executable blob\")\n        assert [p for p, _ in EL.tail(f.dir, f.tip, head)] == [blob]\n    at(f, new, \"rewrite\")\n    (f.dir / blob).write_bytes(b\"changed\")\n    assert EL.tail(f.dir, new, f.commit(\"rewrite blob\"))\n    at(f, new, \"remove\")\n    (f.dir / blob).unlink()\n    assert EL.tail(f.dir, new, f.commit(\"delete blob\"))\n    at(f, new, \"rename\")\n    (f.dir / blob).rename(f.dir / (\".warrant/store/blobs/\" + \"a\" * 64))\n    assert any(p == blob for p, _ in EL.tail(f.dir, new, f.commit(\"rename blob\")))\n    at(f, f.tip, \"symlink\")\n    os.symlink(\"../../../calc.py\", f.dir / blob)\n    assert EL.tail(f.dir, f.tip, f.commit(\"symlink blob\"))\nfinally:\n    f.close()\n\nprint(json.dumps({\"implementation\": str(repo), \"results\": results,\n                  \"additional_tail_boundary_probes\": \"PASS\",\n                  \"obligation_mismatches\": sum(not r[\"matches_obligation\"] for r in results)}, indent=1))\n"},"required_followup":"Preserve TAIL_CHANGES when a candidate verdicts-only tail contains a committed generated view, and cover that assessment path with a regression and a mutation witness.","reviewer":"codex","subject":"93f031f7a1e4abdcbd059e89c5168d61682e8d2c","transition":"4ade042e2bfc5fed1a36a0beedfc9535051749b1fcfbb51e3fbea019cf2e817e","validation":{"mutants":["KILLED      M536 ../tools/claimslib/eligibility.py: changes after the accepted head are not read  [G10,G11,G12,G13,G14,G15,G22,G25,G26,G31,G32,G35,G48,G6,G7]","KILLED      M537 ../tools/claimslib/eligibility.py: an entry added to the store after the accepted head may be a symlink  [G12]","KILLED      M538 ../tools/claimslib/eligibility.py: a record or blob changed after the accepted head reads as added  [G13]","KILLED      M539 ../tools/claimslib/eligibility.py: a generated view may still be committed after the accepted head (G11)  [G15]","MUTANTS: 4/4 killed on target (jobs=14)"],"record_checks":["roadmap.py check OK",
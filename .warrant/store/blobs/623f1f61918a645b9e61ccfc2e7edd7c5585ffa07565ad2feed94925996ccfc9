{"commit":"213c1b9ef2f2955727bace9efad8d50fc5a3ccd4","duty":"8057c2a37f1cb29f08fded8f8684bebf4ac62c3c8791597a704653259e5281a5","head":"728aa12d5e577ee4d173315988620b396fd06d3f46938ce85fa8c7b95be195bb","pr":204,"schema":"warrant-review/finding@1","severity":"P2","test":{"case":"RACE1","file":"replay_retry_race_test","patch":"diff --git a/tests/replay_retry_race_test.py b/tests/replay_retry_race_test.py\nnew file mode 100644\n--- /dev/null\n+++ b/tests/replay_retry_race_test.py\n@@ -0,0 +1,44 @@\n+\"\"\"A replay whose observations lose a branch-tip race must remain retryable.\"\"\"\n+from review_replay_test import WAKER, at_commit, due, flaky, git, pr_world, tip\n+from world import check, finish\n+\n+\n+def main():\n+    f = pr_world()\n+    try:\n+        flaky(f, 1)\n+        f.w.due = lambda base: {\"due\": [due(f, tip(f))], \"not_due\": []}\n+        WAKER.tick(f.w, False)  # The first checker run exits 75.\n+        f.ok(\"accept\", \"--pr\", \"1\", \"--commit\", f.h2, actor=\"codex\")\n+        reviewed = f.save()\n+        git(\"-C\", str(f.dir), \"push\", \"-q\", str(f.origin), f\"{reviewed}:refs/heads/pr1\")\n+        git(\"-C\", str(f.w.mirror), \"fetch\", \"-q\", str(f.origin), \"+refs/heads/pr1:refs/heads/pr1\")\n+        moved = f.commit(\"concurrent empty commit: the reviewed tree is unchanged\")\n+\n+        def move_after_checker(cmd, result):\n+            if \"replay\" in cmd:\n+                git(\"-C\", str(f.dir), \"push\", \"-q\", str(f.origin), f\"{moved}:refs/heads/pr1\")\n+                git(\"-C\", str(f.w.mirror), \"fetch\", \"-q\", str(f.origin), \"+refs/heads/pr1:refs/heads/pr1\")\n+\n+        f.jail.after = move_after_checker\n+        f.w.due = lambda base: {\"due\": [], \"not_due\": [dict(\n+            due(f, tip(f)), head_repo=WAKER.REPO, not_due=[[\"REVIEWED\", \"accepted\"]])]}\n+        f.now[0] += WAKER.BACKOFF + 1\n+        second = WAKER.tick(f.w, False)\n+        pending = f.w.pending(1)\n+        f.jail.after = None\n+        third = WAKER.tick(f.w, False)\n+        observed = at_commit(f, tip(f)).findings[f.cid].observed\n+        check(\"RACE1\", pending and len(f.runs) == 3\n+              and sorted(observed) == sorted([f.h1, f.h2]) and not f.w.pending(1),\n+              \"a successful checker whose observations were not pushed keeps the replay pending, then \"\n+              \"retries the reviewed branch's new tip and publishes both observations\",\n+              {\"pending_after_refused_push\": pending, \"checker_runs\": len(f.runs),\n+               \"observed\": sorted(observed), \"second\": second, \"third\": third})\n+    finally:\n+        f.close()\n+    return finish(\"REPLAY_RETRY_RACE_TEST\")\n+\n+\n+if __name__ == \"__main__\":\n+    raise SystemExit(main())\n"},"tree":"bfedf82a197f4d316ff42a68febf234a5e49241d","what":"After a failed replay and a verdict, a successful retry whose observations lose the branch-tip race is saved ok=True and covers the failure; pending becomes false, so the new tip is never retried and retains no observations. Keep the replay pending until its observations reach the branch or already exist there.","where":["integrations/codex-plugin/waker/waker.py:313-322","integrations/codex-plugin/waker/waker.py:412-414","integrations/codex-plugin/waker/waker.py:607-608"]}
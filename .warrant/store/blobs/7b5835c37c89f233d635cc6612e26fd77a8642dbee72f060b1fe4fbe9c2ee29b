{"commit":"84b21d9f60129f4a0176bd27639bc08cb6aba09e","duty":"5429bc04230a9590e3ac1331e70f0e23a8c50bd90639de4364a1cdec508656cb","head":"382f580f088c1aee0066a14e40fcf0cb0afb123099ec2f34013f9d89dbb4fdeb","pr":213,"schema":"warrant-review/finding@1","severity":"P2","test":{"case":"F1","file":"graph_213_removed_goal_test","patch":"diff --git a/tests/graph_213_removed_goal_test.py b/tests/graph_213_removed_goal_test.py\nnew file mode 100644\n--- /dev/null\n+++ b/tests/graph_213_removed_goal_test.py\n@@ -0,0 +1,45 @@\n+#!/usr/bin/env python3\n+\"\"\"#213: a missing head endpoint must not hide a removed question's base metadata.\"\"\"\n+import sys\n+\n+from agent_world import check, finish, views\n+from graph_test import goal_world\n+from warrant import engine as E\n+from warrant.store import Snapshot, Trust\n+from warrant_agent import graph as G\n+\n+\n+def main():\n+    w = goal_world()\n+    _, report, view = views.load(w[\"src\"].ws, w[\"tok1\"])\n+    before = view.snapshot()\n+    trust = Trust.load(w[\"src\"].base / \"trust.json\")\n+\n+    def impact_without(*removed):\n+        after = Snapshot({k: v for k, v in before.records.items() if k not in removed}, dict(before.blobs))\n+        judged = E.assess(after, trust, report[\"view\"][\"as_of\"], report[\"profile\"])\n+        head = G.build(after, judged)\n+        return head, G.impact(w[\"g1\"], head)\n+\n+    # Control: when the question has no head endpoint at all, the new fallback works.\n+    absent_head, absent = impact_without(w[\"o3\"], w[\"q2\"].split(\":\")[0])\n+    absent_q = {q[\"question\"]: q for q in absent[\"questions\"]}\n+    control = G.Index(absent_head).kind(w[\"q2\"]) is None and absent_q[w[\"q2\"]][\"scope\"] == \"roadmap:G1\"\n+\n+    # o2 still answers q1 and requires o1. Removing o1 and q1's opener therefore\n+    # leaves both endpoints as kind=missing, rather than removing their graph nodes.\n+    head, result = impact_without(w[\"o1\"], w[\"q1\"].split(\":\")[0])\n+    qs = {q[\"question\"]: q for q in result[\"questions\"]}\n+    q = qs.get(w[\"q1\"], {})\n+    goals = sorted({q[\"scope\"][len(\"roadmap:\"):] for q in result[\"questions\"]\n+                    if (q[\"scope\"] or \"\").startswith(\"roadmap:\")})\n+    check(\"F1\", control and G.Index(head).kind(w[\"q1\"]) == \"missing\"\n+          and w[\"o1\"] in result[\"records\"][\"removed\"]\n+          and q.get(\"scope\") == \"roadmap:G1\" and q.get(\"text\") == \"A goal.\" and goals == [\"G1\"],\n+          \"impact retains a removed question's base scope and text when a surviving duty keeps a missing endpoint\",\n+          {\"control\": control, \"question\": q, \"goals\": goals})\n+    return finish(\"GRAPH-213-REMOVED-GOAL\")\n+\n+\n+if __name__ == \"__main__\":\n+    sys.exit(main())\n"},"tree":"8f88b6f2abb2ffdffbd075f3d5bfcf56a4f4772a","what":"A surviving reference hides a removed question's base scope/text: remove an answering duty and its goal-opening transition while another duty still answers the question; the truthy kind=missing head node wins the new fallback, so impact omits its roadmap goal. Read metadata through _side too.","where":["warrant_agent/graph.py:371-372"]}
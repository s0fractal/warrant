{"commit":"eca04ccfdc39cfa1d63946f36ad3fbbe4fdf2fa3","duty":"431ae379e6ae9e4858e8ac82648d3597cb60c75d15a65101d9ef260e9788e718","head":"e74de48389f7095961a54d203cf04246cafd16a72357e7e75aaebf35fa7ae7c7","pr":193,"schema":"warrant-review/finding@1","severity":"P2","test":{"case":"G1","file":"pilot_review_boundary_test","patch":"--- /dev/null\n+++ b/tests/pilot_review_boundary_test.py\n@@ -0,0 +1,81 @@\n+\"\"\"Counterexamples at #193 head 2: complete file bytes and controlled JSON refusal.\"\"\"\n+import os\n+import sys\n+import tempfile\n+from pathlib import Path\n+from unittest import mock\n+\n+from world import check, finish\n+from warrant import jcs as C\n+from warrant import pilot as PL\n+\n+\n+def growth_case(layout):\n+    with tempfile.TemporaryDirectory(prefix=\"pilot-review-growth-\") as tmp:\n+        root = Path(tmp)\n+        store = PL.LAYOUTS[layout](root)\n+        prefix = PL.STATE_MAGIC + b\"X\"\n+        name = C.digest(prefix)\n+        path = root.joinpath(*store.parts(name))\n+        path.parent.mkdir(parents=True, exist_ok=True)\n+        path.write_bytes(prefix)\n+        address = \"sigma-state:\" + name\n+        control = PL.Receiver([store]).resolve(address)[\"result\"]\n+        path.write_bytes(PL.STATE_MAGIC)\n+        full = prefix + b\"UNREAD-TAIL\"\n+        real_fstat, grown, calls = os.fstat, [], []\n+\n+        def grow(fd):\n+            before = real_fstat(fd)\n+            if not grown:\n+                path.write_bytes(full)\n+                grown.append(True)\n+            return before\n+\n+        with mock.patch.object(PL.os, \"fstat\", side_effect=grow):\n+            result = PL.Receiver([store]).check(address, lambda r: calls.append(r) or r)\n+        return {\"control\": control, \"grew\": grown == [True], \"file\": path.read_bytes() == full,\n+                \"mismatch\": C.digest(full) != name, \"result\": result.get(\"result\"),\n+                \"code\": result.get(\"code\"), \"objects\": \"objects\" in result, \"calls\": len(calls)}\n+\n+\n+def json_case():\n+    with tempfile.TemporaryDirectory(prefix=\"pilot-review-json-\") as tmp:\n+        root = Path(tmp)\n+        # Small, digest-correct, noncanonical object bytes are a typed refusal.\n+        loose = b'{\"schema\": \"warrant-pilot/root@1\"}'\n+        name = C.digest(loose)\n+        (root / name).write_bytes(loose)\n+        receiver = PL.Receiver([PL.BlobDir(root)])\n+        control = receiver.resolve(\"pilot-root:\" + name)\n+        # CPython's supported default integer conversion limit raises ValueError\n+        # before jcs.loads can turn this out-of-domain integer into NotCanonical.\n+        data = b'{\"schema\":\"warrant-pilot/root@1\",\"x\":' + b\"1\" * 5000 + b\"}\"\n+        name = C.digest(data)\n+        (root / name).write_bytes(data)\n+        calls = []\n+        try:\n+            result = receiver.check(\"pilot-root:\" + name, lambda r: calls.append(r) or r)\n+        except Exception as e:\n+            result = {\"exception\": type(e).__name__, \"detail\": str(e)[:100]}\n+        return {\"control\": (control.get(\"result\"), control.get(\"code\")), \"result\": result,\n+                \"calls\": len(calls)}\n+\n+\n+def main():\n+    got = {layout: growth_case(layout) for layout in PL.LAYOUTS}\n+    expected = {\"control\": \"RESOLVED\", \"grew\": True, \"file\": True, \"mismatch\": True,\n+                \"result\": \"REFUSED\", \"code\": \"DIGEST_MISMATCH\", \"objects\": False, \"calls\": 0}\n+    check(\"G1\", got == {layout: expected for layout in PL.LAYOUTS},\n+          \"growth beyond fstat size plus one cannot validate a prefix of a damaged object\", got)\n+    got = json_case()\n+    r = got[\"result\"]\n+    check(\"J1\", got[\"control\"] == (\"REFUSED\", \"KIND_MISMATCH\")\n+          and r.get(\"result\") == \"REFUSED\" and r.get(\"code\") == \"KIND_MISMATCH\"\n+          and \"objects\" not in r and got[\"calls\"] == 0,\n+          \"a digest-correct JSON object with an oversized integer returns a typed refusal\", got)\n+    return finish(\"PILOT REVIEW BOUNDARIES\")\n+\n+\n+if __name__ == \"__main__\":\n+    sys.exit(main())\n"},"tree":"1a341a97613e2e4b334417e08a9ca38715d647e8","what":"A file growing by more than one byte after fstat is truncated to st_size+1; a name hashing to that prefix resolves and invokes the verifier even though the whole stored file hashes differently (both layouts; expected DIGEST_MISMATCH).","where":["warrant/pilot.py:213"]}
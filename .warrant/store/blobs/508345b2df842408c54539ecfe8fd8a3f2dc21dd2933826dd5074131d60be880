{"commit":"84fb862967e97529a5b10f80240bdc05eec1d6de","duty":"5429bc04230a9590e3ac1331e70f0e23a8c50bd90639de4364a1cdec508656cb","head":"86c6fc142e147489d21cd55ab8b8548f5f0bca08ffb3377151117a937be0b813","pr":213,"schema":"warrant-review/finding@1","severity":"P2","test":{"case":"F1","file":"graph_removed_blob_test","patch":"--- /dev/null\n+++ b/tests/graph_removed_blob_test.py\n@@ -0,0 +1,47 @@\n+#!/usr/bin/env python3\n+\"\"\"A removed duty remains a record of the base even when its address is a head blob.\"\"\"\n+from agent_world import C, R, api, check, finish, views, world\n+from warrant_agent import graph as G\n+\n+\n+def main():\n+    src, _ = world()\n+    opener = src.file('transition', 'producer', 90, R.transition(\n+        'ATTESTED', established=['A goal.'], opened=[{'text': 'A goal.', 'scope': 'roadmap:G1'}]))\n+    question = f'{opener}:0'\n+    duty = src.file('duty', 'producer', 100, R.duty(\n+        'producer', 'The removed obligation.', ['reviewer'], {'attest': {}},\n+        accept_by=['reviewer'], answers=question))\n+    src.file('duty', 'producer', 110, R.duty(\n+        'producer', 'A surviving reference.', ['reviewer'], {'attest': {}}, accept_by=['reviewer'], requires=[duty]))\n+    # Record ids hash canonical record bodies. The very same bytes are a legal blob;\n+    # no hash collision or forged address is needed to have both namespaces hold it.\n+    env = C.loads((src.store.root / 'records' / f'{duty}.json').read_bytes())\n+    assert src.blob(C.canon(env['record'])) == duty\n+    base = views.capture(src.ws)['token']\n+    (src.store.root / 'records' / f'{duty}.json').unlink()\n+    head = views.capture(src.ws)['token']\n+    _, rb, vb = views.load(src.ws, base)\n+    _, rh, vh = views.load(src.ws, head)\n+    gb, gh = G.build(vb.snapshot(), rb), G.build(vh.snapshot(), rh)\n+    im = G.impact(gb, gh)\n+    result = api.call(src.cfg, 'graph', {'workspace': src.name, 'op': 'impact',\n+        'view_token': head, 'base_view_token': base})\n+    data = result.get('ok', {}).get('data', {})\n+    via = {x['duty']: x for x in im['duties']}\n+    q = [x for x in im['questions'] if x['question'] == question]\n+    public_q = [x for x in data.get('items', []) if x.get('section') == 'question']\n+    check('F1', not rb['invalid_records'] and not rh['invalid_records']\n+          and G.Index(gh).kind(duty) == 'blob' and im['records']['removed'] == [duty]\n+          and via.get(duty, {}).get('statement') == 'The removed obligation.'\n+          and via.get(duty, {}).get('answers') == question\n+          and q and q[0]['scope'] == 'roadmap:G1' and q[0]['by'] == [duty]\n+          and [x['question'] for x in public_q] == [question],\n+          'a removed duty backed by a same-address blob keeps its base relations and goal in engine and agent impact',\n+          {'head_kind': G.Index(gh).kind(duty), 'duty': via.get(duty),\n+           'questions': im['questions'], 'agent_summary': data.get('summary')})\n+    return finish('GRAPH REMOVED BLOB')\n+\n+\n+if __name__ == '__main__':\n+    raise SystemExit(main())\n"},"tree":"d72f28eaca3e0f1dd64d1ade1c52af7a3e7bed73","what":"Use the base for a removed duty whose head endpoint is a blob. A blob of C.canon(record) legitimately shares its id; a surviving reference makes that head node a blob. _side selects it, losing statement, answers and serves: engine and agent omit the question; CLI loses G11. F1 fails at X and passes when blob endpoints fall back to the base.","where":["warrant_agent/graph.py:326"]}
{"commit":"9052c7f61e415e97e51d01d0f3f153f7e1e05f33","duty":"1bd8f8fbed7046d2acb6fcdf87aeb279b5e4cb23f2a2afc97030a7f3c123db1d","head":"56563fa1407b9d4742d75e59a03bb77e61affb1b7c7932841a0de175e4c11d05","pr":209,"schema":"warrant-review/finding@1","severity":"P2","test":{"case":"F1","file":"review_graph_counterexample_test","patch":"--- /dev/null\n+++ b/tests/review_graph_counterexample_test.py\n@@ -0,0 +1,68 @@\n+#!/usr/bin/env python3\n+\"\"\"Codex counterexamples for #209 at 9052c7f61e415e97e51d01d0f3f153f7e1e05f33.\"\"\"\n+import sys\n+\n+from agent_world import check, finish, world, R\n+from warrant_agent import api, graph as G\n+\n+\n+def paging_case():\n+    src, _ = world()\n+    src.file(\"duty\", \"producer\", 100, R.duty(\"producer\", \"one\", [\"reviewer\"], {\"attest\": {}}, accept_by=[\"reviewer\"]))\n+    src.file(\"transition\", \"producer\", 101, R.transition(\"ATTESTED\", established=[\"two\"]))\n+    req = {\"workspace\": src.name, \"op\": \"export\", \"max_bytes\": 256}\n+    first = api.call(src.cfg, \"graph\", req)[\"ok\"]\n+    resumed = api.call(src.cfg, \"graph\", dict(req, view_token=first[\"view_token\"], cursor=first[\"page\"][\"cursor\"]))\n+    # The same request works when its first call explicitly names that already captured view.\n+    explicit = dict(req, view_token=first[\"view_token\"])\n+    control = api.call(src.cfg, \"graph\", explicit)[\"ok\"]\n+    control_next = api.call(src.cfg, \"graph\", dict(explicit, cursor=control[\"page\"][\"cursor\"]))\n+    check(\"F1\", bool(first[\"page\"][\"cursor\"]) and \"ok\" in resumed and \"ok\" in control_next\n+          and resumed[\"ok\"][\"page\"][\"offset\"] == first[\"page\"][\"included\"],\n+          \"a graph request omitting view_token can continue with its returned token and cursor\",\n+          {\"resume\": resumed.get(\"error\"), \"explicit_view_control\": \"ok\" in control_next})\n+\n+\n+def depth_case():\n+    from contract_test import _chain\n+    from warrant import engine as E\n+    snap, trust, as_of, ids = _chain(1200)\n+    report = E.assess(snap, trust, as_of, E.profile())\n+    g = G.build(snap, report)\n+    control = G.path(g, ids[99])\n+    try:\n+        deep = G.path(g, ids[-1])\n+        got = [x[\"duty\"] for x in deep[\"duties\"]]\n+        error = None\n+    except RecursionError as exc:\n+        got, error = [], type(exc).__name__\n+    check(\"F2\", len(report[\"duties\"]) == 1200 and not report[\"invalid_records\"]\n+          and [x[\"duty\"] for x in control[\"duties\"]] == ids[:100] and got == ids,\n+          \"graph path traverses a valid 1200-duty chain that the engine assessed, prerequisites first\",\n+          {\"assessed\": len(report[\"duties\"]), \"short_control\": len(control[\"duties\"]), \"exception\": error})\n+\n+\n+def shape_case():\n+    src, _ = world()\n+    got = []\n+    for bad in ([], {}, [\"path\"]):\n+        try:\n+            result = api.call(src.cfg, \"graph\", {\"workspace\": src.name, \"op\": bad})\n+            got.append(result.get(\"error\"))\n+        except TypeError as exc:\n+            got.append(type(exc).__name__)\n+    control = api.call(src.cfg, \"graph\", {\"workspace\": src.name, \"op\": \"unknown\"})\n+    check(\"F3\", got == [\"BAD_REQUEST\"] * 3 and control.get(\"error\") == \"BAD_REQUEST\",\n+          \"non-string graph op values receive BAD_REQUEST rather than escaping the API as TypeError\",\n+          got)\n+\n+\n+def main():\n+    paging_case()\n+    depth_case()\n+    shape_case()\n+    return finish(\"REVIEW GRAPH COUNTEREXAMPLES\")\n+\n+\n+if __name__ == \"__main__\":\n+    sys.exit(main())\n"},"tree":"72cd5b7b3bde7e37c1875b7e63eb1492b9105353","what":"Graph paging hashes the raw view_token field: export without it returns a cursor, but resuming with the returned token changes the digest and gives CURSOR_MISMATCH. Normalize or exclude view_token when hashing the request so default-view requests can continue.","where":["warrant_agent/api.py:526"]}
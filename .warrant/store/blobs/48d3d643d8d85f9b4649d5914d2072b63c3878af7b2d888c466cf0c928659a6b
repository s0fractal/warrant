{"commit":"ffd24f5c2f6e296d3b68865bdf4221c53aa9429e","duty":"20fa1f8ba139365cfcce657493e69b2070ec04e97fc59b60740c7e95fd27e84e","head":"e84e0ec48c956377208ecc4ce3a7370d9557f589ca3b5dcce05321516841d054","pr":194,"schema":"warrant-review/finding@1","severity":"P2","test":{"case":"F1","file":"verdict_fork_hold_test","patch":"diff --git a/tests/verdict_fork_hold_test.py b/tests/verdict_fork_hold_test.py\nnew file mode 100644\n--- /dev/null\n+++ b/tests/verdict_fork_hold_test.py\n@@ -0,0 +1,37 @@\n+#!/usr/bin/env python3\n+\"\"\"A fork's branch name must not hold acceptance wakes.\"\"\"\n+from review_replay_test import WAKER, entry, pr_world\n+from claimslib import eligibility as EL\n+from world import check, finish\n+\n+\n+def main():\n+    f = pr_world()\n+    try:\n+        f.w.fetch = lambda: f.start\n+        f.w.acceptances = lambda base: {\"due\": [entry(1)]}\n+        raw = {\"number\": 999, \"head\": \"e\" * 40,\n+               \"branch\": WAKER.VERDICT_BRANCH + \"spoofed\",\n+               \"head_repo\": \"outsider/warrant\", \"title\": \"unrelated fork\"}\n+        assessed = EL.Assessment(raw, f.start)\n+        assessed.shared = [(\"NO_REVIEW\", \"no signed review records\")]\n+        assessed.reasons = list(assessed.shared)\n+        fork = EL.as_json(assessed)  # the same projection review.py due gives the waker\n+        f.w.due = lambda base: {\"due\": [], \"not_due\": [fork]}\n+        first = WAKER.tick(f.w, False)\n+        second = WAKER.tick(f.w, False)\n+        calls = len(f.codex.calls)\n+        check(\"F1\", calls == 1,\n+              \"an unrelated fork cannot suppress a due closure just by naming its branch codex/verdicts/\",\n+              {\"codex_calls\": calls, \"first\": first, \"second\": second})\n+        fork[\"branch\"] = \"ordinary-feature\"\n+        WAKER.tick(f.w, False)\n+        check(\"F0\", len(f.codex.calls) == 1,\n+              \"positive control: the same fork under an ordinary branch leaves the closure wakeable\")\n+    finally:\n+        f.close()\n+    return finish(\"VERDICT_FORK_HOLD\")\n+\n+\n+if __name__ == \"__main__\":\n+    raise SystemExit(main())\n"},"tree":"64149b7dea404f15d76bbb81361445bded12d841","what":"A fork PR named codex/verdicts/* blocks every obligation-acceptance wake indefinitely: hold() trusts its branch even when NO_REVIEW or VERDICTS_FORK refuses the PR. Carry head-repository identity through due JSON and hold only this repository's verdict PRs; F1 reproduces at ffd24f5 and F0 restores the wake by changing only the fork's branch name.","where":["integrations/codex-plugin/waker/waker.py:531","tools/claimslib/eligibility.py:597"]}
{"commit":"bb0fb0777003fbbc27d1b180c407034e438d615f","duty":"f9c14b2b0298f150549aa20c45425996474a911d018b19e802e281f1c15fd315","head":"6828f7c905bcf37cea1b1cb738bfe199bde87e2d514c5713ef38e12202d38876","pr":197,"schema":"warrant-review/finding@1","severity":"P2","test":{"case":"OB1","file":"merge_observation_binding_test","patch":"diff --git a/tests/merge_observation_binding_test.py b/tests/merge_observation_binding_test.py\nnew file mode 100644\n--- /dev/null\n+++ b/tests/merge_observation_binding_test.py\n@@ -0,0 +1,42 @@\n+\"\"\"An unrelated merge observation cannot satisfy the next head's required observation.\"\"\"\n+from review_world import FIXED, Fixture, branch, merge\n+from world import check, finish\n+\n+\n+def main():\n+    f = Fixture()\n+    try:\n+        branch(f, 'unrelated')\n+        tip0 = f.commit('unrelated change', {'unrelated.txt': 'x\\n'})\n+        unrelated = merge(f, tip0, 'Merge pull request #900 from fixture/unrelated')\n+        branch(f, 'pr1')\n+        h1 = f.commit('reviewed change', {'calc.py': FIXED})\n+        f.ok('open', '--pr', '1', '--title', 'One')\n+        f.ok('head', '--pr', '1', '--commit', h1)\n+        f.save()\n+        f.ok('accept', '--pr', '1', '--commit', h1, actor='codex')\n+        tip1 = f.save()\n+        actual = merge(f, tip1, 'Merge pull request #1 from fixture/pr1')\n+        before = f.files()\n+        rc, out, err = f.run('merged', '--pr', '1', '--merge', unrelated)\n+        if rc != 0:\n+            check('OB1', rc == 2 and f.files() == before,\n+                  'an observation of an unrelated merge is refused without writing', (rc, out, err))\n+        else:\n+            f.save()\n+            branch(f, 'pr2')\n+            h2 = f.commit('next change', {'next.txt': 'x\\n'})\n+            f.ok('open', '--pr', '2', '--title', 'Two')\n+            before_head = f.files()\n+            rc2, out2, err2 = f.run('head', '--pr', '2', '--commit', h2)\n+            check('OB1', rc2 == 2 and f.files() == before_head,\n+                  'the next head refuses while the actual PR merge has no matching observation',\n+                  {'actual_merge': actual, 'observed_merge': unrelated,\n+                   'head_rc': rc2, 'head_out': out2, 'head_err': err2})\n+    finally:\n+        f.close()\n+    return finish('MERGE_OBSERVATION_BINDING_TEST')\n+\n+\n+if __name__ == '__main__':\n+    raise SystemExit(main())\n"},"tree":"05617f151ae25fa4fdf6e8626f770820b9efc40f","what":"An unrelated older merge observation makes merged --due skip the actual PR merge and lets head pass without observing it (check --base also accepts the records); bind existing observations to the discovered merge.","where":["tools/claimslib/reviews.py:746"]}
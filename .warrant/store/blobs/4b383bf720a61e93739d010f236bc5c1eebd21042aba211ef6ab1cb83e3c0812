{"commit":"41a10739b0fe75b8618aa60344023547e35fd8c7","duty":"20fa1f8ba139365cfcce657493e69b2070ec04e97fc59b60740c7e95fd27e84e","head":"246adae2a062f7530dcf5b153e8a638cac72012b49a6a136e91c1f2f9021d008","pr":194,"schema":"warrant-review/finding@1","severity":"P2","test":{"case":"A194R1","file":"review194_replacement_test","patch":"diff --git a/tests/review194_replacement_test.py b/tests/review194_replacement_test.py\nnew file mode 100644\n--- /dev/null\n+++ b/tests/review194_replacement_test.py\n@@ -0,0 +1,31 @@\n+#!/usr/bin/env python3\n+\"\"\"PR 194: an accepted replacement must not make the filed-over closure due.\"\"\"\n+from roadmap_test import Repo, due\n+from world import check, finish\n+\n+\n+def main():\n+    r = Repo()\n+    try:\n+        r.ok(\"goal\", \"--id\", \"G1\", \"--text\", \"The ledger exists.\")\n+        duty = r.ok(\"oblige\", \"--text\", \"One thing.\", \"--answers\", \"G1\")\n+        old = r.ok(\"done\", \"--duty\", duty, \"--established\", \"first attempt\",\n+                   \"--ref\", \"s0fractal/warrant#1\")\n+        replacement = r.ok(\"done\", \"--duty\", duty, \"--established\", \"repaired attempt\",\n+                           \"--ref\", \"s0fractal/warrant#2\", \"--replaces\", old)\n+        before = due(r)\n+        r.accept(replacement)\n+        model = r.model()\n+        after = due(r)\n+        check(\"A194R1\", before == [replacement]\n+              and model.rep[\"duties\"][duty][\"disposition\"] == \"DISCHARGED\"\n+              and after == [],\n+              \"accepting the replacement leaves neither it nor the filed-over closure due\",\n+              {\"old\": old, \"replacement\": replacement, \"before\": before, \"after\": after})\n+    finally:\n+        r.close()\n+    return finish(\"PR194_REPLACEMENT\")\n+\n+\n+if __name__ == \"__main__\":\n+    raise SystemExit(main())\n"},"tree":"7d56c0da52e8fa00fec348d20402357c48bdfa4f","what":"Do not wake a filed-over closure after accepting its replacement: done --replaces T1 then accept T2 leaves the duty DISCHARGED, but filtering to PENDING first makes T1 due again, so a discarded, unchallenged attempt is sent for review.","where":["tools/roadmap.py:371-373"]}
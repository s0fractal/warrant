{"commit":"a7eebef499e79f1ae85f9b347ff644dd0f77e11e","duty":"aadb208517a0aed5fd115d8684f18c5404395b24d84314421b04eefce88c6c8a","head":"4a6f04d9a4027f301aa03f800efe055eb3efc6cc36700c35287af1ac0bb4a0e9","pr":195,"schema":"warrant-review/finding@1","severity":"P2","test":{"case":"F1","file":"review_195_frontier_test","patch":"diff --git a/tests/review_195_frontier_test.py b/tests/review_195_frontier_test.py\nnew file mode 100644\n--- /dev/null\n+++ b/tests/review_195_frontier_test.py\n@@ -0,0 +1,30 @@\n+#!/usr/bin/env python3\n+\"\"\"A delegation is not the admitted replacement closure of a pending discharge.\"\"\"\n+import sys\n+\n+from world import World, E, HOLDER, OWNER, CODEX, check, finish\n+\n+\n+def offered(variant):\n+    w = World()\n+    duty = w.duty()\n+    pending = w.close(duty)\n+    if variant == \"delegation\":\n+        delegation = w.close(duty, act=\"delegate\", to=CODEX,\n+                             tkw={\"supersedes\": [pending]})\n+        w.accept(CODEX, delegation)\n+    # This discharge does not replace pending unless it explicitly says so.\n+    replacement = w.close(duty, tkw={\"supersedes\": [pending]} if variant == \"replacement\" else {})\n+    w.accept(OWNER, replacement)\n+    rep = w.assess(prof=E.profile(results_by=[]))\n+    asked = any(n.get(\"need\") == \"accept\" and n.get(\"transition\") == pending\n+                for n in E.frontier(rep, OWNER))\n+    return rep[\"duties\"][duty][\"disposition\"], asked\n+\n+\n+got = {variant: offered(variant) for variant in (\"unrelated-discharge\", \"delegation\", \"replacement\")}\n+check(\"F1\", got[\"unrelated-discharge\"] == got[\"delegation\"] == (\"DISCHARGED\", True),\n+      \"a delegation cannot retire a pending discharge when another closure discharged the duty\", got)\n+check(\"F2\", got[\"replacement\"] == (\"DISCHARGED\", False),\n+      \"an admitted discharge that explicitly supersedes the pending one does retire it\", got)\n+sys.exit(finish(\"REVIEW_195_FRONTIER\"))\n"},"tree":"9905c76d31cc6baa2b816955f4813d5ae560c5f1","what":"An admitted delegation that lists a pending discharge in supersedes hides that discharge from its acceptor once an unrelated closure discharges the duty. The delegation is not a replacement closure; keep the acceptance owed unless a settlement or revalidation of this duty supersedes it (F1 passes at base 1a660a6, fails at a7eebef).","where":["warrant/engine.py:930","warrant/engine.py:932"]}
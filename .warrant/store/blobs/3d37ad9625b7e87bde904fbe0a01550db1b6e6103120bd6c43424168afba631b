{"commit":"2916eeb4bd168ef9fa772cf809b2ada38bdeead7","duty":"20fa1f8ba139365cfcce657493e69b2070ec04e97fc59b60740c7e95fd27e84e","head":"c9f7a2fb3f2d3e5ea62178ab38fca040cf3acad36ca660251e00ac60137a5170","pr":194,"schema":"warrant-review/finding@1","severity":"P2","test":{"case":"F1","file":"base_witness_identity_test","patch":"diff --git a/tests/base_witness_identity_test.py b/tests/base_witness_identity_test.py\nnew file mode 100644\n--- /dev/null\n+++ b/tests/base_witness_identity_test.py\n@@ -0,0 +1,46 @@\n+#!/usr/bin/env python3\n+\"\"\"New witness names must not rebind the supplied base's existing witnesses.\n+\n+The manifest below is from master 910c969009b1e00763de00b653eaf08646eab987,\n+not a receiver-local checkout. Both source inputs are immutable review inputs.\n+Reusing these names for unrelated checks makes a union define duplicate mutant\n+ids, and roadmap_test's duplicate P26 overwrites the earlier result in world.results.\n+Allocate unused ids for this PR's additions; retain the base witnesses on integration.\n+A scratch merge of M and H produced tree b2141dc2bed4b9c5b403f33c845c6608e69a0d34.\n+roadmap_test.py merged without conflict and contained both P26 checks. Applying\n+master's M642 mutation (remove the done --replaces supersedes link) printed FAIL\n+P26 from requires_cases, then PASS P26 from due_cases; ROADMAP reported 30 PASS,\n+0 FAIL and exited 0. The current witness recorder keys results only by case id.\n+\"\"\"\n+import ast\n+from pathlib import Path\n+\n+import mutants\n+from world import check, finish\n+\n+BASE = {\n+    \"M641\": (\"engine.py\", \"contract_test\", [\"F6\"]),\n+    \"M642\": (\"../tools/roadmap.py\", \"roadmap_test\", [\"P26\"]),\n+    \"M643\": (\"pilot.py\", \"pilot_test\", [\"D11\"]),\n+    \"M644\": (\"pilot.py\", \"pilot_test\", [\"A13\"]),\n+    \"M645\": (\"engine.py\", \"contract_test\", [\"F7\"]),\n+}\n+\n+\n+def main():\n+    rebound = [(m[0], (m[1], m[4], list(m[5])), BASE[m[0]])\n+               for m in mutants.MUTANTS if m[0] in BASE\n+               and (m[1], m[4], list(m[5])) != BASE[m[0]]]\n+    tree = ast.parse((Path(__file__).parent / \"roadmap_test.py\").read_text())\n+    owners = [f.name for f in ast.walk(tree) if isinstance(f, ast.FunctionDef)\n+              for n in ast.walk(f) if isinstance(n, ast.Call)\n+              and isinstance(n.func, ast.Name) and n.func.id == \"check\" and n.args\n+              and isinstance(n.args[0], ast.Constant) and n.args[0].value == \"P26\"]\n+    check(\"F1\", not rebound and all(f == \"requires_cases\" for f in owners),\n+          \"new witnesses do not rebind current master's M641-M645 or roadmap P26 to unrelated guards\",\n+          {\"rebound_mutants\": rebound, \"P26_owners\": owners})\n+    return finish(\"BASE_WITNESS_IDENTITY\")\n+\n+\n+if __name__ == \"__main__\":\n+    raise SystemExit(main())\n"},"tree":"914a178534f354f9989625a18f7fd788ae351bbc","what":"New witness IDs collide with master 910c969009b1: M641-M645 name unrelated guards and P26 names another check. In a scratch merge, master's M642 defect prints FAIL P26, then PASS P26 and exits 0 because world.results overwrites it. Allocate unused IDs and update their references; retain master's witnesses. F1 fails at X and passes at M.","where":["tests/mutants.py:1727","tests/mutants.py:1755","tests/roadmap_test.py:542","tests/world.py:84"]}
fig in bad.items():\n+            calls = []\n+            try:\n+                receiver = P.Receiver.from_config(config)\n+                result = receiver.check(address, lambda r: calls.append(r) or r)\n+                got[label] = (\"accepted\", result.get(\"result\"), len(calls))\n+            except ValueError:\n+                got[label] = (\"refused\",)\n+            except Exception as exc:\n+                got[label] = (\"raised\", type(exc).__name__)\n+        check(\"C1\", control.get(\"result\") == \"RESOLVED\" and bounded.get(\"code\") == \"LIMIT\"\n+              and got == {label: (\"refused\",) for label in bad},\n+              \"malformed limits and layout containers are ValueError refusals, never default budgets or crashes\",\n+              got)\n+    return finish(\"PILOT REVIEW CONFIG\")\n+\n+\n+if __name__ == \"__main__\":\n+    sys.exit(main())\n"},"tree":"84f2674694cf339ec5cfa8d873ba6c66452b00c4","what":"Validate receiver configuration containers before using them: limits false/0/\"\"/[] silently select default budgets and reach the verifier, true/1/\"invalid\"/[1] raise AttributeError, and layout []/{} raises TypeError; PC-26 and Receiver.from_config require malformed configuration to be refused with ValueError.","where":["warrant/pilot.py:340","warrant/pilot.py:349","warrant/limits.py:29"]}
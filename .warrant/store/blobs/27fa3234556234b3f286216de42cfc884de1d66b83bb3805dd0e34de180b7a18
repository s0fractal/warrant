{"commit":"f207ba5252a646f772a0068b2491da1c0206aa44","duty":"8057c2a37f1cb29f08fded8f8684bebf4ac62c3c8791597a704653259e5281a5","head":"5c1b65f93bff2b3a98dd35af958e69ccc4fd82e98865c6c6b75df70bc92638f8","pr":204,"schema":"warrant-review/finding@1","severity":"P2","test":{"case":"SEED1","file":"replay_retry_seed_test","patch":"diff --git a/tests/replay_retry_seed_test.py b/tests/replay_retry_seed_test.py\nnew file mode 100644\n--- /dev/null\n+++ b/tests/replay_retry_seed_test.py\n@@ -0,0 +1,42 @@\n+\"\"\"A pending replay must not suppress review forever when the checker key becomes unavailable.\"\"\"\n+from review_replay_test import WAKER, due, flaky, pr_world\n+from world import check, finish\n+\n+\n+def no_seed(_):\n+    return \"replay skipped: the new base's checker seed is not installed\", None\n+\n+\n+def main():\n+    f = pr_world()\n+    try:\n+        flaky(f, 1)\n+        f.w.due = lambda base: {\"due\": [due(f)], \"not_due\": []}\n+        WAKER.tick(f.w, False)  # a real retry memo, after one transient checker failure\n+        f.w.seed = no_seed     # e.g. the base adopts a checker whose key is not installed yet\n+        seen = []\n+        for _ in range(WAKER.MAX_TRIES + 2):\n+            f.now[0] += WAKER.BACKOFF * 8 + 1\n+            seen.append(WAKER.tick(f.w, False))\n+        _, memo = f.w.replay_memo(due(f))\n+        check(\"SEED1\", len(f.codex.calls) == 1,\n+              \"a previously failed replay cannot block the reviewer forever when no checker seed is available\",\n+              {\"checker_runs\": len(f.runs), \"wakes\": len(f.codex.calls),\n+               \"attempts\": len(memo[\"attempts\"]), \"state\": f.w.replay_state(memo)[0], \"ticks\": seen})\n+    finally:\n+        f.close()\n+    g = pr_world()\n+    try:\n+        flaky(g, 0)\n+        g.w.seed = no_seed\n+        g.w.due = lambda base: {\"due\": [due(g)], \"not_due\": []}\n+        WAKER.tick(g.w, False)\n+        check(\"CONTROL1\", len(g.codex.calls) == 1 and not g.runs,\n+              \"without a failed memo the same missing seed permits review, as documented\")\n+    finally:\n+        g.close()\n+    return finish(\"REPLAY_RETRY_SEED\")\n+\n+\n+if __name__ == \"__main__\":\n+    raise SystemExit(main())\n"},"tree":"05c5e541b57a24fc9d443211a6d26105db1b44e9","what":"After a failed replay, an unavailable checker seed permanently suppresses review: replay() returns before recording another attempt, while wake_after_replay() keeps the old memo pending. Even after five backoff intervals, no reviewer is woken and MAX_TRIES is never reached. Treat the unavailable run explicitly so review can proceed with its replay gap.","where":["integrations/codex-plugin/waker/waker.py:317-319","integrations/codex-plugin/waker/waker.py:614-617"]}
{"commit":"30d2a50c569b5b74c0137beb9eb32644c0bfeb0e","duty":"4820bb89ab8893ada9bd4708b49d600b503f3d46355bca6f59abd5a25bab8ba7","head":"31be40118903e127134caadef77b87d7d413a2f641c398ebcfbaf8a19acb59de","pr":211,"schema":"warrant-review/finding@1","severity":"P2","test":{"case":"F1","file":"codex_waker_delivery_h8_test","patch":"diff --git a/tests/codex_waker_delivery_h8_test.py b/tests/codex_waker_delivery_h8_test.py\nnew file mode 100644\n--- /dev/null\n+++ b/tests/codex_waker_delivery_h8_test.py\n@@ -0,0 +1,96 @@\n+\"\"\"Adversarial delivery checks for #211 head 8. All Git remotes are local fixtures.\"\"\"\n+import os\n+import sys\n+from pathlib import Path\n+\n+ROOT = Path(os.environ.get('WARRANT_IMPL') or Path(__file__).resolve().parents[1])\n+sys.path.insert(0, str(ROOT / 'tests'))\n+import review_replay_test as T\n+from world import check, finish\n+\n+\n+def assess(f, base, tip):\n+    return T.EL.assess(f.origin, base,\n+                      {'number': 210, 'state': 'open', 'draft': False, 'base': 'master', 'head': tip,\n+                       'labels': [], 'branch': f.branch, 'head_repo': T.REPO}, T.green(tip))\n+\n+\n+def inherited_evidence(mode):\n+    f = T.verdict_world()\n+    try:\n+        clone = f.base / 'courier'\n+        T.git('clone', '-q', str(f.origin), str(clone))\n+        T.git('-C', str(clone), 'checkout', '-qb', f.branch, f.base_commit)\n+        T.sign_into(clone, f, 'codex', 'challenge', T.R.challenge(f.t, 'remote verdict', [f.ev], 0))\n+        evidence = clone / T.WAKER.STORE / 'blobs' / f.ev\n+        if mode == 'corrupt':\n+            evidence.write_bytes(b'corrupted evidence\\n')\n+        elif mode == 'delete':\n+            evidence.unlink()\n+        elif mode == 'symlink':\n+            text = evidence.read_text()\n+            evidence.unlink()\n+            evidence.symlink_to(text)\n+        T.git('-C', str(clone), 'add', '-A')\n+        T.git('-C', str(clone), 'commit', '-qm', 'courier verdict')\n+        T.git('-C', str(clone), 'push', '-q', 'origin', f'HEAD:refs/heads/{f.branch}')\n+        f.forge.prs[f.branch] = 210\n+        f.codex.prepare = lambda wt: T.challenge(f, wt)\n+        line = T.WAKER.tick(f.w, False)[-1]\n+        memo = T.accept_memo(f)\n+        kept = Path(memo['attempts'][-1]['worktree']).exists()\n+        tip = T.branch_tip(f)\n+        snap, problems = T.EL.store_at(f.origin, tip)\n+        gate = assess(f, f.base_commit, tip)\n+        return {'published': bool(memo.get('published')), 'kept': kept,\n+                'evidence': f.ev in snap.blobs, 'eligible': gate.eligible,\n+                'reasons': gate.reasons, 'store_problems': problems, 'line': line}\n+    finally:\n+        f.close()\n+\n+\n+def evidence_case():\n+    seen = {mode: inherited_evidence(mode) for mode in ('valid', 'corrupt', 'delete', 'symlink')}\n+    control = seen['valid']\n+    check('F1', control['published'] and not control['kept'] and control['eligible']\n+          and all(not row['published'] and row['kept'] for mode, row in seen.items() if mode != 'valid'),\n+          'a remote verdict whose inherited evidence is corrupted, removed or a symlink is not delivered; '\n+          'preserve the local verdict, while accepting the intact courier control', seen)\n+\n+\n+def merge_during_wake():\n+    f = T.verdict_world()\n+    merged = {}\n+    try:\n+        def prepare(wt):\n+            # A courier publishes and merges while Codex is running against the captured base.\n+            T.challenge(f, wt, 'newly prepared verdict')\n+            clone = f.base / 'courier'\n+            T.git('clone', '-q', str(f.origin), str(clone))\n+            T.git('-C', str(clone), 'checkout', '-qb', f.branch, f.base_commit)\n+            merged['record'] = T.challenge(f, clone, 'courier verdict')\n+            T.git('-C', str(clone), 'add', '.warrant/store')\n+            T.git('-C', str(clone), 'commit', '-qm', 'courier verdict')\n+            merged['tip'] = T.git('-C', str(clone), 'rev-parse', 'HEAD')\n+            T.git('-C', str(clone), 'push', '-q', 'origin', f'HEAD:refs/heads/{f.branch}', 'HEAD:refs/heads/master')\n+            # The PR's head remains addressable after delete_branch_on_merge deletes the branch.\n+            T.git('-C', str(f.origin), 'update-ref', 'refs/pull/210/head', merged['tip'])\n+            T.git('-C', str(clone), 'push', '-q', 'origin', f':refs/heads/{f.branch}')\n+            f.forge.pulls = lambda branch: [(210, 'MERGED')]\n+        f.codex.prepare = prepare\n+        lines = T.WAKER.tick(f.w, False)\n+        tip = T.branch_tip(f)\n+        gate = assess(f, merged['tip'], tip) if tip else None\n+        check('F2', not f.forge.opened and tip is None,\n+              'a verdict merged during the wake, with its source branch deleted, is already published: '\n+              'do not recreate the branch or open a duplicate verdict PR',\n+              {'duplicates': len(f.forge.opened), 'branch_recreated': tip is not None,\n+               'duplicate_reasons': gate.reasons if gate else [], 'line': lines[-1]})\n+    finally:\n+        f.close()\n+\n+\n+if __name__ == '__main__':\n+    evidence_case()\n+    merge_during_wake()\n+    raise SystemExit(finish('CODEX_WAKER_DELIVERY_H8_TEST'))\n"},"tree":"61b7f413ba7419de3ba6759338afcf0e6acc4f26","what":"Delivery counts a signed verdict with corrupt, removed or symlinked inherited evidence as published: --diff-filter=A omits those paths and verification falls back to the base's blob. It deletes Codex's newly prepared verdict worktree although the remote PR is merge-ineligible.","where":["integrations/codex-plugin/waker/waker.py:791"]}
{"commit":"fd65c508a0226835caabe6bf9163d0be820b7982","duty":"4820bb89ab8893ada9bd4708b49d600b503f3d46355bca6f59abd5a25bab8ba7","head":"dc06b257c021ae7ef0a15b6f38417645e7cd3d04a3ecb21d6d8a9a0e6b9cbe71","pr":211,"schema":"warrant-review/finding@1","severity":"P2","test":{"case":"F1","file":"codex_waker_publication_test","patch":"diff --git a/tests/codex_waker_publication_test.py b/tests/codex_waker_publication_test.py\nnew file mode 100644\n--- /dev/null\n+++ b/tests/codex_waker_publication_test.py\n@@ -0,0 +1,95 @@\n+\"\"\"Counterexamples on PR #211 code fd65c508; fixtures use generated keys and local origins only.\"\"\"\n+import io\n+import json\n+from pathlib import Path\n+import subprocess\n+import tarfile\n+\n+import review_replay_test as T\n+from world import check, finish\n+\n+\n+def evidence_binding():\n+    # An accept binds (transition, item, evidence), not just the first two fields.\n+    f = T.verdict_world()\n+    try:\n+        f.codex.prepare = lambda wt: T.sign_into(wt, f, \"codex\", \"accept\", T.R.accept(f.t, 0, []))\n+        lines = T.WAKER.tick(f.w, False)\n+        tip = T.branch_tip(f)\n+        memo = T.accept_memo(f)\n+        fresh_refused = tip is None and not memo.get(\"published\") and not f.forge.opened\n+        fresh = {\"lines\": lines, \"tip\": tip, \"published\": bool(memo.get(\"published\"))}\n+    finally:\n+        f.close()\n+\n+    # The same authentic but nonbinding accept can already be on master. It must\n+    # not suppress delivery of the valid challenge prepared by this new wake.\n+    g = T.verdict_world()\n+    try:\n+        prior = T.sign_into(g.dir, g, \"codex\", \"accept\", T.R.accept(g.t, 0, []))\n+        T.roadmap(g.dir, \"project\")\n+        g.base_commit = g.save()\n+        T.git(\"-C\", str(g.dir), \"push\", \"-q\", str(g.origin), f\"{g.base_commit}:refs/heads/master\")\n+        T.git(\"-C\", str(g.w.mirror), \"fetch\", \"-q\", str(g.origin), \"+refs/heads/master:refs/heads/master\")\n+        archive = subprocess.run([\"git\", \"-C\", str(g.origin), \"archive\", g.base_commit],\n+                                 capture_output=True, check=True).stdout\n+        with tarfile.open(fileobj=io.BytesIO(archive)) as tar:\n+            tar.extractall(g.code, filter=\"data\")\n+        pending = g.w.acceptances(g.base_commit)\n+        prepared = []\n+\n+        def challenge(wt):\n+            prepared.append(T.challenge(g, wt))\n+\n+        g.codex.prepare = challenge\n+        lines = T.WAKER.tick(g.w, False)\n+        tip = T.branch_tip(g)\n+        want = f\".warrant/store/records/{prepared[0]}.json\"\n+        delivered = tip is not None and subprocess.run(\n+            [\"git\", \"-C\", str(g.origin), \"cat-file\", \"-e\", f\"{tip}:{want}\"],\n+            capture_output=True, check=False).returncode == 0\n+        held = {\"prior\": prior, \"still_due\": len(pending[\"due\"]), \"lines\": lines,\n+                \"tip\": tip, \"challenge_delivered\": delivered}\n+        check(\"F1\", fresh_refused and len(pending[\"due\"]) == 1 and delivered,\n+              \"an accept must bind the closure item's evidence before it counts as its published verdict; \"\n+              \"a nonbinding accept on master must not suppress a new valid verdict\",\n+              {\"fresh\": fresh, \"held\": held})\n+    finally:\n+        g.close()\n+\n+\n+def remote_bytes():\n+    f = T.verdict_world(forge=T.FakeForge(fail=1))\n+    try:\n+        f.codex.prepare = lambda wt: T.challenge(f, wt)\n+        first = T.WAKER.tick(f.w, False)\n+        memo = T.accept_memo(f)\n+        wt = Path(memo[\"attempts\"][-1][\"worktree\"])\n+        c = {\"closure\": f.t, \"item\": 0, \"duty\": f.duty}\n+        records, blobs = f.w.prepared(wt, c, f.code)\n+        rid = next(iter(records))\n+        path = f\".warrant/store/records/{rid}.json\"\n+        clone = f.base / \"remote-edit\"\n+        T.git(\"clone\", \"-q\", str(f.origin), str(clone))\n+        T.git(\"-C\", str(clone), \"checkout\", \"-q\", f.branch)\n+        (clone / path).write_text(\"{}\\n\")\n+        T.git(\"-C\", str(clone), \"add\", path)\n+        T.git(\"-C\", str(clone), \"commit\", \"-qm\", \"alter remote verdict bytes after a failed PR creation\")\n+        T.git(\"-C\", str(clone), \"push\", \"-q\", \"origin\", f\"HEAD:refs/heads/{f.branch}\")\n+        f.now[0] += T.WAKER.BACKOFF + 1\n+        retried = T.WAKER.tick(f.w, False)\n+        memo = T.accept_memo(f)\n+        check(\"F2\", not memo.get(\"published\") and not f.forge.opened and wt.exists(),\n+              \"an existing branch's filenames do not prove it contains the verified verdict bytes: \"\n+              \"a mismatch must refuse publication and preserve the prepared worktree\",\n+              {\"first\": first, \"retried\": retried, \"published\": memo.get(\"published\"),\n+               \"opened\": len(f.forge.opened), \"worktree_kept\": wt.exists(),\n+               \"record\": rid, \"blob_count\": len(blobs)})\n+    finally:\n+        f.close()\n+\n+\n+if __name__ == \"__main__\":\n+    evidence_binding()\n+    remote_bytes()\n+    raise SystemExit(finish(\"CODEX_WAKER_PUBLICATION_TEST\"))\n"},"tree":"834acbb7127606fc76c1a585df68782f4084804c","what":"Bind accepts to the closure item's exact evidence before marking publication done. An authentic accept with evidence=[] passes verification for a nonempty-evidence item and leaves it PENDING. If already on the base, the same nonbinding accept makes held_verdict suppress and discard a newly prepared valid challenge. Validate the evidence binding in both paths.","where":["integrations/codex-plugin/waker/waker.py:294","integrations/codex-plugin/waker/waker.py:314"]}
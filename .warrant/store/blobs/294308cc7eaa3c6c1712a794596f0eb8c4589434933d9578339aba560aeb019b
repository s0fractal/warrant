{"commit":"9e58df1fc2760ce04272808a4b2d8495efe9c499","duty":"8057c2a37f1cb29f08fded8f8684bebf4ac62c3c8791597a704653259e5281a5","head":"7a2f5af4c5af30f00300f3f8ebbd574a1868e7193b176a11197cf0c890741709","pr":204,"schema":"warrant-review/finding@1","severity":"P2","test":{"case":"LEGACY1","file":"replay_retry_legacy_test","patch":"diff --git a/tests/replay_retry_legacy_test.py b/tests/replay_retry_legacy_test.py\nnew file mode 100644\n--- /dev/null\n+++ b/tests/replay_retry_legacy_test.py\n@@ -0,0 +1,37 @@\n+\"\"\"An old waker's lost-push memo still owes the replay after upgrading.\"\"\"\n+import json\n+from review_replay_test import WAKER, at_commit, due, flaky, git, pr_world, tip\n+from world import check, finish\n+\n+\n+def main():\n+    f = pr_world()\n+    try:\n+        flaky(f, 0)\n+        # This is the memo shape and line the pre-#204 waker wrote when the\n+        # checker succeeded but the branch moved before it could push.\n+        old = {\"pr\": 1, \"head\": f.head, \"base\": f.start, \"pushed\": False,\n+               \"line\": \"replay not pushed: pr1 is at 0123456789ab, not \" + f.head[:12]}\n+        memo = f.w.home / \"replays\" / f\"{f.w.key(due(f))}.json\"\n+        memo.write_text(json.dumps(old))\n+        f.ok(\"accept\", \"--pr\", \"1\", \"--commit\", f.h2, actor=\"codex\")\n+        reviewed = f.save()\n+        git(\"-C\", str(f.dir), \"push\", \"-q\", str(f.origin), f\"{reviewed}:refs/heads/pr1\")\n+        git(\"-C\", str(f.w.mirror), \"fetch\", \"-q\", str(f.origin), \"+refs/heads/pr1:refs/heads/pr1\")\n+        f.w.due = lambda base: {\"due\": [], \"not_due\": [dict(\n+            due(f, tip(f)), head_repo=WAKER.REPO, not_due=[[\"REVIEWED\", \"accepted\"]])]}\n+        pending = f.w.pending(1)\n+        lines = WAKER.tick(f.w, False)\n+        observed = at_commit(f, tip(f)).findings[f.cid].observed\n+        check(\"LEGACY1\", pending and len(f.runs) == 1\n+              and sorted(observed) == sorted([f.h1, f.h2]),\n+              \"a legacy replay not pushed memo remains incomplete and retries after a verdict\",\n+              {\"pending_before\": pending, \"checker_runs\": len(f.runs),\n+               \"observed\": sorted(observed), \"tick\": lines})\n+    finally:\n+        f.close()\n+    return finish(\"REPLAY_RETRY_LEGACY_TEST\")\n+\n+\n+if __name__ == \"__main__\":\n+    raise SystemExit(main())\n"},"tree":"d1e6a3c207b354adb1f9df3cef5ce89e25f6e323","what":"Upgrading an old memo with line 'replay not pushed: ...' sets its attempt ok=True. After a verdict, pending() is false, so retry_lines never runs the checker and the branch retains no observations. This is the memo master wrote after a branch-tip race; migrate it as incomplete, like a checker failure.","where":["integrations/codex-plugin/waker/waker.py:195-197"]}
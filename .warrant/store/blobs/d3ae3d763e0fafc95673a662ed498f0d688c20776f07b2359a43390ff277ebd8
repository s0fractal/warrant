{"commit":"6e1d654fec74387cbb34ffc475d219fc6a740408","duty":"4820bb89ab8893ada9bd4708b49d600b503f3d46355bca6f59abd5a25bab8ba7","head":"7c3104fea1dc1a210d095878742338ed8390b8754a792baeaa7b8b6bc5975d0b","pr":211,"schema":"warrant-review/finding@1","severity":"P2","test":{"case":"F2","file":"codex_waker_publication_h4_test","patch":"diff --git a/tests/codex_waker_publication_h4_test.py b/tests/codex_waker_publication_h4_test.py\nnew file mode 100644\n--- /dev/null\n+++ b/tests/codex_waker_publication_h4_test.py\n@@ -0,0 +1,81 @@\n+#!/usr/bin/env python3\n+\"\"\"Publication retry counterexamples observed on #211 head 4, 6e1d654fec74.\n+\n+F1: master can acquire a byte-identical evidence blob while PR creation is down.\n+F2: byte-identical Git blobs can be symlinks rather than store files.\n+All forges and pushes are local fixtures; no operator signing key is used.\n+\"\"\"\n+from pathlib import Path\n+\n+import review_replay_test as T\n+from world import check, finish\n+\n+\n+def duplicate_blob_retry():\n+    f = T.verdict_world(forge=T.FakeForge(fail=1))\n+    try:\n+        f.codex.prepare = lambda wt: T.challenge(f, wt)\n+        first = T.WAKER.tick(f.w, False)\n+        old_tip = T.branch_tip(f)\n+        wt = Path(T.accept_memo(f)[\"attempts\"][-1][\"worktree\"])\n+        blobs = {str(p.relative_to(wt)): p.read_bytes()\n+                 for p in (wt / \".warrant/store/blobs\").iterdir()\n+                 if not (f.dir / p.relative_to(wt)).exists()}\n+        assert old_tip and len(blobs) == 1 and \"HTTP 502\" in first[-1]\n+        # Another master change reuses the same content-addressed evidence. Keep\n+        # the base archive in sync with the new commit, as Waker.tree does.\n+        for path, data in blobs.items():\n+            (f.dir / path).write_bytes(data)\n+            (f.code / path).write_bytes(data)\n+        moved = f.commit(\"another master change contains the same evidence blob\")\n+        T.git(\"-C\", str(f.dir), \"push\", \"-q\", str(f.origin), f\"{moved}:refs/heads/master\")\n+        T.git(\"-C\", str(f.w.mirror), \"fetch\", \"-q\", str(f.origin),\n+              \"+refs/heads/master:refs/heads/master\")\n+        f.w.fetch = lambda: moved\n+        f.now[0] += T.WAKER.BACKOFF + 1\n+        lines = T.WAKER.tick(f.w, False)\n+        check(\"F1\", len(f.forge.opened) == 1 and T.branch_tip(f) == old_tip\n+              and bool(T.accept_memo(f).get(\"published\")) and len(f.codex.calls) == 1,\n+              \"a PR-creation retry still publishes the original verdict when master acquired its identical blob\",\n+              lines[-1])\n+    finally:\n+        f.close()\n+\n+\n+def symlink_retry():\n+    f = T.verdict_world(forge=T.FakeForge(fail=1))\n+    try:\n+        f.codex.prepare = lambda wt: T.challenge(f, wt)\n+        T.WAKER.tick(f.w, False)\n+        wt = Path(T.accept_memo(f)[\"attempts\"][-1][\"worktree\"])\n+        clone = f.base / \"remote-edit\"\n+        T.git(\"clone\", \"-q\", str(f.origin), str(clone))\n+        T.git(\"-C\", str(clone), \"checkout\", \"-q\", f.branch)\n+        blob = next(p for p in (clone / \".warrant/store/blobs\").iterdir()\n+                    if not (f.dir / p.relative_to(clone)).exists())\n+        original = blob.read_bytes()\n+        blob.unlink()\n+        blob.symlink_to(original.decode())\n+        T.git(\"-C\", str(clone), \"add\", \"-A\")\n+        T.git(\"-C\", str(clone), \"commit\", \"-q\", \"--amend\", \"--no-edit\")\n+        T.git(\"-C\", str(clone), \"push\", \"-q\", \"-f\", \"origin\", f\"HEAD:refs/heads/{f.branch}\")\n+        path = str(blob.relative_to(clone))\n+        assert T.git(\"-C\", str(clone), \"ls-tree\", \"HEAD\", \"--\", path).startswith(\"120000 \")\n+        assert T.WAKER.git(\"-C\", str(clone), \"cat-file\", \"blob\", f\"HEAD:{path}\") == original\n+        f.now[0] += T.WAKER.BACKOFF + 1\n+        lines = T.WAKER.tick(f.w, False)\n+        check(\"F2\", not T.accept_memo(f).get(\"published\") and not f.forge.opened and wt.exists(),\n+              \"an existing branch with symlink evidence is refused even when its Git blob bytes match exactly\",\n+              lines[-1])\n+    finally:\n+        f.close()\n+\n+\n+def main():\n+    duplicate_blob_retry()\n+    symlink_retry()\n+    return finish(\"CODEX_WAKER_PUBLICATION_H4_TEST\")\n+\n+\n+if __name__ == \"__main__\":\n+    raise SystemExit(main())\n"},"tree":"67e43a114650f36d26110473625651ec7a99afe6","what":"Check regular-file modes at the fetched verdict tip, the still-open part of 25890f89f776. pushed_before() accepts symlink evidence (120000) whose link text equals the verified blob bytes. The retry opens its PR, marks publication done and deletes the good worktree, although Store.snapshot rejects that evidence as non-regular. Require regular store-entry modes as well as exact bytes.","where":["integrations/codex-plugin/waker/waker.py:943"]}
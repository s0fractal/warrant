{"commit":"9ba35c23a4bedded5b0c4674f83663bf15201b14","duty":"4820bb89ab8893ada9bd4708b49d600b503f3d46355bca6f59abd5a25bab8ba7","head":"a1ee6470c22069c4cf1120ddc547f69e5b90d3ec97ed4eedda51e86abab81960","pr":211,"schema":"warrant-review/finding@1","severity":"P3","test":{"case":"F2","file":"codex_waker_publication_h7_test","patch":"diff --git a/tests/codex_waker_publication_h7_test.py b/tests/codex_waker_publication_h7_test.py\nnew file mode 100644\n--- /dev/null\n+++ b/tests/codex_waker_publication_h7_test.py\n@@ -0,0 +1,91 @@\n+\"\"\"Countervectors for #211 head 7. Uses only fixture keys and a local origin.\"\"\"\n+from pathlib import Path\n+import subprocess\n+\n+from review_replay_test import (WAKER, FakeForge, accept_memo, branch_tip,\n+                                challenge, git, verdict_world)\n+from world import check, finish\n+\n+\n+class ClosedForge(FakeForge):\n+    def __init__(self):\n+        super().__init__()\n+        self.closed = False\n+\n+    def pulls(self, branch):\n+        return [(210, \"CLOSED\")] if self.closed else []\n+\n+\n+def unrelated_pr():\n+    forge = ClosedForge()\n+    f = verdict_world(forge=forge)\n+    # A closed PR from the expected branch exists, but its commit contains no\n+    # verdict. A branch name alone cannot establish delivery of a signed record.\n+    clone = f.base / \"unrelated-pr\"\n+    git(\"clone\", \"-q\", str(f.origin), str(clone))\n+    git(\"-C\", str(clone), \"checkout\", \"-qb\", f.branch, f.base_commit)\n+    (clone / \"unrelated.txt\").write_text(\"No codex verdict was filed here.\\n\")\n+    git(\"-C\", str(clone), \"add\", \"unrelated.txt\")\n+    git(\"-C\", str(clone), \"commit\", \"-qm\", \"not a verdict\")\n+    git(\"-C\", str(clone), \"push\", \"-q\", \"origin\", f\"HEAD:refs/heads/{f.branch}\")\n+    forge.closed = True\n+    mine = []\n+    f.codex.prepare = lambda wt: mine.append(challenge(f, wt))\n+    lines = WAKER.tick(f.w, False)\n+    memo = accept_memo(f)\n+    wt = Path(memo[\"attempts\"][-1][\"worktree\"])\n+    remote_has_verdict = bool(mine) and subprocess.run(\n+        [\"git\", \"-C\", str(f.origin), \"cat-file\", \"-e\",\n+         f\"{branch_tip(f)}:.warrant/store/records/{mine[0]}.json\"],\n+        capture_output=True, check=False).returncode == 0\n+    check(\"F1\", remote_has_verdict or (not memo.get(\"published\") and wt.exists()),\n+          \"an unrelated closed PR from the expected branch cannot mark a verdict published or delete its worktree\",\n+          {\"remote_has_verdict\": remote_has_verdict, \"published\": memo.get(\"published\"),\n+           \"worktree_exists\": wt.exists(), \"line\": lines[-1]})\n+    f.close()\n+\n+\n+\n+def courier_control():\n+    forge = ClosedForge()\n+    f = verdict_world(forge=forge)\n+    clone = f.base / \"courier-pr\"\n+    git(\"clone\", \"-q\", str(f.origin), str(clone))\n+    git(\"-C\", str(clone), \"checkout\", \"-qb\", f.branch, f.base_commit)\n+    rec = challenge(f, clone)\n+    git(\"-C\", str(clone), \"add\", \".warrant/store\")\n+    git(\"-C\", str(clone), \"commit\", \"-qm\", \"courier verdict\")\n+    git(\"-C\", str(clone), \"push\", \"-q\", \"origin\", f\"HEAD:refs/heads/{f.branch}\")\n+    forge.closed = True\n+    f.codex.prepare = lambda wt: challenge(f, wt)\n+    WAKER.tick(f.w, False)\n+    memo = accept_memo(f)\n+    wt = Path(memo[\"attempts\"][-1][\"worktree\"])\n+    check(\"CONTROL\", memo.get(\"published\", {}).get(\"pr\") == 210 and not wt.exists() and not forge.opened,\n+          \"an existing closed courier PR carrying an authentic verdict still counts without duplicate publication\",\n+          {\"record\": rec, \"published\": memo.get(\"published\")})\n+    f.close()\n+\n+\n+def commit_provenance():\n+    f = verdict_world()\n+    f.codex.prepare = lambda wt: challenge(f, wt)\n+    WAKER.tick(f.w, False)\n+    tip = branch_tip(f)\n+    msg = git(\"-C\", str(f.origin), \"show\", \"-s\", \"--format=%B\", tip)\n+    changed = git(\"-C\", str(f.origin), \"diff-tree\", \"-r\", \"--no-commit-id\", \"--name-only\", f.base_commit, tip).splitlines()\n+    check(\"F2\", \"regenerated\" not in msg,\n+          \"a records-only publication commit must not claim that the waker regenerated views\",\n+          {\"message\": msg, \"changed\": changed})\n+    f.close()\n+\n+\n+def main():\n+    unrelated_pr()\n+    courier_control()\n+    commit_provenance()\n+    return finish(\"CODEX_WAKER_PUBLICATION_H7_TEST\")\n+\n+\n+if __name__ == \"__main__\":\n+    raise SystemExit(main())\n"},"tree":"fe5deb98ba54aaf7e7adb83c487f3244db7b560b","what":"Remove the unperformed projector run from publication commit messages. After G11, _publish runs no projector, yet every records-only commit says the waker regenerated what the base generates with the base's own tools. F2 publishes locally and reads that false execution claim from git history.","where":["integrations/codex-plugin/waker/waker.py:924"]}
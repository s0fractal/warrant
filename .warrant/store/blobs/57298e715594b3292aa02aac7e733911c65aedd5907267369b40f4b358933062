{"commit":"17ea0667232c7cb03283f84ba33fdfac9efd2489","duty":"60897810079d735f51276009190b84bb6d444836ef201a835410d5c93773448c","head":"1d2e45e92cdd99b72bb8eae3d6737fa835b6fef8aa855f8990e227739479cb29","pr":190,"schema":"warrant-review/finding@1","severity":"P2","test":{"case":"RACE_BASE","file":"codex_gate_race_test","patch":"diff --git a/tests/codex_gate_race_test.py b/tests/codex_gate_race_test.py\nnew file mode 100644\n--- /dev/null\n+++ b/tests/codex_gate_race_test.py\n@@ -0,0 +1,31 @@\n+import json,os,sys\n+from pathlib import Path\n+root=Path(os.environ['WARRANT_IMPL'])\n+sys.path[:0]=[str(root),str(root/'tests'),str(root/'tools')]\n+import review_gate_test as T\n+from claimslib import gate as GT,eligibility as EL\n+f=T.world()\n+try:\n+ f.ok('accept','--pr','1','--commit',f.x,actor='codex')\n+ head=f.save(); b=EL.Base(f.dir,f.base_commit)\n+ a=EL.assess(f.dir,b,T.pr(head),T.checks(head))\n+ assert a.eligible,a.codes()\n+ class Changed(T.FakeGh):\n+  def __init__(self,change):super().__init__(head,f.base_commit);self.change=change\n+  def __call__(self,cmd,**kw):\n+   r=super().__call__(cmd,**kw)\n+   if any(x.endswith('/pulls/1') for x in cmd):\n+    doc=json.loads(r.stdout)\n+    if self.change=='base':doc['base']['ref']='release'\n+    elif self.change=='hold':doc['labels']=[{'name':'hold'}]\n+    r.stdout=json.dumps(doc).encode()\n+   return r\n+ results={}\n+ for change in ('unchanged','base','hold'):\n+  fake=Changed(change);m=GT.merge_one(b,a,GT.GitHub('s0fractal/warrant',run=fake))\n+  puts=[c for c in fake.calls if c[0]=='PUT']\n+  passed=(m['merged'] and len(puts)==1) if change=='unchanged' else (not m['merged'] and not puts)\n+  results['RACE_'+change.upper()]='PASS' if passed else 'FAIL'\n+  print(json.dumps({'case':change,'merged':m['merged'],'merge_requests':len(puts),'result':results['RACE_'+change.upper()]}))\n+ if os.environ.get('WARRANT_RESULTS'):Path(os.environ['WARRANT_RESULTS']).write_text(json.dumps(results))\n+finally:f.close()\n"},"tree":"b7f1bbc12d4ca4a61689c260a4e9a135e87469a9","what":"Before merging, revalidate the freshly read PR base and hold label: retargeting master to release or adding hold after assessment leaves the same head, so merge_one still issues PUT /merge despite the new facts.","where":["tools/claimslib/gate.py:144"]}
## Reproduce C1

With M's optional MCP dependencies installed, save the Python below as a probe outside the checkout and run `python -B delta_probe.py SOURCE_ROOT` with TMPDIR pointing into the review's work directory. Run it at M (exit 0), then in an isolated copy with C1's exact substitution (exit 1). On that copy, `python -B tests/agent_test.py` and `python -B tests/tools_test.py` remain green. C2 uses the separate exact substitution above and the same two suites. Both substitutions are independent, not combined.

```python
import asyncio, json, os, subprocess, sys
from pathlib import Path
root=Path(sys.argv[1]).resolve()
sys.path[:0]=[str(root/'tests'),str(root)]
from world import Repo
from warrant import graph as G
from warrant import repo as RP
from warrant import gate as GT
from warrant_agent import api
from warrant_agent.config import Config
from mcp import ClientSession
from mcp.client.stdio import StdioServerParameters,stdio_client
r=Repo(git_init=True)
o=r.entity('alice','obligation@1',{'state':'open','statement':'delta sentinel','serves':[]})
base=r.commit('open')
d=r.entity('alice','obligation@1',{'state':'done','statement':'delta sentinel','serves':[]},lineage=o)
r.attest('bob',d)
head=r.commit('accepted closure')
rng=f'{base}..{head}'
config={'agent_api':'warrant-agent/3','workspaces':{'w':{'repo':str(r.root),'signer':{'actor':'bob','key':str(r.seed('bob'))}}}}
cfg=Config(config)
reports=[RP.Repo(r.root).report(GT.store_at(r.root,c)[0]) for c in (base,head)]
assert [reports[0]['lineages'][o]['state'],reports[1]['lineages'][o]['state']]==['open','done']
lib=G.delta(*reports)['changed']
via=api.call(cfg,'graph',{'workspace':'w','op':'delta','range':rng})['ok']['data']['changed']
env=dict(os.environ,PYTHONPATH=str(root),PYTHONDONTWRITEBYTECODE='1')
cli=subprocess.run([sys.executable,'-B',str(root/'tools/graph.py'),'delta',rng],cwd=r.root,capture_output=True,text=True,env=env,check=True)
tool=json.loads(cli.stdout)['data']['changed']
path=r.home/'config.json';path.write_text(json.dumps(config))
async def mcp():
 params=StdioServerParameters(command=sys.executable,args=['-B','-m','warrant_agent.mcp_server','--config',str(path)],env=env,cwd=str(root))
 async with stdio_client(params) as (reader,writer):
  async with ClientSession(reader,writer) as session:
   await session.initialize()
   result=await session.call_tool('warrant_graph',{'workspace':'w','op':'delta','range':rng})
   assert not result.is_error,result
   return result.structured_content['data']['changed']
wire=asyncio.run(mcp())
print(json.dumps({'source':str(root),'lineage':o,'states':['open','done'],'expected_changed':[o],'library':lib,'api':via,'tools_cli':tool,'stdio_mcp':wire},sort_keys=True))
ok=all(x==[o] for x in (lib,via,tool,wire))
print(('ok   ' if ok else 'FAIL ')+'DELTA_CHANGED accepted open-to-done lineage is listed as changed through library, agent API, tools CLI and stdio MCP')
sys.exit(0 if ok else 1)
```

"""Unsigned counterexample at M; run with the checkout root as argv[1].

Only the checker's outcomes are injected. Waker.replay, replay_state, pending,
and wake_after_replay are the real implementations. No key is read or used.
"""
import importlib.util
import json
import sys
import tempfile
from pathlib import Path

root = Path(sys.argv[1]).resolve()
spec = importlib.util.spec_from_file_location("waker", root / "integrations/warrant-review/waker/waker.py")
W = importlib.util.module_from_spec(spec)
spec.loader.exec_module(W)


def scenario(skips):
    home = Path(tempfile.mkdtemp(prefix="skip-budget-"))
    (home / "replays").mkdir()
    w = object.__new__(W.Waker)
    w.home = home
    now = [100000]
    w.clock = lambda: now[0]
    w.tree = lambda base: root
    w.seed = lambda code: ("fixture-no-signer", object())
    w.cover = lambda a: None
    calls, wakes = [], []
    outcomes = ["skip"] * skips + ["fail", "success"]

    def injected(a, base, actor, unused):
        outcome = outcomes[len(calls)]
        calls.append(outcome)
        if outcome == "skip":
            raise W.Skipped("replay skipped: #4 changes the checker; it replays once adopted")
        if outcome == "fail":
            raise RuntimeError("the checker exited 75: injected transient failure")
        return False, "replay: nothing to replay"

    def wake(a, detail):
        wakes.append(detail)
        return False, "woken"

    w._replay, w.wake = injected, wake
    a = {"pr": 4, "head": "d" * 40, "branch": "topic"}
    states = []
    for i in range(skips):
        base = format(i + 1, "040x")
        w.replay(a, base)
        _, memo = w.replay_memo(a)
        states.append(w.replay_state(memo, base)[0])
    base = "c" * 40  # the checker has now been adopted
    w.replay(a, base)
    _, memo = w.replay_memo(a)
    after_failure = w.replay_state(memo, base)
    pending_after_failure = w.pending(4, base)
    W.wake_after_replay(w, a)
    now[0] += 100 * W.BACKOFF  # beyond even an incorrectly enlarged backoff
    w.replay(a, base)
    _, memo = w.replay_memo(a)
    return {"skip_states": states, "checker_outcomes": calls,
            "after_failure": after_failure, "pending_after_failure": pending_after_failure,
            "after_backoff": w.replay_state(memo, base), "wake_gaps": wakes}


control, skipped = scenario(0), scenario(2)
print("control:", json.dumps(control, sort_keys=True))
print("two_skips:", json.dumps(skipped, sort_keys=True))
control_ok = (control["checker_outcomes"] == ["fail", "success"]
              and control["after_failure"][0] == "waiting"
              and control["pending_after_failure"] and control["wake_gaps"] == []
              and control["after_backoff"][0] == "done")
print(("ok   " if control_ok else "FAIL ") + "C1 no-skip transient failure retries successfully")
retry_ok = (skipped["checker_outcomes"] == ["skip", "skip", "fail", "success"]
            and skipped["pending_after_failure"] and skipped["wake_gaps"] == []
            and skipped["after_backoff"][0] == "done")
print(("ok   " if retry_ok else "FAIL ") + "F1 skipped runs must not exhaust the checker failure budget")
sys.exit(0 if control_ok and retry_ok else 1)

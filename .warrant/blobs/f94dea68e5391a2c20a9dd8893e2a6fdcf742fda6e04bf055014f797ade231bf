Reproduction, run at either M or its isolated mutated copy (Python with the repository dependencies; put TMPDIR in a scratch directory outside the checkout):

import importlib.util, sys
from pathlib import Path
sys.path.insert(0, str(Path.cwd() / "tests"))
from world import Repo
from warrant.repo import Repo as Repository
from warrant_agent.api import call
from warrant_agent.config import Config
spec = importlib.util.spec_from_file_location("graph_tool", "tools/graph.py")
tool = importlib.util.module_from_spec(spec)
spec.loader.exec_module(tool)
r = Repo(git_init=True)
o = r.entity("alice", "obligation@1", {"state": "open", "statement": "delta removal witness", "serves": []})
base = r.commit("base")
v = r.entity("alice", "obligation@1", {"state": "done", "statement": "delta removal witness", "serves": []}, lineage=o)
head = r.commit("pending successor added")
rng = head + ".." + base
_, _, _, data = tool.ask(Repository(r.root), "delta", [rng])
assert data["removed"] == [v], ("CLI delta lost removed record", v, data)
cfg = Config({"agent_api": "warrant-agent/3", "workspaces": {"w": {"repo": str(r.root), "signer": None, "operations": ["graph"]}}})
result = call(cfg, "graph", {"workspace": "w", "op": "delta", "range": rng})
assert result["ok"]["data"]["removed"] == [v], ("agent delta lost removed record", v, result)
print("ok removal witness: both interfaces name the absent version")

This assertion passes on M and fails on the one-line mutant. Add a regression asserting the exact removed id independently through the graph interfaces, and register the above mutant with that case. No production fix is needed for this counterexample. Until a check kills this mutant, the obligation's each-property mutation condition is not established.


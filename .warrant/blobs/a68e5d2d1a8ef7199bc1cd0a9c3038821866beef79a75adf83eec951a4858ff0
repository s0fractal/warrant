result collision was reproduced.\nOnly a new ignored probe file is briefly created in the checkout, then removed.\nFixture stores and generated fixture keys remain outside the checkout.\n\"\"\"\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path\nimport shutil\nimport subprocess\nimport sys\nimport tempfile\n\nrepo = Path(sys.argv[1]).resolve()\nscratch = Path(__file__).resolve().parent / \"tmp\"\nscratch.mkdir(exist_ok=True)\ntempfile.tempdir = str(scratch)\nos.environ[\"TMPDIR\"] = str(scratch)\nos.environ[\"PYTHONDONTWRITEBYTECODE\"] = \"1\"\nsys.dont_write_bytecode = True\n\n\ndef git(*args):\n    return subprocess.run([\"git\", \"-C\", str(repo), *args], check=True,\n                          capture_output=True, text=True).stdout.strip()\n\n\ndef sha(data):\n    return hashlib.sha256(data).hexdigest()\n\n\ndef ignored_source():\n    parent = repo / \"tools\" / \"scratchpad\"\n    made_parent = not parent.exists()\n    parent.mkdir(exist_ok=True)\n    p = parent / \"g11_identity_counterexample.py\"\n    if p.exists():\n        raise RuntimeError(\"refusing to overwrite an existing probe\")\n    rows = []\n    try:\n        for n in (1, 2):\n            p.write_text(f\"answer = {n}\\n\")\n            git(\"check-ignore\", str(p))\n            r = subprocess.run([sys.executable, str(repo / \"tools/graph.py\"),\n                                \"--root\", str(repo), \"why\",\n                                \"tools/scratchpad/g11_identity_counterexample.py:1\", \"--json\"],\n                               check=True, capture_output=True,\n                               env=dict(os.environ, PYTHONPATH=str(repo)))\n            d = json.loads(r.stdout)\n            rows.append({\"source\": d[\"source\"], \"root\": d[\"root\"], \"lens\": d[\"lens\"],\n                         \"stdout_sha256\": sha(r.stdout)})\n    finally:\n        p.unlink(missing_ok=True)\n        if made_parent:\n            parent.rmdir()\n    collision = rows[0][\"root\"] == rows[1][\"root\"] and rows[0][\"lens\"] == rows[1][\"lens\"]\n    collision = collision and rows[0][\"stdout_sha256\"] != rows[1][\"stdout_sha256\"]\n    return {\"name\": \"ignored source read by why\", \"collision\": collision, \"results\": rows}\n\n\ndef page_parameters():\n    sys.path.insert(0, str(repo / \"tests\"))\n    from graph_test import goal_world, op\n    w = goal_world()\n    src = w[\"src\"]\n    rows = []\n    try:\n        req = {\"op\": \"path\", \"target\": \"roadmap:G1\", \"view_token\": w[\"tok1\"]}\n        for budget in (256, 100000):\n            response = op(src, dict(req, max_bytes=budget))\n            d = response[\"ok\"][\"data\"]\n            rows.append({\"max_bytes\": budget, \"root\": d[\"root\"], \"lens\": d[\"lens\"],\n                         \"items\": len(d[\"items\"]),\n                         \"data_sha256\": sha(json.dumps(d, sort_keys=True).encode())})\n        first = op(src, dict(req, max_bytes=256))[\"ok\"]\n        cursor = first[\"page\"][\"cursor\"]\n        next_page = op(src, dict(req, max_bytes=256, cursor=cursor))[\"ok\"][\"data\"]\n        initial = first[\"data\"]\n        cursor_collision = initial[\"root\"] == next_page[\"root\"] and initial[\"lens\"] == next_page[\"lens\"]\n        cursor_collision = cursor_collision and initial[\"items\"] != next_page[\"items\"]\n    finally:\n        shutil.rmtree(src.base.parent)\n    collision = rows[0][\"root\"] == rows[1][\"root\"] and rows[0][\"lens\"] == rows[1][\"lens\"]\n    collision = collision and rows[0][\"data_sha256\"] != rows[1][\"data_sha256\"]\n    return {\"name\": \"page budget and cursor omitted from lens\", \"collision\": collision,\n            \"cursor_collision\": cursor_collision, \"results\": rows}\n\n\nout = {\"head\": git(\"rev-parse\", \"HEAD\"),\n       \"expected\": \"Identical root and lens imply identical result bytes, including all deciding parameters.\",\n       \"counterexamples\": [ignored_source(), page_parameters()]}\nprint(json.dumps(out, indent=1, sort_keys=True))\nraise SystemExit(1 if any(x[\"collision\"] for x in out[\"counterexamples\"]) else 0)\n"},"reviewed_master":"08c78b178b8e665ff39d250e35c7e557917e5dbe","subject_binding":{"basis":"git blob IDs are identical at the closure subject and reviewed master for all relevant files","git_blobs":{".gitignore":"530b4d4375e8e49191e749df88372731513e5032","tools/claimslib/why.py":"9e4d78bb8d7f896f728e728d60cbb4f6e3133ba7","tools/graph.py":"88787bcd01f6bec3f03e13b00de816295a9187c8","warrant_agent/api.py":"68123befe8e96d1c19da91e125c747e63ef615f7","warrant_agent/graph.py":"c01fa57a3fa31d47751356131040236dba78ff0b"}}}
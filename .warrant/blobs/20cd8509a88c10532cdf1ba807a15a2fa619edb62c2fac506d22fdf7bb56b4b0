## Reproduction

Run the following outside the checkout with its path as the argument and TMPDIR
set to this review's external scratch directory; use PYTHONDONTWRITEBYTECODE=1.
The expected defect line is FAIL F2; F1 confirms that disclosure now works.

```python
"""Unsigned probe of per-head replay coverage at the reviewed checkout.

Fixture input records use public, deterministic tests/world.py identities.
No checker seed is read; a public-only object and intercepted file method
collect unsigned candidate replay records instead of signing or storing them.
"""
import contextlib
import importlib.util
import io
import json
import sys
from pathlib import Path
from types import SimpleNamespace

ROOT = Path(sys.argv[1]).resolve()
sys.path[:0] = [str(ROOT), str(ROOT / 'tests')]
from world import Repo, KEYS, git
from warrant import review as RV
from warrant import repo as RP

r = Repo(git_init=True)
(r.root / 'tests').mkdir()
(r.root / 'code.py').write_text('X = 1\n')
x1 = r.commit('first code head')
d = r.entity('alice', 'pr-head@1', {'state': 'open', 'repository': 's0fractal/warrant',
                                  'pr': 7, 'title': 'fixture', 'serves': []})
h1 = r.entity('alice', 'pr-head@1', {'state': 'head', 'commit': x1,
    'tree': git(r.root, 'rev-parse', x1 + '^{tree}')}, lineage=d)
patch = '''diff --git a/tests/head_coverage_test.py b/tests/head_coverage_test.py
new file mode 100644
--- /dev/null
+++ b/tests/head_coverage_test.py
@@ -0,0 +1,4 @@
+import sys
+sys.path.insert(0, ".")
+import code
+print(("FAIL " if code.X == 1 else "ok   ") + "F1 X must be two")
'''
f = r.put('bob', 'challenge', {'target': h1, 'statement': 'P2 X must be two',
    'severity': 'P2', 'what': 'fixture defect', 'where': ['code.py:1'], 'commit': x1,
    'tree': git(r.root, 'rev-parse', x1 + '^{tree}'),
    'test': {'file': 'head_coverage_test', 'case': 'F1', 'patch': patch}}, 'finding@1', refs=[h1])
(r.root / 'code.py').write_text('X = 2\n')
x2 = r.commit('fix in second head')
h2 = r.entity('alice', 'pr-head@1', {'state': 'head', 'commit': x2,
    'tree': git(r.root, 'rev-parse', x2 + '^{tree}')}, lineage=h1)
r.trust['keys'][RV.REPLAYER] = [KEYS['dave'].public]
r.profile['roles']['replayer'].append(RV.REPLAYER)
r.write_config()
tip = r.commit('second head version')
rp = RP.Repo(r.root)
rep = rp.report()
expected = [h for c, h, _ in RV.to_replay(rep, {RV.REPLAYER, 'carol'}) if c == f]
collected = []

def collect(actor, unused_signer, records):
    assert actor == RV.REPLAYER
    collected.extend(records)
    return ['0' * 64 for _ in records]

rp.file = collect
public_only = SimpleNamespace(public=KEYS['dave'].public)
first = io.StringIO()
with contextlib.redirect_stdout(first):
    RV.replay(rp, public_only)
assert len(collected) == 1
rep['_recs']['0' * 64] = collected[0]
rp.report = lambda: rep  # model publication of the first unsigned candidate in memory only
second = io.StringIO()
with contextlib.redirect_stdout(second):
    RV.replay(rp, public_only)
remaining = [h for c, h, _ in RV.to_replay(rep, {RV.REPLAYER, 'carol'}) if c == f]

# Independent unsigned controls on each code version.
git(r.root, 'checkout', '--quiet', x1, '--', 'code.py')
old_verdict = RV.run_test(r.root, 'head_coverage_test', 'F1', patch)
git(r.root, 'checkout', '--quiet', tip, '--', 'code.py')
new_verdict = RV.run_test(r.root, 'head_coverage_test', 'F1', patch)

spec = importlib.util.spec_from_file_location('coverage_waker',
    ROOT / 'integrations/warrant-review/waker/waker.py')
W = importlib.util.module_from_spec(spec)
spec.loader.exec_module(W)
w = object.__new__(W.Waker)
w.home = r.home / 'memo'
(w.home / 'replays').mkdir(parents=True)
w.repository = 's0fractal/warrant'
w.clock = lambda: 100
w.tree = lambda base: 'fixture-code'
w.seed = lambda tree: ('review-replayer', b'not used')
old_memo = w.home / 'replays' / ('7-' + x1 + '.json')
old_memo.write_text(json.dumps({'pr': 7, 'head': x1, 'attempts': [
    {'ok': False, 'finished': 0, 'line': 'replay failed: exit 75'}]}))

# Feed actual runner output through unobserved and the waker's replay state
# machine. Publication is simulated; no network, jail, or checker signing.
def first_publication(*args):
    w.denied = W.unobserved(first.getvalue().splitlines())
    return True, 'replay: one unsigned candidate (publication simulated)'

w._replay = first_publication
w.replay({'pr': 7, 'head': tip}, 'b' * 40)
first_old = json.loads(old_memo.read_text())

def second_publication(*args):
    w.denied = W.unobserved(second.getvalue().splitlines())
    return False, 'replay: nothing to replay' + W._denied_note(w.denied)

w._replay = second_publication
w.clock = lambda: 200
next_tip = 'f' * 40
w.replay({'pr': 7, 'head': next_tip}, 'b' * 40)
gaps = []
w.wake = lambda a, gap: (gaps.append(gap), 'woken')
W.wake_after_replay(w, {'pr': 7, 'head': next_tip})
observed = [v['body']['on'] for v in collected]
out = {'master': git(ROOT, 'rev-parse', 'HEAD'),
    'expected_head_versions': expected, 'observed_head_versions': observed,
    'still_due_after_successful_runs': remaining,
    'original_head_control': old_verdict, 'fixed_head_control': new_verdict,
    'first_runner_stdout': first.getvalue(), 'second_runner_stdout': second.getvalue(),
    'old_failed_memo_covered_by': first_old.get('covered_by'),
    'old_failed_memo_marked_partial_initially': first_old.get('covered_partially'),
    'waker_pending': w.pending(7, 'b' * 40), 'reviewer_gaps': gaps,
    'signed_replay_records': 0}
print(json.dumps(out, indent=2))
assert expected == [h1, h2] and observed == [h2] and remaining == [h1]
assert old_verdict == 'reproduces' and new_verdict == 'does_not_reproduce'
assert first_old.get('covered_by') == tip and not w.pending(7, 'b' * 40)
assert len(gaps) == 1 and f[:12] in gaps[0]
print('ok   F1 missing old-head replay is disclosed at the subsequent wake')
print('FAIL F2 D still owes replay at each head: original reproducing head remains unobserved and due')

```


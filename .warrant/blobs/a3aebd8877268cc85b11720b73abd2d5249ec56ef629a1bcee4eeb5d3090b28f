"""Run: TMPDIR=<review-work-dir> python3 reproduce.py <checkout-at-M>.

Uses deterministic TEST FIXTURE keys only, never an operator/checker seed.
FAIL F1/F2 is the observed defect at M; the assertion expects the format rule.
"""
import json
import subprocess
import sys
from pathlib import Path

ROOT = Path(sys.argv[1]).resolve()
sys.path[:0] = [str(ROOT / "tests"), str(ROOT)]
import tools_test as TT
from warrant import claims as C, drift as D, repo as RP, verify as V
from warrant_agent import api
from warrant_agent.config import Config


def read(r, lineage, target):
    rep = RP.Repo(r.root).report()
    assert not rep["rejected"] and not rep["problems"]
    covered = lineage in D.covered(rep)
    D.not_checked(rep)
    for k, value in (("trust", r.trust), ("profile", r.profile)):
        (r.root / f"{k}.json").write_text(json.dumps(value))
    cfg = Config({"agent_api": "warrant-agent/3", "workspaces": {"w": {
        "store": str(r.dot), "trust": str(r.root / "trust.json"),
        "profile": str(r.root / "profile.json"), "operations": ["context"]}}})
    context = api.call(cfg, "context", {"workspace": "w", "targets": [target]})
    context_rel = context["ok"]["targets"][target]["lineage"]["reliance"]
    package = {"warrant": V.PACKAGE, "lines": [x.decode().strip() for x in r.store.snapshot().raw],
               "blobs": {}, "roots": [target]}
    path = r.root / "package.json"
    path.write_text(json.dumps(package))
    answer = V.verify(path.read_bytes(), r.trust, r.profile)
    proc = subprocess.run([sys.executable, "-I", "-S", str(ROOT / "warrant_verify.py"),
                           str(path), "--config", str(r.dot / "v3.json")], capture_output=True, text=True)
    standalone = json.loads(proc.stdout)
    cli = subprocess.run([sys.executable, "-m", "warrant", "verify", str(path),
                          "--config", str(r.dot / "v3.json")], cwd=ROOT, capture_output=True, text=True)
    cli_ans = json.loads(cli.stdout)
    assert cli_ans["roots"][target]["lineage"]["reliance"] == answer["roots"][target]["lineage"]["reliance"]
    assert cli_ans["rely"] == answer["rely"] and cli.returncode == (0 if answer["rely"] else 1)
    return {"covered": covered, "drift": rep["lineages"][lineage]["reliance"], "context": context_rel,
            "verify": answer["roots"][target]["lineage"]["reliance"], "verify_rely": answer["rely"],
            "verify_pins": answer["roots"][target]["pins"]["verdict"],
            "standalone": standalone["roots"][target]["lineage"]["reliance"],
            "standalone_rely": standalone["rely"], "standalone_exit": proc.returncode,
            "cli_exit": cli.returncode}


failures = 0
for case, with_files in (("F1", True), ("F2", False)):
    r = TT.checker_repo()
    body = {"state": "open", "statement": "pin predicate boundary", "serves": []}
    lineage = r.entity("alice", "obligation@1", body)
    target = r.entity("alice", "obligation@1", dict(body, state="done"), lineage=lineage)
    r.attest("bob", target)
    control = read(r, lineage, target)
    assert not control["covered"] and control["context"] == control["verify"] == control["standalone"] == "ELIGIBLE"
    assert control["verify_rely"] and control["standalone_rely"] and control["standalone_exit"] == 0
    pin = {"target": target, "verdict": "accept", "commit": "ab" * 20}
    if with_files:
        pin.update(files={"x.py": "cd" * 20}, closure=C.CLOSURE)
    # The fixture binds this actor's TEST key and claim/verifier role, but this
    # obligation's guard names roadmap/acceptor. No checker role is invented.
    TT.put_as(r, C.CHECKER, pin, [target])
    got = read(r, lineage, target)
    assert got["covered"] and got["drift"] == got["context"] == "PINS_NOT_CHECKED"
    holds = got["verify"] == got["standalone"] == "PINS_NOT_CHECKED" and not got["verify_rely"] and not got["standalone_rely"]
    print(("ok   " if holds else "FAIL ") + case + " " + json.dumps(got, sort_keys=True))
    failures += not holds

# Positive control: a normal checker-accepted claim is read conservatively.
r = TT.checker_repo()
claim = TT.claim(r)
TT.put_as(r, C.CHECKER, {"target": claim, "verdict": "accept", "commit": "ab" * 20}, [claim])
positive = read(r, claim, claim)
assert positive["covered"] and positive["context"] == positive["verify"] == positive["standalone"] == "PINS_NOT_CHECKED"
assert not positive["verify_rely"] and not positive["standalone_rely"] and positive["standalone_exit"] == 1
print("ok   C1 counted checker legacy acceptance " + json.dumps(positive, sort_keys=True))
sys.exit(1 if failures else 0)


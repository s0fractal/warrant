from world import Repo
from warrant import across as A, gate as GT, home as H, resolve as RS

r = Repo()
r.put("alice", "schema", GT.RULES_SCHEMA)
genesis = r.put("bob", "entity", dict(json.loads((r.dot / "v3.json").read_text()), state="in force"), GT.RULES)
missing = "ab" * 32
r.entity("alice", "goal@1", {"state": "open", "key": "Q1", "text": "one citation"}, refs=[missing])
one = H.add_repository(H.empty(), str(r.root), "first")
mirror = Repo()
shutil.copytree(r.dot, mirror.dot, dirs_exist_ok=True)
assert r.store.snapshot().digest == mirror.store.snapshot().digest
two = H.add_repository(one, str(mirror.root), "second")
assert H.problem(two) is None

single = RS.answer(one)
duplicate = RS.answer(two)
across = A.answer(A.home_readings(two), {"query": "stores"})
home = H.listing(two)
result = {
    "genesis": genesis,
    "home": [{k: row[k] for k in ("name", "identity", "same")} for row in home],
    "resolve_single_counts": single["counts"],
    "resolve_duplicate_counts": duplicate["counts"],
    "resolve_duplicate_identities": duplicate["identities"],
    "resolve_duplicate_missing_rows": [row for row in duplicate["rows"] if row["id"] == missing],
    "across_store_keys": [{k: row[k] for k in ("store", "identity")} for row in across["stores"]],
}
assert all(row["identity"] == genesis for row in home)
assert duplicate["counts"]["MISSING"] == 2 * single["counts"]["MISSING"] == 2
assert [row["store"] for row in across["stores"]] == ["first", "second"]
assert all(row["identity"] == genesis for row in across["stores"])
print(json.dumps(result, indent=2))
print("REPRODUCED: Home identifies one store; resolve counts its one missing citation twice and across keeps alias store keys.")

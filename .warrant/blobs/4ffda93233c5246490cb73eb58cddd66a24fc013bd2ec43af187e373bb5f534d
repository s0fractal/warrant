## Required resolution

Preserve unobserved finding/head pairs as a named gap through the checker-to-waker boundary. Such a run must not silently report nothing to replay, count as full coverage of older failures, or wake a reviewer without that gap. Retry where useful, or explicitly retain and disclose sandbox refusals; add a regression that exercises the checker output together with completion, covering and wake decisions. This review changes no implementation or tests.

## Standalone unsigned probe

```python
"""Unsigned probe at M; no seed is read and no checker command runs."""
import importlib.util
import json
import subprocess
import sys
import tempfile
from pathlib import Path
root = Path(sys.argv[1]).resolve()
sys.path.insert(0, str(root))
from warrant.review import run_test, DENIED
spec = importlib.util.spec_from_file_location('waker_probe', root/'integrations/warrant-review/waker/waker.py')
W = importlib.util.module_from_spec(spec)
spec.loader.exec_module(W)
with tempfile.TemporaryDirectory() as td:
    home = Path(td)
    fixture = home/'fixture'
    (fixture/'tests').mkdir(parents=True)
    subprocess.run(['git','init','-q',str(fixture)],check=True)
    patch = '''diff --git a/tests/denied_test.py b/tests/denied_test.py
new file mode 100644
--- /dev/null
+++ b/tests/denied_test.py
@@ -0,0 +1 @@
+raise PermissionError(1, 'Operation not permitted')
'''
    verdict = run_test(fixture, 'denied_test', 'F1', patch)
    assert verdict == DENIED, verdict
    # review.replay's DENIED branch prints this and continues without an attest;
    # the command returns zero (covered by the existing R08b regression case).
    stdout = b'not run cccccccccccc on dddddddddddd: the jail denied what its test needs (no observation)\n'
    w = object.__new__(W.Waker)
    w.home = home
    w.repository = 's0fractal/warrant'
    w.replayers = home/'no-seeds'
    w.clock = lambda: 10000
    w.replay_python = sys.executable
    (home/'replays').mkdir()
    a = {'pr':4,'head':'b'*40,'branch':'topic'}
    base = 'a'*40
    old = {'pr':4,'head':'c'*40,'base':base,'attempts':[{'finished':0,'ok':False,'line':'replay failed: checker exited 75'}]}
    oldpath = home/'replays'/f"4-{'c'*40}.json"
    oldpath.write_text(json.dumps(old))
    w.tree = lambda base: fixture
    # Inject only the checker transport, with the real checker's DENIED output.
    # No key or signature is used; these bytes never reach a subprocess.
    w.seed = lambda code: ('review-replayer', b'unused transport placeholder')
    w.jail = lambda *args, **kwargs: subprocess.CompletedProcess([],0,stdout,b'')
    W.git = lambda *args: str(fixture/'.git').encode()
    w._replay = lambda a,base,actor,seed: w._file(a,base,actor,seed,fixture,home,'topic')
    wake_args = []
    w.wake = lambda a,incomplete=None: (wake_args.append(incomplete), 'woken')
    pushed,line = w.replay(a,base)
    _,memo = w.replay_memo(a)
    wake = W.wake_after_replay(w,a)
    result = {
        'run_test':verdict,
        'checker_exit':0,
        'checker_attests':0,
        'waker_line':line,
        'current_state':w.replay_state(memo,base)[0],
        'old_state':w.replay_state(json.loads(oldpath.read_text()),base)[0],
        'pending':w.pending(4,base),
        'wake':wake,
        'incomplete_passed_to_reviewer':wake_args,
    }
    print(json.dumps(result,indent=1))
    assert result['waker_line']=='replay: nothing to replay'
    assert result['current_state']=='done' and result['old_state']=='done'
    assert result['pending'] is False and wake_args==[None]
    print('REPRODUCED: a denied test with no observation is called complete, covers an older failure, and wakes without the gap')
    # Control: a genuine nonzero checker exit still waits and withholds the wake.
    a2 = {'pr':5,'head':'e'*40,'branch':'topic'}
    wake_args.clear()
    w.jail = lambda *args, **kwargs: subprocess.CompletedProcess([],75,b'',b'transient failure')
    _, failure = w.replay(a2,base)
    _, failed_memo = w.replay_memo(a2)
    withheld = W.wake_after_replay(w,a2)
    assert w.replay_state(failed_memo,base)[0] == 'waiting'
    assert withheld == 'not woken: the replay is incomplete' and wake_args == []
    print('CONTROL: exit 75 -> waiting; reviewer not woken')

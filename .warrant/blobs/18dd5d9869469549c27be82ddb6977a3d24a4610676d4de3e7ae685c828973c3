import json
import inspect
import sys
from pathlib import Path
subject = Path(__file__).parent / 'subject'
sys.path[:0] = [str(subject / 'tests'), str(subject)]
import circle_test as C
if '--control' in sys.argv:
    source = inspect.getsource(C.CL.ledger)
    source = source.replace('revalidated = {x for r in recs.values()', 'revalidated = {(x, m["duty"]) for r in recs.values()')
    source = source.replace('b["transition"] in revalidated:', '(b["transition"], recs[b["transition"]]["body"]["closes"][b["item"]]["duty"]) in revalidated:')
    exec(source, C.CL.__dict__)
f = C.Fix()
try:
    R = C.R
    duties = [f.file('claude', 'duty', R.duty('claude', name, ['s0fractal'], {'attest': {}}, accept_by=['codex'])) for name in ('first', 'second')]
    ev = f.store.put_blob(b'original evidence')
    original = f.file('claude', 'transition', R.transition('ATTESTED', [ev], closes=[R.item(d, 'discharge', [ev]) for d in duties]))
    accepted = f.file('codex', 'accept', R.accept(original, 1, [ev]))
    challenge = f.file('s0fractal', 'challenge', R.challenge(original, 'second closure is challenged', [], 1))
    rows_before = C.CL.ledger(f.model(), {}, f.repo.bindings()[0])
    new_ev = f.store.put_blob(b'new evidence for first closure only')
    successor = f.file('claude', 'transition', R.transition('ATTESTED', [new_ev], closes=[R.item(duties[0], 'revalidate', [new_ev], revalidates=[original])]))
    m = f.model()
    rows_after = C.CL.ledger(m, {}, f.repo.bindings()[0])
    result = {'accepted_item': 1, 'challenged_item': 1, 'revalidated_duty_item': 0,
              'refuted_before': rows_before['codex']['refuted'], 'refuted_after': rows_after['codex']['refuted'],
              'model_problems': m.problems,
              'revalidation_closes': m.recs[successor]['body']['closes'],
              'unrevalidated_duty': duties[1]}
    print(json.dumps(result, indent=2))
    assert not m.problems
    assert not rows_before['codex']['refuted']
    if any(x[0] == accepted for x in rows_after['codex']['refuted']):
        print('FAIL F1 revalidating item 0 falsely refutes codex acceptance of item 1; expected no refuted acceptance')
        sys.exit(1)
    print('ok F1 unrelated item revalidation leaves the challenged acceptance unrefuted')
finally:
    f.close()

## Reproduction used

The script below was run outside the review worktree against a disposable clone. Its finally block restores both files. To repeat elsewhere, change base to a review working directory, create `base/subject` as a local clone checked out at M, and run with Python >=3.11 and cryptography installed. It writes only in that review working directory and disposable clone.

```python
import hashlib, json, os, subprocess
from pathlib import Path

base = Path('/Users/s0fractal/.warrant/work/codex/a3f780c834d2')
repo = base / 'subject'
script = repo / 'tools/graph.py'
cfg = repo / '.warrant/claims.json'
original_script, original_cfg = script.read_bytes(), cfg.read_bytes()

def views(label):
    r = subprocess.run(['python3', '-B', 'tools/graph.py', 'views-json'], cwd=repo, capture_output=True, check=True,
                       env=dict(os.environ, PYTHONDONTWRITEBYTECODE='1'))
    (base / (label + '.json')).write_bytes(r.stdout)
    return json.loads(r.stdout)

def compare(label, a, b, name):
    av, bv = a[name], b[name]
    ai, bi = av.splitlines()[2], bv.splitlines()[2]
    out = {'case': label, 'view': name, 'same_identity': ai == bi, 'different_bytes': av != bv,
           'identity': ai, 'before_sha256': hashlib.sha256(av.encode()).hexdigest(),
           'after_sha256': hashlib.sha256(bv.encode()).hexdigest(),
           'before_only': [x for x in av.splitlines() if x not in bv.splitlines()][:4],
           'after_only': [x for x in bv.splitlines() if x not in av.splitlines()][:4]}
    print(json.dumps(out, sort_keys=True), flush=True)
    return out

try:
    a = views('baseline')
    doc = json.loads(original_cfg)
    doc['retired'].append('docs/HISTORY.md')
    cfg.write_text(json.dumps(doc))
    b = views('config-change')
    result1 = compare('claims_configuration_not_bound', a, b, 'CLAIMS.md')
    cfg.write_bytes(original_cfg)
    for variant in ('A', 'B'):
        script.write_bytes(original_script.replace(b'out = ["# Witness ledger",',
                           ('out = ["# Witness ledger variant ' + variant + '",').encode()))
        assert script.read_bytes() != original_script
        if variant == 'A':
            a = views('code-A')
        else:
            b = views('code-B')
    result2 = compare('deciding_tool_bytes_not_bound', a, b, 'WITNESSES.md')
    (base / 'counterexamples.json').write_text(json.dumps([result1, result2], indent=2))
    assert all(x['same_identity'] and x['different_bytes'] for x in [result1, result2])
finally:
    cfg.write_bytes(original_cfg)
    script.write_bytes(original_script)

```


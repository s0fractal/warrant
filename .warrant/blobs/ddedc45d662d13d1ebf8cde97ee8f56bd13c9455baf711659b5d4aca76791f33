## Reproduction

Save the following as reproduce.py outside the checkout. Run with a Python with
cryptography installed: `python3 reproduce.py /path/to/checkout /path/to/fixture-dir`.
It imports the target checkout's existing signed fixtures, builds the dependency chain,
checks that its records are admitted, and invokes the ordinary CLI with and without
--across. Its assertions expect the defect to reproduce. The fixture directory is
owned by this test; Home configuration writes stay there.

```python
import contextlib, io, json, os, pathlib, sys, tempfile
ROOT=pathlib.Path(sys.argv[1]).resolve() if len(sys.argv)>1 else pathlib.Path.cwd()
WORK=pathlib.Path(sys.argv[2]).resolve() if len(sys.argv)>2 else pathlib.Path('/Users/s0fractal/.warrant/work/codex/d67f45554a6c/fixtures')
WORK.mkdir(parents=True,exist_ok=True)
tempfile.tempdir=str(WORK)
sys.path.insert(0,str(ROOT/'tests'))
import tools_test as t
from warrant import graph as G, records as R, engine as E
from world import KEYS
r,L=t.drift_repo()
prev=E.head(r.store.snapshot(),r.trust,'alice')['id']
lines=[]; ids=[]; dependency=L
for n in range(G.MAX_NODES+3):
    r.t+=1
    rec=R.record('entity','alice',r.t,{'state':'open','statement':f'dependency {n}','serves':[], 'evidence':[dependency]},'obligation@1',refs=[dependency],prev=prev)
    i,line=R.line(rec,KEYS['alice'])
    lines.append(line); ids.append(i); dependency=i; prev=i
r.store.add_lines(lines)
base=r.commit('claim fresh; 2003 dependent obligations')
(r.root/'lib'/'code.py').write_text('X = 2\n')
head=r.commit('accepted bytes change')
rep=t.RP.Repo(r.root).report()
assert not rep['problems'] and not rep['rejected'], (rep['problems'],rep['rejected'])
assert all(i in rep['lineages'] for i in ids)
other=t.Repo()
foreign=other.entity('bob','obligation@1',{'state':'open','statement':'foreign tail rests on last local dependency','serves':[],'evidence':[ids[-1]]})
home={'repositories':{'here':{'path':str(r.root)},'there':{'path':str(other.root)}}}
results={}
for across in (False,True):
    readings=t.A.home_readings(home) if across else None
    answer=t.D.impact(t.RP.Repo(r.root).report(),r.root,head,base,readings)
    missing=sorted(set(ids)-set(answer['affected']))
    results[str(across)]={'expected':len(ids),'actual':len(answer['affected']),'missing':len(missing),'last_dependency_missing':ids[-1] in missing,'header':t.D.impact_lines(answer).splitlines()[0],'data_keys':sorted(answer),'foreign_present':any(e['lineage']==foreign for s in answer['stale'] for e in s.get('elsewhere',[]))}
    if not missing: raise AssertionError('counterexample no longer reproduces')
os.environ['WARRANT_HOME']=str(WORK/'repro-home.json')
t.H.save(dict(t.H.empty(),**home))
cli={}
for across in (False,True):
    with contextlib.redirect_stdout(io.StringIO()) as output:
        rc=t.CLI.main(['drift','--root',str(r.root),f'--impact={base}..{head}','--json']+(['--across'] if across else []))
    envelope=json.loads(output.getvalue())
    assert len(envelope['data']['affected'])==results[str(across)]['actual']
    cli[str(across)]={'exit':rc,'root':envelope['root'],'lens':envelope['lens'],'checkout':envelope['checkout']}
print(json.dumps({'cli':cli,'max_nodes':G.MAX_NODES,'records':len(rep['_recs']),'problems':len(rep['problems']),'results':results},indent=2))

```


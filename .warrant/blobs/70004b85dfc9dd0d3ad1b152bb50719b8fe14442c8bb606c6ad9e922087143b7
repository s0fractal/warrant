## Reproduce

Save the following Python block as revert_dispatch_probe.py in the review working directory outside the checkout. Run with M checked out, using the review directory for fixture scratch:

    TMPDIR=<review-work> PYTHONDONTWRITEBYTECODE=1 python3 <review-work>/revert_dispatch_probe.py <checkout>

Expected on M: exit 1 and FAIL F1. No network, signer seed or edits to the reviewed checkout are used by this probe. Script SHA-256: 54f254af399494bcc7119065c5ca296869b045774672f33e8d78205c6272c449.

```python
"""Unsigned reproduction at the checkout passed as argv[1]. No network and no checkout edits."""
import json
import pathlib
import sys
sys.path[:0] = [str(pathlib.Path(sys.argv[1]) / 'tests'), sys.argv[1]]
from gate_test import GT, ROLES, braked_world, git, plumb, green


def scenario(fail_dispatch):
    until = 1793062800 + 86400
    r, v = braked_world(until, dict(ROLES, challenger=['dave']))
    r.put('dave', 'challenge', {'target': v, 'statement': 'Veto the changed rules'}, refs=[v])
    b = GT.Base(r.root, r.commit('the owner vetoed in time'))

    held_run = lambda head: dict(id=99, path='.github/workflows/ci.yml', head_sha=head, check_suite_id=99, conclusion='action_required', event='pull_request')

    class Hub:
        def __init__(self):
            self.pr = None
            self.calls = []
            self.dispatches = 0
            self.started = False
        def pull(self, n):
            return {'labels': []}
        def api(self, path, method='GET', body=None, pages=False):
            self.calls.append([path, method])
            if path == 'git/trees' and method == 'POST':
                index = str(r.home / 'api.index')
                plumb(r.root, 'read-tree', body['base_tree'], index=index)
                for e in body['tree']:
                    if e['sha'] is None:
                        plumb(r.root, 'update-index', '--force-remove', e['path'], index=index)
                    else:
                        plumb(r.root, 'update-index', '--add', '--cacheinfo',
                              f"{e['mode']},{e['sha']},{e['path']}", index=index)
                return {'sha': plumb(r.root, 'write-tree', index=index)}
            if path == 'git/commits' and method == 'POST':
                return {'sha': plumb(r.root, 'commit-tree', body['tree'], '-p', body['parents'][0],
                                     '-m', body['message'])}
            if path == 'git/refs' and method == 'POST':
                git(r.root, 'update-ref', body['ref'], body['sha'])
                return {}
            if path == 'pulls' and method == 'POST':
                head = git(r.root, 'rev-parse', body['head'])
                self.pr = dict(number=8, state='open', draft=False, base='master', head=head,
                               labels=[], branch=body['head'], head_repo=b.repository,
                               author='github-actions[bot]')
                return {'number': 8}
            if path == 'pulls/8':
                return {'state': 'open', 'head': {'sha': self.pr['head']}}
            if path.startswith('actions/runs?'):
                return {'workflow_runs': [held_run(self.pr['head'])]}
            if path == 'actions/runs/99/approve':
                self.started = True
                return {}
            if path.startswith('tags?'):
                return [[]]
            raise AssertionError((path, method, body))
        def dispatch(self, workflow, branch):
            self.dispatches += 1
            self.calls.append(['dispatch', workflow, branch])
            if fail_dispatch and self.dispatches == 1:
                raise GT.Refused('temporary HTTP 502 on workflow dispatch', 'GITHUB')
            self.started = True

    hub = Hub()
    first = GT.enforce_brakes(r.root, b, hub, [], now=until - 10)
    assert hub.pr is not None, first
    assert ('FAILED' in first[0][1]) == fail_dispatch, first
    later = []
    for offset in (-5, 1, 120):
        checks = green(hub.pr['head']) if hub.started else {'check_runs': [], 'workflow_runs': [held_run(hub.pr['head'])]}
        a = GT.assess(r.root, b, hub.pr, checks)
        assert a.facts.get('revert'), a.reasons
        later.append({'eligible': a.eligible, 'codes': a.codes(),
                      'enforce': GT.enforce_brakes(r.root, b, hub, [a], now=until + offset),
                      'refresh': GT.refresh_verdicts(r.root, b, hub, [a]),
                      'approve': GT.approve_held(b, hub, [a])})
    return {'first': first, 'later': later, 'dispatch_attempts': hub.dispatches, 'ci_started': hub.started, 'bot_pr_run': 'action_required', 'approval_attempts': sum(x[0] == 'actions/runs/99/approve' for x in hub.calls)}

control = scenario(False)
bad = scenario(True)
assert control['ci_started'] and all(x['eligible'] for x in control['later']), control
assert not bad['ci_started'] and bad['dispatch_attempts'] == 1, bad
assert all(x['codes'] == ['CHECK_MISSING'] and not x['eligible'] for x in bad['later']), bad
print(json.dumps({'control': control, 'failed_dispatch': bad}, indent=2))
print('FAIL F1 a transient dispatch failure after the exact revert PR opens is never retried or approved; the timely veto stays blocked by CHECK_MISSING')
sys.exit(1)

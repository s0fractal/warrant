#!/usr/bin/env python3
"""At ca55a49, impact silently loses dependents at the traversal cap.
Run from the repository root, with its tests/ available.
"""
import asyncio
import json
import os
from pathlib import Path
import subprocess
import sys

ROOT = Path.cwd()
sys.path[:0] = [str(ROOT / 'tests'), str(ROOT)]
from world import Repo, KEYS
from warrant import graph as G, records as R, engine as E
from warrant_agent import api
from warrant_agent.config import Config

r = Repo(git_init=True)
a = r.entity('alice', 'obligation@1', {'state': 'open', 'statement': 'seed', 'serves': []})
prev = E.head(r.store.snapshot(), r.trust, 'alice')['id']
x = a
chain, lines = [], []
for i in range(2002):
    rec = R.record('entity', 'alice', r.t + i + 1,
                   {'state': 'open', 'statement': f'dependent {i}', 'serves': [x]},
                   'obligation@1', refs=[x], prev=prev)
    x, line = R.line(rec, KEYS['alice'])
    prev = x
    chain.append(x)
    lines.append(line)
r.store.add_lines(lines)
base = r.commit('valid dependency chain')
rep0 = r.report()
r.attest('bob', a, verdict='seen')
head = r.commit('observation on seed')
rep1 = r.report()
assert not rep1['problems'] and not rep1['rejected'] and rep1['canonical']
assert not rep1['chains']['forks'] if isinstance(rep1.get('chains'), dict) and 'forks' in rep1['chains'] else True
rng = f'{base}..{head}'
cfg = Config({'agent_api': 'warrant-agent/3', 'workspaces': {'w': {'repo': str(r.root), 'operations': ['graph']}}})
agent = api.call(cfg, 'graph', {'workspace': 'w', 'op': 'impact', 'range': rng})['ok']
cli = subprocess.run([sys.executable, '-B', str(ROOT / 'tools/graph.py'), 'impact', rng],
                     env=dict(os.environ, WARRANT_REPO_ROOT=str(r.root)), capture_output=True, text=True)
assert cli.returncode == 0, cli.stderr
cli = json.loads(cli.stdout)

async def mcp_query():
    from mcp import ClientSession
    from mcp.client.stdio import StdioServerParameters, stdio_client
    params = StdioServerParameters(command=sys.executable,
        args=['-B', '-m', 'warrant_agent.mcp_server', '--repo', str(r.root), '--actor', 'bob', '--seed', str(r.seed('bob'))],
        env=dict(os.environ, PYTHONPATH=str(ROOT)))
    async with stdio_client(params) as (rd, wr):
        async with ClientSession(rd, wr) as session:
            await session.initialize()
            res = await session.call_tool('warrant_graph', {'workspace': r.root.name, 'op': 'impact', 'range': rng})
            assert not res.is_error, res
            return res.structured_content

mcp = asyncio.run(mcp_query())
if 'data' in mcp and 'root' not in mcp:
    mcp = mcp['data']
results = {}
for name, ans in [('agent', agent), ('CLI', cli), ('MCP', mcp)]:
    data = ans['data']
    row = next(x for x in data['lineages'] if x['lineage'] == a)
    results[name] = {'expected': len(chain), 'actual': len(row['rests_on_it']),
                     'last_omitted': chain[-1] not in row['rests_on_it'],
                     'incomplete_disclosed': row.get('complete') is False or data.get('complete') is False}
# Control: the same signed reports have every dependent when the traversal can finish.
cap = G.MAX_NODES
try:
    G.MAX_NODES = 5000
    control = next(x for x in G.impact(rep0, rep1)['lineages'] if x['lineage'] == a)
    assert set(control['rests_on_it']) == set(chain)
finally:
    G.MAX_NODES = cap
holds = all(x['actual'] == x['expected'] or x['incomplete_disclosed'] for x in results.values())
print(('ok   F1 ' if holds else 'FAIL F1 ') + 'impact reports all transitive dependents or declares incompleteness: ' + json.dumps(results))
print('control: all 2002 dependents appear at cap=5000; no store problems or rejected records')
sys.exit(0 if holds else 1)

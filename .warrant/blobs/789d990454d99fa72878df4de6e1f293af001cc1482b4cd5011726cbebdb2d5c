"""SPEC-7-1 counter-evidence probe: does compute_test C5 or C11 fail when Warrant, not Sigma,
decides the answer? Applies one edit to a temp copy of warrant/ (the replay answer is the
receipt's own `claimed`, the provider is never called) and runs tests/compute_test.py."""
import json, os, shutil, subprocess, sys, tempfile
from pathlib import Path
ROOT = Path(sys.argv[1]).resolve()
OLD = '''        out = provider.call("verify", {"runtime": condition["runtime"], "input": doc["input"], "hashes": hashes,
                                       "chain": [[base64.b64encode(ck).decode(), base64.b64encode(st).decode()]]}, blobs)'''
NEW = '''        out = {"results": [{"basis": "REPLAYED", "code": "NORMAL_FORM", "result": doc["claimed"]}]}   # Warrant answers itself'''
tmp = Path(tempfile.mkdtemp())
shutil.copytree(ROOT / "warrant", tmp / "warrant")
p = tmp / "warrant" / "compute.py"
src = p.read_text()
assert src.count(OLD) == 1
p.write_text(src.replace(OLD, NEW))
res = tmp / "results.json"
run = subprocess.run([sys.executable, str(ROOT / "tests" / "compute_test.py")], cwd=ROOT / "tests",
                     env=dict(os.environ, WARRANT_IMPL=str(tmp), WARRANT_RESULTS=str(res)), capture_output=True, text=True)
results = json.loads(res.read_text())
print("edit: warrant/compute.py replay(): the provider call is replaced by", NEW.strip())
print("compute_test under the edit:", " ".join(f"{k}={v}" for k, v in sorted(results.items())))
print("C5:", results.get("C5"), " C11:", results.get("C11"))
print("failing:", ", ".join(sorted(k for k, v in results.items() if v == "FAIL")))
shutil.rmtree(tmp)

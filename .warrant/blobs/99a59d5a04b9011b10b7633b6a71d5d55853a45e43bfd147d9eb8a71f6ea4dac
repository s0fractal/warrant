## Runnable counterexample

Save the following outside the checkout and run from M using Python with cryptography installed. Set TMPDIR to an external working directory. Exit 1 is the unmet expectation at M. Passing --supply-records is a diagnostic control, not an applied fix, and exits 0.

```python
"""Run from the reviewed checkout with its tests directory on sys.path.
Expected: the agent agrees that an accepted answer is grounded.
--supply-records is a diagnostic control, without editing repository files.
"""
import json
import sys
from pathlib import Path
sys.path[:0] = [str(Path.cwd() / 'tests'), str(Path.cwd())]
from world import Repo
from warrant import graph as G, repo as RP
from warrant_agent import api, serve
from warrant_agent.config import Config

r = Repo()
g = r.entity('alice', 'goal@1', {'state': 'open', 'key': 'G1', 'text': 'goal'})
b = {'state': 'open', 'statement': 'answer', 'answers': g, 'serves': []}
o = r.entity('alice', 'obligation@1', b)
d = r.entity('alice', 'obligation@1', dict(b, state='done'), lineage=o)
r.attest('bob', d)
m = r.entity('alice', 'goal@1', {'state': 'met', 'key': 'G1', 'text': 'goal'}, lineage=g, refs=[o])
r.attest('bob', m)
rep = RP.Repo(r.root).report()
assert rep['lineages'][g]['state'] == 'met' and rep['lineages'][o]['state'] == 'done'
assert not rep['problems'] and not rep['rejected']
assert G.grounded(rep, d)['grounded']
assert serve.lineage(rep, d)['grounded']['grounded']
cfg = Config({'agent_api': 'warrant-agent/3', 'workspaces': {'w': {'repo': str(r.root), 'operations': ['graph']}}})
if '--supply-records' in sys.argv:
    original = api._report
    def with_records(ws, view):
        out = original(ws, view)
        out['_recs'] = view.recs
        return out
    api._report = with_records
out = api.call(cfg, 'graph', {'workspace': 'w', 'op': 'grounded', 'target': d})
assert 'ok' in out, out
answer = out['ok']['data']
print(json.dumps(answer, sort_keys=True))
print(('ok   ' if answer['grounded'] else 'FAIL ') + 'R1 agent graph must exclude the obligation own answers ref')
sys.exit(0 if answer['grounded'] else 1)
```


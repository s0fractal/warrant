"""G10 counterexample: cancellation after the required check exists blocks retries."""
import json
import sys
from pathlib import Path

ROOT = Path.cwd()
sys.path.insert(0, str(ROOT / "tests"))
import gate_test as F
from warrant import gate as G


def main():
    until = 1793062800 + 86400
    r, version = F.braked_world(until, dict(F.ROLES, challenger=["dave"]))
    merge = F.git(r.root, "rev-parse", "HEAD")
    r.put("dave", "challenge", {"target": version, "statement": "Veto changed rules"}, refs=[version])
    base = r.commit("timely veto")
    b = G.Base(r.root, base)
    F.git(r.root, "checkout", "-q", "-b", f"gate/revert/7-{merge[:12]}")
    (r.root / "AGENTS.md").write_text("original rules\n")
    head = r.commit(f"Revert #7\n\nwarrant-gate revert of {merge}")
    pr = {"number": 8, "state": "open", "draft": False, "base": "master", "head": head,
          "labels": [], "branch": f"gate/revert/7-{merge[:12]}",
          "head_repo": b.repository, "author": "github-actions[bot]"}

    class Hub:
        def __init__(self, conclusion):
            self.conclusion, self.calls = conclusion, []

        def pull(self, n):
            return {"labels": []}

        def api(self, path, method="GET", body=None, pages=False):
            self.calls.append((path, method))
            if path.startswith("pulls/"):
                return {"state": "open", "head": {"sha": head}}
            if path.startswith("actions/runs?"):
                if "event=" in path:
                    return {"workflow_runs": []}
                return {"workflow_runs": [{"id": 9, "head_sha": head, "path": ".github/workflows/ci.yml",
                                            "event": "workflow_dispatch", "status": "completed",
                                            "conclusion": self.conclusion}]}
            raise AssertionError((path, method))

        def dispatch(self, workflow, branch):
            self.calls.append(("dispatch", workflow, branch))

    outcomes = []
    for label, check_conclusion, workflow_conclusion in (
            ("missing check, cancelled workflow", None, "cancelled"),
            ("existing cancelled check", "cancelled", "cancelled"),
            ("existing timed-out check", "timed_out", "timed_out"),
            ("successful control", "success", "success")):
        checks = F.green(head)
        if check_conclusion is None:
            checks["check_runs"] = []
        else:
            checks["check_runs"][0]["conclusion"] = check_conclusion
        a = G.assess(r.root, b, pr, checks, now=until - 10)
        assert a.facts.get("revert") == merge, a.reasons
        gh = Hub(workflow_conclusion)
        retries = G.approve_held(b, gh, [a])
        enforced = G.enforce_brakes(r.root, b, gh, [a], now=until - 10)
        sent = [c for c in gh.calls if c[0] == "dispatch"]
        assert enforced == [], enforced
        outcomes.append({"case": label, "codes": a.codes(), "exact_revert": True,
                         "dispatches": sent, "enforce_brakes": enforced, "retry_result": retries})
    print(json.dumps({"reviewed_commit": F.git(ROOT, "rev-parse", "HEAD"), "outcomes": outcomes}, indent=2))
    assert outcomes[0]["dispatches"] and not outcomes[3]["dispatches"], outcomes
    ok = bool(outcomes[1]["dispatches"] and outcomes[2]["dispatches"])
    print(("ok   " if ok else "FAIL ") + "F1 cancelled/timed-out required checks must not strand an exact veto revert")
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())


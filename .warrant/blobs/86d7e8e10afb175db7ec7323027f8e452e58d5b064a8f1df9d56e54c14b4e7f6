## Reproduction

Save the following Python block outside the repository and run it from M's checkout with Node and
Python (with the repository's normal Python dependencies) available. For the review run, TMPDIR
was the dedicated review work directory. Exit 1 with four FAIL lines reproduces the finding;
exit 0 means all these readers passed. The script only writes a temporary fixture and serves it
on localhost; it changes no repository file.

```python
#!/usr/bin/env python3
"""Run from the reviewed repository; exit 1 means the pins-vector counterexample remains."""
import functools
import http.server
import json
import os
import subprocess
import sys
import tempfile
import threading
from pathlib import Path

ROOT = Path.cwd()
VECTOR = json.loads((ROOT / 'tests/vectors/pins-not-checked.json').read_text())
EXPECTED = VECTOR['expect']
PINNED = {key: value for key, value in EXPECTED.items() if value == 'PINS_NOT_CHECKED'}
failures = []


def run(args, cwd=ROOT):
    proc = subprocess.run(args, cwd=cwd, env={**os.environ, 'PYTHONPATH': str(ROOT)}, capture_output=True, text=True, check=True)
    return json.loads(proc.stdout)


def check(name, got, expected):
    bad = {key: {'actual': got.get(key), 'expected': value}
           for key, value in expected.items() if got.get(key) != value}
    print(('FAIL ' if bad else 'ok   ') + name + ' ' + json.dumps(bad, sort_keys=True))
    if bad:
        failures.append(name)


class Quiet(http.server.SimpleHTTPRequestHandler):
    def log_message(self, *args):
        pass


with tempfile.TemporaryDirectory(prefix='g14-pins-') as temporary:
    home = Path(temporary)
    store = home / '.warrant'
    store.mkdir()
    (store / 'records.jsonl').write_text('\n'.join(VECTOR['lines']) + '\n')
    config = store / 'v3.json'
    config.write_text(json.dumps(VECTOR['v3']))
    for name in ('trust', 'profile'):
        (home / (name + '.json')).write_text(json.dumps(VECTOR['v3'][name]))
    package = home / 'package.json'
    package.write_text(json.dumps({'warrant': 'package/3', 'lines': VECTOR['lines'],
                                   'blobs': {}, 'roots': list(EXPECTED)}))
    # A path named store forces the Python command's no-checkout branch.
    plain_store = home / 'store'
    plain_store.mkdir()
    (plain_store / 'records.jsonl').write_bytes((store / 'records.jsonl').read_bytes())
    (plain_store / 'v3.json').write_bytes(config.read_bytes())
    python = run([sys.executable, '-m', 'warrant', 'assess', '--store', str(plain_store)], cwd=home)
    check('PYTHON_ASSESS_CONTROL', {key: lin['reliance'] for key, lin in python['lineages'].items()}, EXPECTED)
    for name, args, key in [
        ('JS_ASSESS', ['assess', '--store', str(plain_store), '--config', str(config)], 'lineages'),
        ('JS_VERIFY', ['verify', str(package), '--config', str(config)], 'roots'),
    ]:
        answer = run(['node', 'impl-js/warrant.mjs', *args])
        got = {lineage: (answer[key][lineage]['reliance'] if key == 'lineages'
                         else answer[key][lineage]['lineage']['reliance']) for lineage in EXPECTED}
        check(name, got, EXPECTED)
    server = http.server.ThreadingHTTPServer(
        ('127.0.0.1', 0), functools.partial(Quiet, directory=str(home)))
    thread = threading.Thread(target=server.serve_forever, daemon=True)
    thread.start()
    try:
        url = 'http://127.0.0.1:' + str(server.server_port)
        for summary in (False, True):
            answer = run(['node', 'impl-js/read.mjs', '--base', url] + (['--summary'] if summary else []))
            got = {key: (lin[1] if summary else lin['reliance']) for key, lin in answer['lineages'].items()}
            check('JS_HTTP_SUMMARY' if summary else 'JS_HTTP_FULL', got, EXPECTED)
    finally:
        server.shutdown()
        server.server_close()
        thread.join()

print('counterexample readers: ' + str(len(failures)))
sys.exit(1 if failures else 0)
```


import json, sys, time
from pathlib import Path
sys.path.insert(0, str(Path.cwd() / 'tests'))
from gate_test import PR, PRES, GT, green, git

def genesis(p):
    p.r.profile['roles']['pr/acceptor'] = ['alice','bob']
    p.r.write_config()
    p.r.put('alice','schema',GT.RULES_SCHEMA)
    p.g = p.r.put('alice','entity',dict(json.loads((p.r.dot/'v3.json').read_text()),state='in force'),GT.RULES)

def change(p):
    p.r.profile['roles']['replayer'].append('eve')
    p.r.write_config()
    p.n = p.r.put('alice','entity',dict(json.loads((p.r.dot/'v3.json').read_text()),state='in force'),GT.RULES,lineage=p.g)

def run(trust):
    p = PR(before_base=genesis,before_x=change if trust else lambda p: (p.r.root/'AGENTS.md').write_text('changed\n'),merge=PRES)
    now=int(time.time())
    original = p.assess(checks=green(p.head,completed=now-1),now=now,present=True)
    assert original.eligible, original.reasons
    git(p.r.root,'checkout','-q','master')
    git(p.r.root,'merge','-q','--no-ff','feature','-m',f'Merge #7\n\nwarrant-gate brake until {now+3600}: #7 head version {p.head_v}')
    base=git(p.r.root,'rev-parse','HEAD')
    b=GT.Base(p.r.root,base)
    class Held:
        def pull(self, n): return {'labels':['hold']}
    base_snap,_=GT.store_at(p.r.root,base)
    base_rep=GT.assess_snapshot(b,base_snap)
    brake=GT.brakes(p.r.root,base,now=now)[0]
    veto=GT.vetoed(b,base_rep,Held(),brake)
    assert veto is not None
    plan,err=GT.revert_plan(p.r.root,base,base)
    assert err is None,err
    git(p.r.root,'checkout','-q','-b',f'gate/revert/7-{base[:12]}')
    for e in plan:
        f=p.r.root/e['path']
        if e['sha'] is None: f.unlink()
        else:
            f.parent.mkdir(parents=True,exist_ok=True)
            f.write_bytes(GT.objects(p.r.root,[e['sha']])[e['sha']])
            f.chmod(0o755 if e['mode']=='100755' else 0o644)
    rh=p.r.commit(f'Revert #7\n\nwarrant-gate revert of {base}')
    pr={'number':8,'state':'open','draft':False,'base':'master','head':rh,'labels':[], 'branch':f'gate/revert/7-{base[:12]}','head_repo':'s0fractal/warrant','author':'github-actions[bot]'}
    a=GT.assess(p.r.root,b,pr,green(rh,completed=now),now=now)
    snap,_=GT.store_at(p.r.root,rh)
    rep=GT.assess_snapshot(b,snap)
    print(json.dumps({'trust_change':trust,'veto':veto,'original_eligible':original.eligible,'plan_paths':[e['path'] for e in plan], 'exact_revert':a.facts.get('revert')==base,'eligible':a.eligible,'reasons':a.reasons,'store_rejected':len(rep['rejected']),'store_problems':rep['problems']}))
    saved=GT.rules_reasons
    try:
        GT.rules_reasons=lambda *args: []
        diagnostic=GT.assess(p.r.root,b,pr,green(rh,completed=now),now=now)
        print(json.dumps({'diagnostic_only_rules_gate_disabled':True,'trust_change':trust,'eligible':diagnostic.eligible,'reasons':diagnostic.reasons}))
    finally:
        GT.rules_reasons=saved
    return a
control=run(False)
assert control.eligible
trust=run(True)
print(('ok   F1' if trust.eligible else 'FAIL F1')+' the owner brake must merge the exact revert of a rules change while preserving signed history')

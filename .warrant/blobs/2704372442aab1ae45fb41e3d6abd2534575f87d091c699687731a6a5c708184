## Runnable counterexample

Save the following as revert_missing_check.py outside the checkout. From an unchanged checkout of M, run with its dependencies and a TMPDIR outside the checkout:

    TMPDIR=/path/to/review/tmp python3 /path/to/review/revert_missing_check.py

Expected at M: exit 1, C1 and C2 pass, F1 fails. The output contains all simulated API calls and exact assessment codes.

```python
"""Run from the reviewed checkout; uses only fixture Git repositories and a fake forge."""
import json
import sys
from pathlib import Path
sys.path[:0] = [str(Path.cwd()), str(Path.cwd() / 'tests')]
from gate_test import GT, ROLES, braked_world, git

until = 1793062800
r, version = braked_world(until, dict(ROLES, challenger=['dave']))
r.put('dave', 'challenge', {'target': version, 'statement': 'Veto this rules change'}, refs=[version])
base = r.commit('timely veto')
b = GT.Base(r.root, base)
merge = GT.brakes(r.root, base, now=until - 1)[0]['merge']
branch = f'gate/revert/7-{merge[:12]}'
git(r.root, 'checkout', '-q', '-b', branch)
(r.root / 'AGENTS.md').write_text('original rules\n')
head = r.commit(f'Revert #7\n\nwarrant-gate revert of {merge}')
pr = {'number': 8, 'state': 'open', 'draft': False, 'base': 'master', 'head': head,
      'labels': [], 'branch': branch, 'head_repo': b.repository, 'author': 'github-actions[bot]'}
workflow = b.gate['required'][0]['workflow']

class Hub:
    def __init__(self, status, conclusion):
        self.calls = []
        self.run = {'id': 91, 'path': workflow, 'head_sha': head, 'check_suite_id': 91,
                    'event': 'workflow_dispatch', 'status': status, 'conclusion': conclusion}
    def api(self, path, method='GET', body=None, pages=False):
        self.calls.append([method, path])
        if path.startswith('pulls/'):
            return {'state': 'open', 'head': {'sha': head}}
        if path.startswith('actions/runs?'):
            return {'workflow_runs': [] if 'event=pull_request' in path or self.run['status'] == 'absent' else [self.run]}
        if pages:
            return [[]]
        return {}
    def dispatch(self, workflow, branch):
        self.calls.append(['DISPATCH', workflow, branch])

results = []
# A completed cancelled workflow, with no job check, is the defect. Queued is a control:
# a live workflow must be left alone while it can still create its job.
for status, conclusion in [('completed', 'cancelled'), ('queued', None), ('absent', None)]:
    gh = Hub(status, conclusion)
    checks = {'check_runs': [], 'workflow_runs': [] if status == 'absent' else [gh.run]}
    a = GT.assess(r.root, b, pr, checks, now=until - 1)
    assert a.facts.get('revert') == merge, (a.facts, a.reasons)
    assert a.codes() == ['CHECK_MISSING'], a.reasons
    rounds = []
    for _ in range(2):
        rounds.append({'brake': GT.enforce_brakes(r.root, b, gh, [a], now=until - 1),
                       'recovery': GT.approve_held(b, gh, [a])})
    results.append({'status': status, 'conclusion': conclusion, 'codes': a.codes(),
                    'exact_revert': True, 'rounds': rounds, 'calls': gh.calls,
                    'recovery_writes': [c for c in gh.calls if c[0] != 'GET']})
print(json.dumps(results, indent=2))
assert not results[1]['recovery_writes'], 'queued control should be left running'
print('ok   C1 a queued workflow is left alone')
assert results[2]['recovery_writes'], 'absent-run control must dispatch CI'
print('ok   C2 absent workflow is dispatched')
if not results[0]['recovery_writes']:
    print('FAIL F1 a terminal cancelled workflow without the required check permanently suppresses revert CI recovery')
    sys.exit(1)
print('ok   F1 a terminal cancelled workflow without the required check is retried')
```


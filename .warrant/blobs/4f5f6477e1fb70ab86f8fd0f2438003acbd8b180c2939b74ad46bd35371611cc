ffc8d5433ab4365c203\", \"schema\": \"obligation@1\", \"to\": [\"done\", \"ELIGIBLE\"]}}\n","reproducer":"\"\"\"Run at a0f0732c7fc774ed0ddd93e5824f8c44272fed7d from the repository root.\nTMPDIR must name a scratch directory outside the checkout. No live records are changed.\nExit 1 / FAIL means an uncovered reader reports ELIGIBLE on unchecked pins.\n\"\"\"\nimport json\nimport re\nimport sys\nimport tempfile\nfrom pathlib import Path\n\nROOT = Path.cwd()\nsys.path[:0] = [str(ROOT), str(ROOT / 'tests')]\nfrom world import Repo\nfrom warrant_agent import api, serve\nfrom warrant_agent.config import Config\nfrom warrant_agent.changes import subset\n\n\ndef store_config(root, trust, profile):\n    (root / 'trust.json').write_text(json.dumps(trust))\n    (root / 'profile.json').write_text(json.dumps(profile))\n    return Config({'agent_api': 'warrant-agent/3', 'workspaces': {'w': {\n        'store': str(root / '.warrant'), 'trust': str(root / 'trust.json'),\n        'profile': str(root / 'profile.json'), 'operations': ['context']}}})\n\n\ndef reliance(cfg, target):\n    return api.call(cfg, 'context', {'workspace': 'w', 'targets': [target],\n                                   'actor': 'unassigned'})['ok']['targets'][target]['lineage']['reliance']\n\n\ndef serve_vector():\n    vec = json.loads((ROOT / 'tests/vectors/pins-not-checked.json').read_text())\n    with tempfile.TemporaryDirectory() as td:\n        root = Path(td)\n        dot = root / '.warrant'\n        dot.mkdir()\n        (dot / 'records.jsonl').write_text('\\n'.join(vec['lines']) + '\\n')\n        (dot / 'v3.json').write_text(json.dumps(vec['v3']))\n        cfg = store_config(root, vec['v3']['trust'], vec['v3']['profile'])\n        app = serve.App(serve.Space({'v': str(root)}))\n        failures = []\n        for L, expected in vec['expect'].items():\n            status, page = app.page_lineage('v', L)\n            floor = re.search(r'data-floor=\"reliance\">(.*?)</span></span>', page)\n            got = re.sub('<[^>]+>', '', floor.group(1)) if floor else None\n            control = reliance(cfg, L)\n            assert control == expected, (L, control, expected)\n            assert status == 200, status\n            if got != expected:\n                failures.append({'lineage': L, 'expected': expected,\n                                 'context': control, 'serve_page': got})\n        print(('FAIL' if failures else 'ok  ') + ' F1 warrant serve must pass every row of the unchanged pins vector')\n        print(json.dumps(failures, sort_keys=True))\n        return bool(failures)\n\n\ndef whatif_pins():\n    r = Repo()\n    target = r.entity('alice', 'obligation@1', {'state': 'done', 'statement': 'pinned example', 'serves': []})\n    r.attest('bob', target, files={'x.py': '1' * 40}, commit='2' * 40)\n    c = r.put('bob', 'challenge', {'target': target, 'statement': 'counterexample'}, refs=[target])\n    cfg = store_config(r.root, r.trust, r.profile)\n    assert reliance(cfg, target) == 'CHALLENGED'\n    result = api.call(cfg, 'whatif', {'workspace': 'w', 'without': [c]})['ok']\n    row = next(x for x in result['changes'] if x['lineage'] == target)\n    # Read the very same hypothetical records through context as a control.\n    candidate = subset(r.store.snapshot(), set(r.store.snapshot().lines) - {c})\n    r.store.file.write_bytes(b''.join(candidate.raw))\n    control = reliance(cfg, target)\n    assert control == 'PINS_NOT_CHECKED', control\n    failed = row['to'][1] != control\n    print(('FAIL' if failed else 'ok  ') + ' F2 store-only whatif must show PINS_NOT_CHECKED after removing a challenge from a pinned lineage')\n    print(json.dumps({'whatif': row, 'context_on_same_candidate': control}, sort_keys=True))\n    return failed\n\n\nfailed = [serve_vector(), whatif_pins()]\nsys.exit(1 if any(failed) else 0)\n","run":"From the pinned repository root, save reproducer as pins_readers_counterexample.py outside the checkout; set TMPDIR to a scratch directory there; run python3 -B /absolute/path/pins_readers_counterexample.py. Imports only the base's code and tests/world.py; uses test keys and temporary fixtures, never changes the live store. Expected at this base: exit 1, FAIL F1 and FAIL F2.","version":"e91f50f18056ed375b6d4e8d2208632c75fbd41b9185681a03bfe873d4100e1e","warrant":"review-evidence/1"}
Reproducer (synthetic keys only):

```python
"""G14 counterexample at e840770c0ca2d321d0b5e06d50c926e44f2c83a3.

Run from the checkout: TMPDIR=<scratch> python3 <this-file>
Uses synthetic fixture keys only; writes fixtures beneath TMPDIR, never to the checkout.
Expected at M: FAIL F1 and FAIL F2, exit 1; unpinned controls pass.
"""
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile

ROOT = Path.cwd()
sys.path[:0] = [str(ROOT / "tests"), str(ROOT)]
import delegate_test as DT
from warrant import delegate as DG, drift as DR, keys as K, records as R
from warrant.store import Snapshot
from warrant_agent import api
from warrant_agent.config import Config


def probe(pinned):
    fixture_keys = iter(K.Key.from_seed_hex(f"{i:02x}" * 32) for i in range(1, 5))
    old_key = DT._key
    try:
        DT._key = lambda: next(fixture_keys)
        w = DT._setup_base()
    finally:
        DT._key = old_key
    sub = K.Key.from_seed_hex("05" * 32)
    grant = DG.grant_record("bob", "bob-sub", sub.public, ["acceptor"], ["attest"],
                            100, 200, max_depth=0, schemas=["task@1"],
                            lineages=[w["task_root"]], at=100)
    body = {"target": w["task_done"], "verdict": "accept"}
    if pinned:
        body.update(commit="ab" * 20, files={"x.py": "cd" * 20})
    accept = R.record("attest", "bob-sub", 150, body, refs=[w["task_done"]])
    lines = w["lines"] + [DT._line(grant, w["keys"]["bob"]), DT._line(accept, sub)]
    snap = Snapshot(lines, {})
    res = DG.assess_delegated(snap, w["trust"], w["profile"], 150)
    rep = res["delegated_report"]
    rep["_recs"] = {i: es[0]["record"] for i, es in snap.lines.items()}
    rep["_basis"] = {n[0]: n[5] for n in rep["graph"]["nodes"]}
    covered = w["task_root"] in DR.covered(rep)
    DR.not_checked(rep)
    expected = rep["lineages"][w["task_root"]]["reliance"]
    assert expected == ("PINS_NOT_CHECKED" if pinned else "ELIGIBLE")
    with tempfile.TemporaryDirectory(prefix="g14-delegate-") as td:
        root = Path(td)
        assert not DR._own_checkout(root)
        dot = root / ".warrant"
        dot.mkdir()
        (dot / "records.jsonl").write_bytes(b"".join(lines))
        (dot / "v3.json").write_text(json.dumps({"warrant": "repository/3", "repository": "g14-counterexample",
                                                "trust": w["trust"], "profile": w["profile"]}))
        cfg = Config({"agent_api": "warrant-agent/3", "workspaces": {"w": {"repo": str(root)}}})
        ans = api.call(cfg, "delegate", {"workspace": "w", "op": "assess", "as_of": 150})["ok"]
        assert len(ans["admitted"]) == 1 and not ans["refused"]
        cmd = [sys.executable, "-m", "warrant", "delegate", "--root", str(root), "assess", "--as-of", "150"]
        cli = subprocess.run(cmd + ["--json"], cwd=ROOT, capture_output=True, text=True, check=True)
        text = subprocess.run(cmd, cwd=ROOT, capture_output=True, text=True, check=True).stdout
        changes = lambda a: next(x for x in a["changes"] if x["lineage"] == w["task_root"])["to"]
        got = {"api": changes(ans), "cli_json": changes(json.loads(cli.stdout)), "cli_text": text.strip(),
               "covered": covered, "expected": ["done", expected]}
        print(json.dumps({"pinned": pinned, **got}, sort_keys=True))
        return got


control = probe(False)
assert control["api"] == control["cli_json"] == ["done", "ELIGIBLE"]
print("ok   C1 unpinned acceptance remains ELIGIBLE in both readers")
got = probe(True)
fails = 0
for case, key in (("F1", "api"), ("F2", "cli_json")):
    ok = got[key] == got["expected"]
    print(("ok   " if ok else "FAIL ") + case + " delegate assess " + key + ": " + repr(got[key])
          + "; expected " + repr(got["expected"]) + "; no checkout compared")
    fails += not ok
sys.exit(bool(fails))
```


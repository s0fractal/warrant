"""Run from the exact checkout: python3 -B /path/to/reproduce.py ."""
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile

ROOT = Path(sys.argv[1]).resolve()
WORK = Path.home() / '.warrant/work/codex/a9aa65e7090a'
WORK.mkdir(parents=True, exist_ok=True)
os.environ['TMPDIR'] = str(WORK)
os.environ['PYTHONDONTWRITEBYTECODE'] = '1'
tempfile.tempdir = str(WORK)
sys.path[:0] = [str(ROOT / 'tests'), str(ROOT)]
import tools_test as TT
from warrant import claims as C, drift as D, verify as V
from warrant.repo import Repo
from warrant_agent import api
from warrant_agent.config import Config

def projected(answer, roots):
    return {i: answer['roots'][i]['lineage']['reliance'] for i in roots}

def cli_readers(package, config, directory):
    p = directory / 'package.json'
    c = directory / 'v3.json'
    p.write_text(json.dumps(package))
    c.write_text(json.dumps(config))
    commands = {
        'python CLI': [sys.executable, '-B', '-m', 'warrant', 'verify', str(p), '--config', str(c)],
        'standalone': [sys.executable, '-I', '-S', str(ROOT / 'warrant_verify.py'), str(p), '--config', str(c)],
        'JavaScript': ['node', str(ROOT / 'impl-js/warrant.mjs'), 'verify', str(p), '--config', str(c)],
    }
    out = {}
    for name, command in commands.items():
        run = subprocess.run(command, cwd=ROOT, capture_output=True, text=True, check=False)
        answer = json.loads(run.stdout)
        out[name] = {'exit': run.returncode, 'reliance': projected(answer, package['roots'])}
        if 'rely' in answer:
            out[name]['rely'] = answer['rely']
    return out

with tempfile.TemporaryDirectory(dir=WORK) as temporary:
    directory = Path(temporary)
    vector = json.loads((ROOT / 'tests/vectors/pins-not-checked.json').read_text())
    package = {'warrant': 'package/3', 'lines': vector['lines'], 'blobs': {}, 'roots': sorted(vector['expect'])}
    answer = V.verify(json.dumps(package).encode(), vector['v3']['trust'], vector['v3']['profile'])
    mismatch = {i: {'expected': vector['expect'][i], 'actual': answer['roots'][i]['lineage']['reliance']}
                for i in vector['expect'] if vector['expect'][i] != answer['roots'][i]['lineage']['reliance']}
    readers = cli_readers(package, vector['v3'], directory)
    print('FULL_VECTOR ' + json.dumps({'discrepancies': mismatch, 'readers': readers}, sort_keys=True))
    assert len(mismatch) == 1
    retired = next(iter(mismatch))
    assert mismatch[retired] == {'expected': 'ELIGIBLE', 'actual': 'PINS_NOT_CHECKED'}
    assert readers['python CLI']['reliance'][retired] == readers['standalone']['reliance'][retired] == 'PINS_NOT_CHECKED'
    assert readers['JavaScript']['reliance'][retired] == 'ELIGIBLE'

    # Only deterministic fixture keys from tests/world.py are used here.
    fixture = TT.checker_repo()
    target = TT.claim(fixture)
    commit = fixture.commit('legacy checker acceptance pins its commit, no file list')
    TT.put_as(fixture, C.CHECKER, {'target': target, 'verdict': 'accept', 'commit': commit}, [target])
    report = Repo(fixture.root).report()
    assert report['versions'][target]['guard'] == 'MET'
    assert target in D.covered(report)
    D.not_checked(report)
    expected = report['lineages'][target]['reliance']
    package = {'warrant': 'package/3', 'roots': [target], 'blobs': {},
               'lines': [line.decode().strip() for line in fixture.store.snapshot().raw]}
    config = json.loads((fixture.dot / 'v3.json').read_text())
    answer = V.verify(json.dumps(package).encode(), fixture.trust, fixture.profile)
    store_config = Config({'agent_api': 'warrant-agent/3', 'workspaces': {'w': {
        'repo': str(fixture.root), 'operations': ['handoff']}}})
    inspection = api.call(store_config, 'handoff', {'workspace': 'w', 'op': 'inspect', 'alone': True, 'package': package})['ok']
    readers = cli_readers(package, config, directory)
    result = {'expected': expected, 'api': {'reliance': projected(answer, [target]), 'rely': answer['rely'],
              'pins': answer['roots'][target]['pins'], 'why_not': answer['roots'][target]['why_not']},
              'handoff': projected(inspection, [target]), 'readers': readers}
    print('LEGACY_CHECKER ' + json.dumps(result, sort_keys=True))
    assert expected == inspection['roots'][target]['lineage']['reliance'] == 'PINS_NOT_CHECKED'
    assert answer['roots'][target]['lineage']['reliance'] == 'ELIGIBLE' and answer['rely'] is True
    assert readers['python CLI']['exit'] == readers['standalone']['exit'] == 0
    assert readers['standalone']['reliance'][target] == 'ELIGIBLE'
    assert readers['JavaScript']['reliance'][target] == 'PINS_NOT_CHECKED'
print('REPRODUCED: Python verification disagrees with the full vector and grants reliance on an unchecked legacy checker acceptance.')

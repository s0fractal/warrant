    },
    {
      "id": "F2",
      "severity": "P2",
      "statement": "An unrelated github-actions-prefixed commenter can suppress the constitutional owner notification.",
      "where": [
        "warrant/gate.py:1108-1110"
      ],
      "what": "notify treats any comment containing the public per-commit marker as the gate notice when the commenter login startswith github-actions. A normal User login such as github-actions-example satisfies this predicate. A comment with only the marker, containing no owner mention, prevents the gate posting its required notice. This undermines the owner notification on which the week-long constitutional veto window relies. Prefix-shaped User accounts exist in the GitHub user namespace (read-only search returned github-actions-pc-bot and github-actions-tools); this is no claim those accounts acted maliciously.",
      "expected": "Only a notice from the actual trusted Actions bot identity counts for deduplication; a different user carrying its marker must still cause the real owner notice to be posted.",
      "observed": "A marker posted by someone produces one notice; the identical marker attributed to github-actions-example produces zero; the real github-actions[bot] suppresses duplicates as expected."
    }

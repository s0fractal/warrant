## Reproducer

Run from the reviewed checkout. Requires the same Python dependencies as tests/gate_test.py. Save the code below outside the repository, set TMPDIR to an external scratch directory, and run `PYTHONDONTWRITEBYTECODE=1 python3 <probe.py>` (expected FAIL F1 / exit 1 at M). Repeat with `MARKER_CONTROL=1` (expected ok F1 / exit 0).

```python
"""Unsigned integration counterexample: use merge_one's actual message for a rules revert."""
import json, os, sys
from pathlib import Path
sys.path.insert(0, str(Path.cwd() / 'tests'))
from gate_test import GT, Repo, git, green, PRES, NOW, REPO

r = Repo(git_init=False)
(r.dot / 'merge.json').write_text(json.dumps(PRES))
r.put('alice', 'schema', GT.RULES_SCHEMA)
g = r.put('alice', 'entity', dict(json.loads((r.dot / 'v3.json').read_text()), state='in force'), GT.RULES)
git(r.root, 'init', '-q', '-b', 'master')
r.commit('base, rules recorded')
git(r.root, 'checkout', '-q', '-b', 'feature')
r.profile['roles']['replayer'] = sorted(set(r.profile['roles']['replayer']) | {'eve'})
r.write_config()
n1 = r.put('bob', 'entity', dict(json.loads((r.dot / 'v3.json').read_text()), state='in force'), GT.RULES, lineage=g)
v = r.entity('alice', 'pr-head@1', {'state':'open','repository':REPO,'pr':7,'title':'t'})
r.commit('the rules change and its version')
git(r.root, 'checkout', '-q', 'master')
git(r.root, 'merge', '-q', '--no-ff', 'feature', '-m', f'Merge pull request #7\n\nwarrant-gate brake until {NOW + 3600}: #7 head version {v}')
merge = git(r.root, 'rev-parse', 'HEAD')
branch = f'gate/revert/7-{merge[:12]}'
git(r.root, 'checkout', '-q', '-b', branch)
git(r.root, 'checkout', f'{merge}^1', '--', '.warrant/v3.json')
r.commit(f'Revert #7\n\nwarrant-gate revert of {merge}')
rh = git(r.root, 'rev-parse', 'HEAD')
pr = {'number':8,'state':'open','draft':False,'base':'master','head':rh,'labels':[], 'branch':branch,'head_repo':REPO,'author':'github-actions[bot]'}
b = GT.Base(r.root, merge)
a = GT.assess(r.root, b, pr, green(rh))
assert a.eligible and a.facts.get('revert') == merge, a.reasons

class GitHubFixture:
    def pull(self, n): return pr
    def tip(self, name): return merge
    def merge(self, n, head, title, message):
        self.message = title + '\n\n' + message
        if os.environ.get('MARKER_CONTROL'):
            self.message += f'\n\nwarrant-gate revert of {merge}\n'
        git(r.root, 'checkout', '-q', 'master')
        git(r.root, 'merge', '-q', '--no-ff', head, '-m', self.message)
        self.sha = git(r.root, 'rev-parse', 'HEAD')
        return {'merged':True, 'sha':self.sha}
    def parents(self, sha): return GT._commit(r.root, sha)[0]
    def dispatch(self, workflow, branch): pass

gh = GitHubFixture()
result = GT.merge_one(b, a, gh)
assert result['merged'] and result['as_assessed'], result
recognized = GT.reverted(r.root, gh.sha, merge)
void = n1 in GT.reverted_rules(r.root, gh.sha)
git(r.root, 'checkout', '-q', '-b', 'later')
(r.root / 'notes.md').write_text('ordinary later change\n')
x = r.commit('ordinary later change')
v9 = r.entity('alice', 'pr-head@1', {'state':'open','repository':REPO,'pr':9,'title':'later'})
h9 = r.entity('alice', 'pr-head@1', {'state':'head','commit':x,'tree':git(r.root,'rev-parse',f'{x}^{{tree}}')}, lineage=v9)
r.attest('bob', h9)
lh = r.commit('later accepted head')
later = GT.assess(r.root, gh.sha, {'number':9,'state':'open','draft':False,'base':'master','head':lh,'labels':[], 'branch':'later','head_repo':REPO,'author':'alice'}, green(lh))
print(json.dumps({'base_source':git(Path.cwd(),'rev-parse','HEAD'),'control':bool(os.environ.get('MARKER_CONTROL')), 'revert_eligible':a.eligible,'merged':result['merged'],'as_assessed':result['as_assessed'], 'actual_merge_message':gh.message,'reverted':recognized,'rules_version_void':void,'later_codes':later.codes(),'later_reasons':later.reasons}, indent=2))
if recognized and void and later.eligible:
    print('ok   F1 a gate-merged rules revert is recognized and permits later accepted changes')
else:
    print('FAIL F1 a gate-merged rules revert is invisible on first-parent history and blocks later accepted changes')
    sys.exit(1)


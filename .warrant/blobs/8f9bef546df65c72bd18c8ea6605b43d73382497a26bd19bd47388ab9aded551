import argparse,contextlib,io,json,os,subprocess,sys
from pathlib import Path
sys.path[:0]=[str(Path.cwd()/'tests'),str(Path.cwd())]
from world import Repo,git
from warrant import differential as DF
ap=argparse.ArgumentParser();ap.add_argument('--published-python',required=True);args=ap.parse_args()
r=Repo(git_init=True)
h=r.blob(b"n's exact historical bytes")
o=r.entity('alice','obligation@1',{'state':'open','statement':'release 9.9','serves':[]})
c=r.entity('alice','obligation@1',{'state':'done','statement':'release 9.9','serves':[],'refs':['warrant-graph==9.9'],'evidence':[h]},lineage=o,refs=[h])
r.attest('bob',c)
r.commit('n history');git(r.root,'tag','v3.0.0a8')
index=str(r.home/'source-index')
def source(data):
    env=dict(os.environ,GIT_INDEX_FILE=index)
    subprocess.run(['git','-C',str(r.root),'read-tree','--empty'],env=env,check=True)
    empty=subprocess.run(['git','-C',str(r.root),'hash-object','-w','--stdin'],input=b'',capture_output=True,check=True).stdout.decode().strip()
    subprocess.run(['git','-C',str(r.root),'update-index','--add','--cacheinfo',f'100644,{empty},.warrant/records.jsonl'],env=env,check=True)
    obj=subprocess.run(['git','-C',str(r.root),'hash-object','-w','--stdin'],input=data,capture_output=True,check=True).stdout.decode().strip()
    subprocess.run(['git','-C',str(r.root),'update-index','--add','--cacheinfo',f'100644,{obj},.warrant/blobs/{h}'],env=env,check=True)
    tree=subprocess.run(['git','-C',str(r.root),'write-tree'],env=env,capture_output=True,check=True).stdout.decode().strip()
    commit=git(r.root,'commit-tree',tree,'-m','source historical blob')
    git(r.root,'update-ref','refs/heads/stores/history',commit)
(r.dot/'sources.json').write_text(json.dumps({'warrant':'sources/1','sources':[{'name':'history','ref':'refs/heads/stores/history','actors':['alice']}]}))
(r.dot/'blobs'/h).unlink()
rows={}
for name,data in [('valid',b"n's exact historical bytes"),('corrupt',b'REPLACED: original history bytes are absent')]:
    source(data)
    out=io.StringIO()
    with contextlib.redirect_stdout(out):
        rc=DF.main(['--root',str(r.root),'--python',args.published_python,'--release','9.9'])
    rows[name]={'rc':rc,'result':json.loads(out.getvalue())}
git(r.root,'update-ref','-d','refs/heads/stores/history')
out=io.StringIO()
with contextlib.redirect_stdout(out):
    rc=DF.main(['--root',str(r.root),'--python',args.published_python,'--release','9.9'])
rows['missing_source']={'rc':rc,'result':json.loads(out.getvalue())}
print(json.dumps(rows,indent=2))
assert rows['valid']['rc']==0
assert rows['missing_source']['rc']==1
bad=rows['corrupt']['rc']==0
print('FAIL F1 release admits a corrupted historical blob moved to a declared source' if bad else 'ok   F1 corrupted history is refused')
sys.exit(1 if bad else 0)

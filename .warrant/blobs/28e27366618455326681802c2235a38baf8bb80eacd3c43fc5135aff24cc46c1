## Reproducer

Run this Python program from a checkout at M. It invokes only read operations and writes no repository files. F1-F3 fail at M, while all commands themselves exit 0.

```python
"""G11 counterexample at master 4641ff354b5a4c846cd28f46100fe2b7ccae6bc6.
Run from its checkout: python3 /path/to/this.py
Public generated views must carry a full root and a lens of what decided them.
"""
import json,re,subprocess
from pathlib import Path
ROOT=Path.cwd()
failed=[]
for case,module in [('F1','roadmap'),('F2','claims'),('F3','review')]:
 command=['python3','-m','warrant.'+module,'view']
 r=subprocess.run(command,cwd=ROOT,capture_output=True,text=True)
 header=r.stdout.split('\n\n',2)[:2]
 bound=bool(re.search(r'root [`]?[0-9a-f]{64}[`]?',r.stdout) and re.search(r'lens [`]?[0-9a-f]{64}[`]?',r.stdout))
 ok=r.returncode==0 and bound
 print(('ok   ' if ok else 'FAIL ')+case+' '+' '.join(command)+' carries full root and lens',flush=True)
 print(json.dumps(dict(exit=r.returncode,bytes=len(r.stdout.encode()),header=header)),flush=True)
 if not ok: failed.append(case)
raise SystemExit(bool(failed))
```


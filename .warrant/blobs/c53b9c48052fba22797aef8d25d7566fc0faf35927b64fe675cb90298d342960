Reproduction source: original F2
```python
#!/usr/bin/env python3
"""The preflight must retain the bytes of already-rejected lines."""
import sys
from pathlib import Path

ROOT = Path.cwd()
sys.path[:0] = [str(ROOT / 'tests'), str(ROOT)]
from world import Repo, check, finish
from warrant import engine as E
from warrant import records as R
from warrant.store import LIMITS
from warrant_agent import api
from warrant_agent.config import Config


def exercise(rejected):
    repo = Repo()
    if rejected:
        repo.store.add_lines([b'{"junk":"' + b'x' * 1024 + b'"}\n'])
    cfg = Config({'agent_api': 'warrant-agent/3', 'workspaces': {'w': {
        'repo': str(repo.root), 'signer': {'actor': 'bob', 'key': str(repo.seed('bob'))}}}})
    before = repo.store.file.read_bytes()
    target = repo.schemas['goal@1']
    record = R.record('attest', 'bob', repo.t + 1, {'target': target, 'verdict': 'seen'}, refs=[target],
                      prev=E.head(repo.store.snapshot(), repo.trust, 'bob')['id'])
    bound = LIMITS['bytes']
    try:
        # The same byte-accounting rule at a small bound avoids allocating 256 MiB.
        LIMITS['bytes'] = len(before) + 64
        p = api.call(cfg, 'prepare', {'workspace': 'w', 'kind': 'attest', 'target': target,
                                      'body': {'verdict': 'seen'}})
        c = api.call(cfg, 'commit', {'workspace': 'w', 'record': record})
        after = api.call(cfg, 'workspace', {})
        return {'prepare': p.get('error', 'ok'), 'commit': c.get('error', 'ok'),
                'workspace': after.get('error', 'ok'), 'unchanged': repo.store.file.read_bytes() == before}
    finally:
        LIMITS['bytes'] = bound


def main():
    clean, rejected = exercise(False), exercise(True)
    want = {'prepare': 'INVALID_RECORD', 'commit': 'INVALID_RECORD', 'workspace': 'ok', 'unchanged': True}
    check('F2 preflight counts existing rejected bytes against the engine limit',
          clean == want and rejected == want, {'clean': clean, 'rejected_line': rejected})
    return finish()


if __name__ == '__main__':
    sys.exit(main())
```

Reproduction source: additional boundary probes (run from the pinned source root)
```python
import json
import sys
from pathlib import Path
sys.path[:0] = [str(Path.cwd() / 'tests'), str(Path.cwd())]
from world import Repo, KEYS
from warrant import records as R
from warrant.store import LIMITS
from warrant_agent import api
from warrant_agent.config import Config

rows = []
for layout in ['clean', 'invalid-json-and-utf8', 'noncanonical-and-overlong', 'duplicates', 'signature-variants-and-blob']:
    for delta in [-1, 0, 1]:
        repo = Repo()
        first = repo.store.lines()[0]
        if layout == 'invalid-json-and-utf8':
            repo.store.add_lines([b'{bad json\n', b'\xff\xfe\n', b'{"junk":"' + b'x'*1024 + b'"}\n'])
        elif layout == 'noncanonical-and-overlong':
            repo.store.add_lines([b' ' + first, b'x' * (R.LINE_MAX + 1) + b'\n'])
        elif layout == 'duplicates':
            repo.store.add_lines([b'{"junk":1}\n'])
            repo.store.file.write_bytes(repo.store.file.read_bytes() + first * 3 + b'{"junk":1}\n' * 3)
        elif layout == 'signature-variants-and-blob':
            env = json.loads(first)
            _, variant = R.line(env['record'], KEYS['eve'])
            repo.store.add_lines([variant, b'{"junk":"variant"}\n'])
            repo.store.put_blob(b'opaque evidence' * 103)
        cfg = Config({'agent_api':'warrant-agent/3', 'workspaces':{'w':{
            'repo':str(repo.root), 'signer':{'actor':'bob','key':str(repo.seed('bob'))}}}})
        before = repo.store.file.read_bytes()
        snap = repo.store.snapshot()
        assert set(snap.raw) == set(repo.store.lines())
        unique_bytes = sum(map(len, set(repo.store.lines()))) + sum(map(len, snap.blobs.values()))
        request = {'workspace':'w','kind':'attest','target':repo.schemas['goal@1'],'body':{'verdict':'seen'}}
        clock = api.time.time
        bound = LIMITS['bytes']
        try:
            api.time.time = lambda: repo.t + 1
            record = api.call(cfg, 'prepare', request)['ok']['record']
            _, candidate = R.line(record, KEYS['bob'])
            LIMITS['bytes'] = unique_bytes + len(candidate) + delta
            p = api.call(cfg, 'prepare', request)
            c = api.call(cfg, 'commit', {'workspace':'w','record':record})
            after = api.call(cfg, 'workspace', {})
            expected = 'INVALID_RECORD' if delta < 0 else 'ok'
            got = (p.get('error','ok'), c.get('error','ok'), after.get('error','ok'))
            assert got == (expected, expected, 'ok'), (layout, delta, got)
            if delta < 0:
                assert repo.store.file.read_bytes() == before
            else:
                stored = repo.store.snapshot()
                assert R.rid(record) in stored.lines
                assert set(snap.raw).issubset(set(stored.raw))
                assert sum(map(len,stored.raw)) + sum(map(len,stored.blobs.values())) <= LIMITS['bytes']
            rows.append({'layout':layout, 'slack':delta, 'prepare':got[0], 'commit':got[1], 'workspace':got[2]})
        finally:
            LIMITS['bytes'] = bound
            api.time.time = clock
print(json.dumps(rows, indent=1))
print(f'all {len(rows)} byte-boundary probes passed')

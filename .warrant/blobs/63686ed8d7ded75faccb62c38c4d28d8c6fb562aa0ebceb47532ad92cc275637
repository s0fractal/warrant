import importlib.util
import json
import os
import sys
from pathlib import Path
ROOT = Path.cwd()
sys.path[:0] = [str(ROOT / 'tests'), str(ROOT)]
from world import Repo, git
from warrant import repo as RP
from warrant_agent import api
from warrant_agent.config import Config
spec = importlib.util.spec_from_file_location('graph_tool', ROOT / 'tools/graph.py')
TG = importlib.util.module_from_spec(spec)
spec.loader.exec_module(TG)
r = Repo(git_init=True)
(r.root / 'lib').mkdir()
(r.root / 'lib/a.py').write_text('A = 1\n')
x = r.commit('accepted bytes')
o = r.entity('alice', 'obligation@1', {'state':'open', 'statement':'pinned work', 'serves':[]})
d = r.entity('alice', 'obligation@1', {'state':'done', 'statement':'pinned work', 'serves':[]}, lineage=o)
r.attest('bob', d, commit=x, files={'lib/a.py':git(r.root, 'rev-parse', f'{x}:lib/a.py')})
b = r.commit('pinned acceptance')
(r.root / 'lib/a.py').write_text('A = 2\n')
h = r.commit('changed pinned bytes, no record changes')
cfg = Config({'agent_api':'warrant-agent/3','workspaces':{'w':{'repo':str(r.root),'operations':['graph']}}})
cli = TG.ask(RP.Repo(r.root), 'delta', [f'{b}..{h}'])[3]
agent = api.call(cfg, 'graph', {'workspace':'w','op':'delta','range':f'{b}..{h}'})
cli_imp = TG.ask(RP.Repo(r.root), 'impact', [f'{b}..{h}'])[3]
agent_imp = api.call(cfg, 'graph', {'workspace':'w','op':'impact','range':f'{b}..{h}'})
print(json.dumps({'obligation':o, 'base':b, 'head':h, 'cli_delta':cli,'agent_delta':agent,'cli_impact':cli_imp,'agent_impact':agent_imp}, indent=1))
print('FAIL F1 agent delta must name a lineage whose pinned reliance changed' if o not in agent.get('ok',{}).get('data',{}).get('changed',[]) else 'ok   F1')
# Force a row without changing the pinned acceptance, state, version or challenge.
r.put('eve','attest',{'target':d,'verdict':'note'},refs=[d])
h2 = r.commit('an uncounted note on stale work')
cli_row = next(z for z in TG.ask(RP.Repo(r.root),'impact',[f'{h}..{h2}'])[3]['lineages'] if z['lineage']==o)
agent_rows = api.call(cfg,'graph',{'workspace':'w','op':'impact','range':f'{h}..{h2}'})['ok']['data']['lineages']
agent_row = next(z for z in agent_rows if z['lineage']==o)
print(json.dumps({'cli_impact_row':cli_row,'agent_impact_row':agent_row},indent=1))
print('FAIL F2 agent impact must report the pinned stale lineage STALE' if agent_row['reliance']!='STALE' else 'ok   F2')

```


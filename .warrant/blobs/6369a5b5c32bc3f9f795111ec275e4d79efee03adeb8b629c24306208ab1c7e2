## Reproduction

Save the following script outside the checkout and run with this checkout path as its argument; set TMPDIR to that external work directory and PYTHONDONTWRITEBYTECODE=1.

```python
"""Unsigned probe: actual replay runner, inert signer, record collection only.
Run: python3 -B head_coverage_probe.py /path/to/warrant
Only fixture actors sign fixture input. No replay attest is signed or stored.
"""
import contextlib
import importlib.util
import io
import json
from pathlib import Path
import sys
from types import SimpleNamespace

ROOT = Path(sys.argv[1]).resolve()
sys.path[:0] = [str(ROOT), str(ROOT / 'tests')]
from world import Repo, KEYS, git
from warrant import review as RV
from warrant import repo as RP

r = Repo(git_init=True)
(r.root / 'tests').mkdir()
(r.root / 'code.py').write_text('X = 1\n')
x1 = r.commit('first code head')
D = r.entity('alice', 'pr-head@1', {'state':'open','repository':'s0fractal/warrant','pr':7,'title':'fixture','serves':[]})
h1 = r.entity('alice','pr-head@1',{'state':'head','commit':x1,'tree':git(r.root,'rev-parse',x1+'^{tree}')},lineage=D)
patch = '''diff --git a/tests/head_coverage_test.py b/tests/head_coverage_test.py
new file mode 100644
--- /dev/null
+++ b/tests/head_coverage_test.py
@@ -0,0 +1,4 @@
+import sys
+sys.path.insert(0, ".")
+import code
+print(("FAIL " if code.X == 1 else "ok   ") + "F1 X must be two")
'''
f = r.put('bob','challenge',{'target':h1,'statement':'P2 X must be two','severity':'P2','what':'fixture defect',
 'where':['code.py:1'],'commit':x1,'tree':git(r.root,'rev-parse',x1+'^{tree}'),
 'test':{'file':'head_coverage_test','case':'F1','patch':patch}},'finding@1',refs=[h1])
(r.root / 'code.py').write_text('X = 2\n')
x2 = r.commit('fix in second head')
h2 = r.entity('alice','pr-head@1',{'state':'head','commit':x2,'tree':git(r.root,'rev-parse',x2+'^{tree}')},lineage=h1)
r.trust['keys'][RV.REPLAYER] = [KEYS['dave'].public]
r.profile['roles']['replayer'].append(RV.REPLAYER)
r.write_config()
# Match the actual branch after an author's pushed records-only commit.
branch_head = r.commit('second head version')
rp = RP.Repo(r.root)
rep = rp.report()
expected = [h for c,h,_ in RV.to_replay(rep,{RV.REPLAYER,'carol'}) if c == f]
collected = []
def collect(actor, unused_signer, records):
    assert actor == RV.REPLAYER
    collected.extend(records)
    return ['0'*64 for _ in records]
rp.file = collect
# Only a public identifier, no seed or signing method. Every attempted write is intercepted.
public_only = SimpleNamespace(public=KEYS['dave'].public)
stdout = io.StringIO()
with contextlib.redirect_stdout(stdout):
    RV.replay(rp, public_only)
observed = [v['body']['on'] for v in collected]
missing = [h for h in expected if h not in observed]
# Model only the successful publication of the collected attest in the next report.
# The report input is in memory; the replay signer remains inert, and no replay is signed.
rep['_recs']['0'*64] = collected[0]
rp.report = lambda: rep
second_stdout = io.StringIO()
with contextlib.redirect_stdout(second_stdout):
    RV.replay(rp, public_only)
assert len(collected) == 1 and second_stdout.getvalue() == ''
remaining = [h for c,h,_ in RV.to_replay(rep,{RV.REPLAYER,'carol'}) if c == f]
assert remaining == [h1]
# Independent control: run the same test at the original code commit, unsigned.
git(r.root,'checkout','--quiet',x1,'--','code.py')
old_verdict = RV.run_test(r.root,'head_coverage_test','F1',patch)
git(r.root,'checkout','--quiet',branch_head,'--','code.py')
new_verdict = RV.run_test(r.root,'head_coverage_test','F1',patch)
# Feed the actual runner's successful return (no jail denial or exception) to the waker.
spec = importlib.util.spec_from_file_location('coverage_waker', ROOT/'integrations/warrant-review/waker/waker.py')
W = importlib.util.module_from_spec(spec); spec.loader.exec_module(W)
w = object.__new__(W.Waker)
w.home = r.home/'memo'; (w.home/'replays').mkdir(parents=True)
w.repository = 's0fractal/warrant'; w.clock=lambda:100
w.tree=lambda base:'fixture-code'; w.seed=lambda tree:('review-replayer', b'not used')
w._replay=lambda *args:(True,'replay: 1 observation pushed (publication boundary simulated)')
old_memo = w.home/'replays'/('7-'+x1+'.json')
old_memo.write_text(json.dumps({'pr':7,'head':x1,'attempts':[{'ok':False,'finished':0,'line':'replay failed: exit 75'}]}))
w.replay({'pr':7,'head':branch_head},'b'*40)
covered = json.loads(old_memo.read_text()).get('covered_by')
# A subsequent replay at the records-only pushed head has empty stdout, as above.
w._replay=lambda *args:(False,'replay: nothing to replay')
next_head = 'f'*40
w.replay({'pr':7,'head':next_head},'b'*40)
gaps=[]
w.wake=lambda a,gap:(gaps.append(gap),'woken')
W.wake_after_replay(w,{'pr':7,'head':next_head})
print(json.dumps({'expected_head_versions':expected,'collected_observations':observed,'missing':missing,
 'original_head_control':old_verdict,'fixed_head_control':new_verdict,'checker_stdout':stdout.getvalue(),'second_checker_stdout':second_stdout.getvalue(),'still_due':remaining,
 'older_failed_replay_covered_by':covered,'reviewer_gaps':gaps,'signed_replay_records':0},indent=2))
assert expected == [h1,h2] and observed == [h2] and missing == [h1]
assert old_verdict == 'reproduces' and new_verdict == 'does_not_reproduce'
assert covered == branch_head and gaps == [None]
print('FAIL F1 original head remains unobserved, but successful later replay covers the failed replay and wakes with no gap')
```


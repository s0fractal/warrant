```python
"""G14 counterexamples at master 0c86424f330fdf513b115980d7f61c9071205cbe.
Usage: python3 pins_serve_views_test.py CHECKOUT REVIEW_WORK_DIR [--control]
Normal run prints FAIL F1 and FAIL F2 at M, exits 1. --control adds the
missing not_checked calls in memory, prints ok for both, exits 0.
Only fixture stores in REVIEW_WORK_DIR are written; no network or real keys.
"""
import json
import re
import sys
import tempfile
from pathlib import Path

root = Path(sys.argv[1]).resolve()
sys.path.insert(0, str(root))
from warrant import drift as D, keys as K, records as R
from warrant.repo import Repo
from warrant_agent import changes as CH, overlay as OVL, serve as SV

if '--control' in sys.argv:
    def checked(fn):
        def call(*args, **kwargs):
            rep = fn(*args, **kwargs)
            D.not_checked(rep)
            return rep
        return call
    OVL.assess = checked(OVL.assess)
    CH.report_of = checked(CH.report_of)

v = json.loads((root/'tests/vectors/pins-not-checked.json').read_text())
pinned = sorted(L for L, w in v['expect'].items() if w == 'PINS_NOT_CHECKED')
with tempfile.TemporaryDirectory(dir=sys.argv[2]) as tmp:
    base = Path(tmp)
    roots = {}
    for name in ('publisher', 'reader'):
        r = base/name
        dot = r/'.warrant'
        dot.mkdir(parents=True)
        (dot/'v3.json').write_text(json.dumps(v['v3']))
        (dot/'records.jsonl').write_text('\n'.join(v['lines'])+'\n')
        roots[name] = str(r)
    space = SV.Space(roots)
    app = SV.App(space, mine='reader', reader='reader', marks=CH.Marks(base/'marks.json'))
    # Baseline: the same pages' ordinary store reading passes the entire vector.
    assert {L: x['reliance'] for L, x in space.report('publisher')['lineages'].items()} == v['expect']
    code, page = app.page_overlay({'store': 'publisher'})
    assert code == 200
    plain = re.sub('<[^>]+>', '', page)
    bad_overlay = plain.count('PINS_NOT_CHECKED → ELIGIBLE')
    print(('FAIL' if bad_overlay else 'ok  ')+' F1 overlay must not promote unchecked pins: '
          +str(bad_overlay)+' PINS_NOT_CHECKED -> ELIGIBLE transitions')
    # A real signed fixture view is in the reader's separate store. Its root is
    # the publisher's snapshot, so the historical reconstruction is exact.
    snap = Repo(roots['publisher']).store.snapshot()
    viewed = Repo(roots['reader']).store.append(
        R.record('attest', 'bob', 1800000013,
                 {'target':pinned[0], 'verdict':'seen', 'lens':'builtin', 'root':snap.digest}, refs=[pinned[0]]),
        K.Key.from_seed_hex('02'*32), v['v3']['trust'])
    then = app.seen_then('publisher', viewed)
    assert then is not None and then[0]['snapshot'] == snap.digest
    shown = []
    for L in pinned:
        code, page = app.page_lineage('publisher', L, {'asof':viewed})
        assert code == 200
        m = re.search(r'data-floor="reliance"><span class="tag ([A-Z_]+)"', page)
        assert m is not None
        shown.append(m.group(1))
    bad_past = shown != ['PINS_NOT_CHECKED']*len(pinned)
    print(('FAIL' if bad_past else 'ok  ')+' F2 exact historical lineage pages must show PINS_NOT_CHECKED: '+str(shown))
    sys.exit(1 if bad_overlay or bad_past else 0)

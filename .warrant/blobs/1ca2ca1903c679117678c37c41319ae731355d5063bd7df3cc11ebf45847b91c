Runnable probe

Save the following as revert_retry_history_probe.py outside the checkout; from M's repository root, run it with Python 3 and TMPDIR pointing to a private working directory. It imports only the existing test fixtures and package; it does not write the checkout.

```python
"""Unsigned regression probe at M: an old successful run masks a later cancelled run.

Run from the repository root, with TMPDIR in this review's work directory.
"""
import copy
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path.cwd() / "tests"))
from gate_test import GT, REPO, braked_world, git, green


def main():
    until = 1793062800
    r, version = braked_world(until)
    base = git(r.root, "rev-parse", "HEAD")
    branch = f"gate/revert/7-{base[:12]}"
    git(r.root, "checkout", "-q", "-b", branch)
    (r.root / "AGENTS.md").write_text("original rules\n")
    head = r.commit(f"Revert #7\n\nwarrant-gate revert of {base}")
    b = GT.Base(r.root, base)
    pr = {"number": 8, "state": "open", "draft": False, "base": "master", "head": head,
          "labels": [], "branch": branch, "head_repo": REPO, "author": "github-actions[bot]"}
    wf = b.gate["required"][0]["workflow"]

    def checks(history):
        c = green(head)
        template = c["check_runs"][0]
        c["check_runs"] = [dict(template, id=i, check_suite={"id": i}, conclusion=conclusion)
                           for i, conclusion in history]
        c["workflow_runs"] = [{"id": i, "check_suite_id": i, "path": wf, "head_sha": head,
                               "status": "completed", "conclusion": conclusion,
                               "event": "workflow_dispatch"} for i, conclusion in history]
        return c

    class Hub:
        def __init__(self, c):
            self.c, self.sent = c, []

        def api(self, path, method="GET", body=None, pages=False):
            if path == "pulls/8":
                return {"state": "open", "head": {"sha": head}}
            if path.startswith("actions/runs?"):
                return {"workflow_runs": [] if "event=" in path else self.c["workflow_runs"]}
            raise AssertionError((path, method))

        def pull(self, n):
            return {"labels": ["hold"]}

        def dispatch(self, workflow, ref):
            self.sent.append([workflow, ref])

    out = {}
    for name, history in [("success_only", [(1, "success")]),
                          ("cancelled_only", [(2, "cancelled")]),
                          ("old_success_then_cancelled", [(2, "cancelled"), (1, "success")])]:
        c = checks(history)
        a = GT.assess(r.root, b, pr, c)
        hub = Hub(c)
        pending = GT.enforce_brakes(r.root, b, hub, [a], now=until - 1)
        retry = GT.approve_held(b, hub, [a])
        out[name] = {"eligible": a.eligible, "codes": a.codes(), "exact_revert": a.facts.get("revert") == base,
                     "new_revert": pending, "retry": retry, "dispatch": hub.sent}
    print(json.dumps(out, indent=2))
    assert out["success_only"]["eligible"] and out["success_only"]["dispatch"] == []
    assert out["cancelled_only"]["codes"] == ["CHECK_RED"]
    assert out["cancelled_only"]["dispatch"] == [[wf, branch]]
    got = out["old_success_then_cancelled"]
    assert got["exact_revert"] and got["codes"] == ["CHECK_RED"] and got["new_revert"] == []
    if got["dispatch"] != [[wf, branch]]:
        print("FAIL F1 an older successful workflow suppresses retry of the latest cancelled required check; "
              "the exact veto revert stays CHECK_RED and is also skipped as already pending")
        return 1
    print("ok   F1 latest cancelled check is retried despite an older successful run")
    return 0


if __name__ == "__main__":
    sys.exit(main())


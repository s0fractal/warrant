## Reproduction

From the exact M checkout with the MCP Python (cryptography and MCP SDK installed), save the
following scripts together in one review directory outside the checkout. Set TMPDIR to a directory
inside it. Run counterexamples.py from the checkout root. The budget assertion verifies the defect;
it is not a new passing regression check or a proposed patch. The M source and tests stay unchanged.
The script also records a separate source-404 observation: after resolving a source, a missing records
file aborts the whole read with NOT_FOUND rather than listing it in sources_not_read. The verdict's
blocking reason is the demonstrated byte-budget bypass.

```python
import io
import json
import sys
from unittest.mock import patch
from pathlib import Path
sys.path.insert(0, str(Path.cwd() / "tests"))
from world import Repo
from warrant_agent import api
from warrant_agent.config import Config
from warrant_agent import remote as RM
from warrant_agent.errors import AgentError
import urllib.error

r = Repo()
r.entity("alice", "obligation@1", {"state": "open", "statement": "remote obligation", "serves": []})
base = "https://raw.githubusercontent.com/example/remote/main/"
sha = "ab" * 20
source_base = "https://raw.githubusercontent.com/example/remote/" + sha + "/"
ref = "refs/heads/stores/checker"
resolver = "https://api.github.com/repos/example/remote/commits/" + ref
receiver = (r.dot / "v3.json").read_bytes()
records = (r.dot / "records.jsonl").read_bytes()
sources = json.dumps({"warrant": "sources/1", "sources": [{"name": "checker", "ref": ref, "actors": ["carol"]}]}).encode()
resolve_bytes = json.dumps({"sha": sha, "commit": {"message": "x" * 65536}}).encode()
files = {base + ".warrant/v3.json": receiver, base + ".warrant/records.jsonl": records,
         base + ".warrant/sources.json": sources, resolver: resolve_bytes,
         source_base + ".warrant/records.jsonl": b""}
bound = len(receiver) + len(records) + len(sources) + 512
cfg = Config({"agent_api": "warrant-agent/3", "workspaces": {"me": {"repo": str(r.root), "limits": {"store_bytes": bound}}}})
read_log = []
class Reply(io.BytesIO):
    def __init__(self, url, data):
        super().__init__(data)
        self.url = url
    def read(self, count=-1):
        data = super().read(count)
        read_log.append({"url": self.url, "requested": count, "received": len(data)})
        return data
class Transport:
    def open(self, request, timeout=None):
        url = request.full_url
        if url not in files:
            raise urllib.error.HTTPError(url, 404, "missing", {}, None)
        return Reply(url, files[url])

with patch.object(RM.urllib.request, "build_opener", return_value=Transport()), patch.object(RM.socket, "getaddrinfo", return_value=[(2, 1, 6, "", ("93.184.216.34", 443))]):
    result = api.call(cfg, "remote", {"url": base, "op": "status"})
    budget_case = {"store_bytes": bound, "actual_response_bytes": sum(x["received"] for x in read_log),
                   "read_log": list(read_log), "result": result}
    print("BUDGET " + json.dumps(budget_case, sort_keys=True))
    assert "ok" in result and budget_case["actual_response_bytes"] > bound
    read_log.clear()
    files[resolver] = json.dumps({"sha": sha}).encode()
    control = api.call(cfg, "remote", {"url": base, "op": "status"})
    control_case = {"store_bytes": bound, "actual_response_bytes": sum(x["received"] for x in read_log), "succeeded": "ok" in control}
    print("CONTROL " + json.dumps(control_case, sort_keys=True))
    assert "ok" in control and control_case["actual_response_bytes"] <= bound
    del files[source_base + ".warrant/records.jsonl"]
    missing = api.call(cfg, "remote", {"url": base, "op": "status"})
    print("MISSING_SOURCE " + json.dumps(missing, sort_keys=True))
    assert missing.get("error") == "NOT_FOUND"
```


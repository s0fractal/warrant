```python
"""Run at the reviewed repository root; all fixtures use TMPDIR."""
import json
import os
from pathlib import Path
import subprocess
import sys

root = Path.cwd()
sys.path.insert(0, str(root / 'tests'))
from world import Repo, git
from warrant_agent import api
from warrant_agent.config import Config

r = Repo(git_init=True)
target = r.entity('alice', 'obligation@1', {'state': 'open', 'statement': 'source only', 'serves': []})
source_commit = r.commit('source record')
git(r.root, 'update-ref', 'refs/heads/source', source_commit)
git(r.root, 'reset', '--hard', 'HEAD~1')
(r.dot / 'sources.json').write_text(json.dumps({'warrant': 'sources/1', 'sources': [
    {'name': 'source', 'ref': 'refs/heads/source', 'actors': ['alice']}]}))
r.commit('declare the source')
cfg = Config({'agent_api': 'warrant-agent/3', 'workspaces': {'w': {'repo': str(r.root)}}})
tool = os.environ.get('GRAPH_TEST_TOOL', str(root / 'tools/graph.py'))
def cli(*args):
    return subprocess.run([sys.executable, tool, *args], cwd=r.root, capture_output=True, text=True)
export = cli('export')
assert export.returncode == 0, export.stderr
graph = json.loads(export.stdout)['data']
assert target in {n[0] for n in graph['nodes']}
assert target not in r.store.snapshot().lines
failures = []
for op in ('path', 'why'):
    agent = api.call(cfg, 'graph', {'workspace': 'w', 'op': op, 'target': target})
    assert 'ok' in agent, agent
    got = cli(op, target)
    print(op, 'exported=True agent=ok CLI_exit=' + str(got.returncode), got.stderr.strip())
    if got.returncode != 0:
        failures.append(op)
    else:
        assert json.loads(got.stdout)['data'] == agent['ok']['data']
print(('FAIL F1' if failures else 'ok   F1') + ' CLI path/why must resolve records of the same source-composed graph as export and the agent: ' + str(failures))
sys.exit(bool(failures))
```


import sys, json, time
from pathlib import Path
root=Path(sys.argv[1]).resolve()
sys.path[:0]=[str(root/'tests'),str(root)]
from world import Repo,git
import gate_test as T
from warrant import gate as G
r=Repo(git_init=False)
(r.dot/'merge.json').write_text(json.dumps(T.PRES))
(r.root/'AGENTS.md').write_text('rules\n')
git(r.root,'init','-q','-b','master')
r.commit('base')
git(r.root,'checkout','-q','-b','feature')
(r.root/'AGENTS.md').write_text('weakened\n')
r.commit('change')
git(r.root,'checkout','-q','master')
until=int(time.time())+86400
v='a'*64
git(r.root,'merge','-q','--no-ff','feature','-m',f'Merge #7\n\nwarrant-gate brake until {until}: #7 head version {v}')
base=git(r.root,'rev-parse','HEAD')
b=G.Base(r.root,base)
class GH:
 def __init__(self): self.calls=[]
 def pull(self,n): return {'labels':['hold']}
 def api(self,path,method='GET',body=None,pages=False):
  self.calls.append((path,method))
  return {'sha':'d'*40}
 def dispatch(self,w,branch): self.calls.append(('dispatch',branch))
control_gh=GH()
control=G.enforce_brakes(r.root,b,control_gh,[])
# A fork PR may choose this branch name without access to this repository.
# Give it a real, nonempty diff, as GitHub requires for an open pull request.
git(r.root,'checkout','-q','-b','gate/revert/7-blocker')
(r.root/'code.py').write_text('unrelated = True\n')
fork_head=r.commit('an unrelated fork change')
pr={'number':99,'state':'open','draft':False,'base':'master','head':fork_head,'labels':[],
 'branch':'gate/revert/7-blocker','head_repo':'mallory/warrant','author':'mallory'}
a=G.assess(r.root,b,pr,T.green(fork_head))
attack_gh=GH()
attack=G.enforce_brakes(r.root,b,attack_gh,[a])
print(json.dumps({'open_brakes':len(G.brakes(r.root,base)), 'control':control,'control_calls':control_gh.calls,
 'blocker_eligible':a.eligible,'blocker_codes':a.codes(),'blocked':attack,'blocked_calls':attack_gh.calls},indent=2))
assert len(control)==1 and 'opened' in control[0][1]
assert not a.eligible and 'REVERT_NOT_EXACT' in a.codes()
if not attack:
 print('FAIL F1 an untrusted, refused fork PR branch suppresses the owner-veto revert')
 sys.exit(1)
print('ok   F1 the refused fork branch does not suppress the owner-veto revert')


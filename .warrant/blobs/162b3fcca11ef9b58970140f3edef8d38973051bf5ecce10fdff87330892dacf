"""Run from M's checkout; fixture keys only, no real-store writes."""
import hashlib
import json
import sys
from pathlib import Path

ROOT = Path.cwd()
sys.path[:0] = [str(ROOT / "tests"), str(ROOT)]
from world import Repo
from warrant_agent import api
from warrant_agent.config import Config

WORK = Path(__file__).resolve().parent
r = Repo(base=WORK)

def obligation(name, refs=()):
    root = r.entity("alice", "obligation@1", {"state": "open", "statement": name, "serves": []}, refs=refs)
    return root

decoys = []
for i in range(13):
    root = obligation(f"decoy {i}")
    done = r.entity("alice", "obligation@1", {"state": "done", "statement": f"decoy {i}", "serves": []}, lineage=root)
    decoys.append(done)
    for j in range(3):
        obligation(f"citation {i}/{j}", refs=[root])

winner = obligation("winner")
winner_done = r.entity("alice", "obligation@1", {"state": "done", "statement": "winner", "serves": []}, lineage=winner)
dependent = obligation("dependent")
dependent_done = r.entity("alice", "obligation@1", {"state": "done", "statement": "dependent", "serves": []},
                          lineage=dependent, requires=[winner])
r.attest("bob", dependent_done)
cfg = Config({"agent_api": "warrant-agent/3", "workspaces": {"w": {"repo": str(r.root)}}})
before = r.store.file.read_bytes()
out = {"winner": winner_done}
for limit in (1, 5, 12):
    result = api.call(cfg, "next", {"workspace": "w", "actor": "bob", "limit": limit})
    assert "ok" in result, result
    result = result["ok"]
    out[f"limit_{limit}"] = {"waiting": result["waiting"], "rows": len(result["next"]),
        "max_changes": max(x["changes"] for x in result["next"]),
        "winner_included": any(x["version"] == winner_done for x in result["next"]),
        "rests_on_it": sorted(set(x["rests_on_it"] for x in result["next"]))}
exact = api.call(cfg, "whatif", {"workspace": "w", "actor": "bob", "accept": [winner_done]})
assert "ok" in exact, exact
out["winner_exact_changes"] = exact["ok"]["count"]
out["winner_changed_lineages"] = [x["lineage"] for x in exact["ok"]["changes"]]
out["store_unchanged"] = before == r.store.file.read_bytes()
assert out["winner_exact_changes"] == 2, out
assert all(out[f"limit_{limit}"]["max_changes"] == 1 and not out[f"limit_{limit}"]["winner_included"]
           for limit in (1, 5, 12)), out
assert out["store_unchanged"], out
print(json.dumps(out, indent=2))

```


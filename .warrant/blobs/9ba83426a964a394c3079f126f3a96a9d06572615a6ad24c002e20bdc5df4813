## Runnable regression

Run the following as a Python file from the reviewed repository root, with TMPDIR
set to a review-local working directory. It uses only tests/world.py fixture keys.
Exit 1 at both commits is the expected reproduction; controls print ok and the
two defect cases print FAIL. The same file runs against the archived #350 tree.

```python
#!/usr/bin/env python3
"""Regression: solo windows must not discharge a head's open guard.requires.
Run from the reviewed repository root with its tests/ directory available.
Fixture actors use tests/world.py deterministic keys, never operator identities.
"""
import json
import sys
from pathlib import Path
sys.path.insert(0, str(Path.cwd() / 'tests'))
from gate_test import PR, MERGE, NOW, green, git
from warrant import gate as GT


def fixture(merge, accepted=False, close=False):
    def setup(p):
        p.r.profile['roles']['pr/acceptor'] = ['alice', 'bob']
        p.r.write_config()
        p.required = p.r.entity('alice', 'obligation@1', {
            'state': 'open', 'statement': 'prerequisite before merge', 'serves': []})
    p = PR(accept=False, merge=merge, before_base=setup)
    p.head_v = p.r.entity('alice', 'pr-head@1', {
        'state': 'head', 'commit': p.x,
        'tree': git(p.r.root, 'rev-parse', f'{p.x}^{{tree}}')},
        lineage=p.head_v, requires=[p.required])
    if accepted:
        p.r.attest('bob', p.head_v)
    if close:
        done = p.r.entity('alice', 'obligation@1', {
            'state': 'done', 'statement': 'prerequisite before merge', 'serves': []},
            lineage=p.required)
        p.r.attest('bob', done)
        # The prerequisite's closure is part of X, not an unrelated post-X tail.
        p.x = p.r.commit('prerequisite completed in change')
        p.head_v = p.r.entity('alice', 'pr-head@1', {
            'state': 'head', 'commit': p.x,
            'tree': git(p.r.root, 'rev-parse', f'{p.x}^{{tree}}')},
            lineage=p.head_v, requires=[p.required])
        if accepted:
            p.r.attest('bob', p.head_v)
    h = p.r.commit('head with prerequisite')
    return p, h


def main():
    failures = 0
    solo = dict(MERGE, solo={'window_hours': 0, 'veto_role': 'pr/owner'})
    # Two controls isolate the new solo waiver from normal guard assessment.
    for label, merge, accepted, close, want in [
        ('control_no_solo', MERGE, True, False, False),
        ('control_closed', solo, True, True, True),
        ('ordinary_unaccepted', solo, False, False, False),
        ('ordinary_accepted', solo, True, False, False),
    ]:
        p, h = fixture(merge, accepted=accepted, close=close)
        a = p.assess(checks=green(h, completed=NOW - 1), now=NOW)
        v = p.r.report()['versions'][p.head_v]
        passed = a.eligible == want
        failures += not passed
        print(('ok   ' if passed else 'FAIL ') + label + ' ' + json.dumps({
            'eligible': a.eligible, 'expected_eligible': want, 'guard': v,
            'solo': a.facts.get('solo'), 'reasons': a.reasons}, sort_keys=True))
    return 1 if failures else 0

if __name__ == '__main__':
    sys.exit(main())

```

